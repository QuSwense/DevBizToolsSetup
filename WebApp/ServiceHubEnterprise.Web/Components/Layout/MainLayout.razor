@inherits LayoutComponentBase

<div class="app-layout">
    <Sidebar />
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="main-content">
        <header class="main-header">
            <div class="main-header-left">
                <button class="btn btn-outline-secondary btn-sh-icon mobile-menu-btn d-none" id="mobileMenuBtn"
                        aria-label="Open menu" onclick="toggleMobileMenu()">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="main-header-title">
                    @Title</h1>
                </div>
                <div class="main-header-right">
                    <button class="btn btn-dg btn-sh-icon" aria-label="Toggle theme" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    <span class="header-user-name">Admin &bull; Priya Sharma</span>
                    <div class="avatar-sm">PS</div>
                </div>
            </header>
            <div class="main-body">
                @Body
            </div>
        </div>
    </div>

@code {
}
