@namespace ServiceHubEnterprise.Ui.Components

@* ── Loading Skeleton ── *@
@if (IsLoading)
{
    <div class="monaco-diff-wrapper">
        <div class="monaco-diff-loading">
            <div class="spinner-border text-sh-accent" role="status">
                <span class="visually-hidden">Loading comparison...</span>
            </div>
        </div>
    </div>
}
else if (HasError)
{
    <div class="monaco-diff-wrapper">
        <div class="monaco-diff-error">
            <i class="bi bi-exclamation-triangle fs-4 text-danger"></i>
            <p>@ErrorMessage</p>
            <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="OnRetry" type="button">
                <i class="bi bi-arrow-repeat"></i> Retry
            </button>
        </div>
    </div>
}
else
{
    <div class="monaco-diff-wrapper">
        @* ── Header: Version Labels ── *@
        @if (ShowHeader)
        {
            <div class="monaco-diff-header">
                <div class="diff-header-left">
                    <span class="mono-text fw-medium">@OriginalLabel</span>
                    @if (!string.IsNullOrEmpty(OriginalAuthor))
                    {
                        <span class="text-sh-faint fs-11">@OriginalAuthor</span>
                    }
                    @if (!string.IsNullOrEmpty(OriginalTimestamp))
                    {
                        <span class="text-sh-faint fs-11">@OriginalTimestamp</span>
                    }
                    <span class="file-type-badge diff-badge-original">ORIGINAL</span>
                </div>
                <div class="diff-header-swap">
                    <button type="button" class="toolbar-btn" @onclick="OnSwap" title="Swap versions">
                        <i class="bi bi-arrow-left-right"></i>
                    </button>
                </div>
                <div class="diff-header-right">
                    <span class="mono-text fw-medium">@ModifiedLabel</span>
                    @if (!string.IsNullOrEmpty(ModifiedAuthor))
                    {
                        <span class="text-sh-faint fs-11">@ModifiedAuthor</span>
                    }
                    @if (!string.IsNullOrEmpty(ModifiedTimestamp))
                    {
                        <span class="text-sh-faint fs-11">@ModifiedTimestamp</span>
                    }
                    <span class="file-type-badge diff-badge-modified">MODIFIED</span>
                </div>
            </div>
        }

        @* ── Controls Bar ── *@
        @if (ShowControls)
        {
            @if (ControlsContent is not null)
            {
                @ControlsContent
            }
            else
            {
                <MonacoComparerToolbar ViewMode="@ViewMode"
                                       TotalDifferences="@TotalDifferences"
                                       CurrentDifference="@CurrentDifference"
                                       ShowUnchangedLines="@ShowUnchangedLines"
                                       IgnoreWhitespace="@IgnoreTrimWhitespace"
                                       IgnoreCase="@IgnoreCase"
                                       ScrollSync="@ScrollSync"
                                       ShowUnchangedLinesToggle="@ShowUnchangedLinesToggle"
                                       ShowWhitespaceToggles="@ShowWhitespaceToggles"
                                       ShowCaseToggle="@ShowCaseToggle"
                                       ShowNavigation="@ShowNavigation"
                                       ShowDiffCounter="@ShowDiffCounter"
                                       ShowScrollSync="@ShowScrollSync"
                                       ShowViewModeToggle="@ShowViewModeToggle"
                                       ShowSwapButton="@ShowSwapButton"
                                       ShowRefreshButton="@ShowRefreshButton"
                                       ShowExportButton="@ShowExportButton"
                                       OnViewModeChanged="@OnViewModeChanged"
                                       OnPreviousDiff="@OnPreviousDiff"
                                       OnNextDiff="@OnNextDiff"
                                       OnSwap="@OnSwap"
                                       OnRefresh="@OnRefresh"
                                       OnExportReport="@OnExportReport"
                                       OnIgnoreWhitespaceChanged="@OnIgnoreWhitespaceChanged"
                                       OnIgnoreCaseChanged="@OnIgnoreCaseChanged"
                                       OnScrollSyncChanged="@OnScrollSyncChanged" />
            }
        }

        @* ── Diff Content Area ── *@
        <div class="monaco-diff-content">
            <div id="@_containerId" class="monaco-diff-host"></div>
        </div>

        @* ── Footer ── *@
        @if (ShowFooter)
        {
            @if (FooterContent is not null)
            {
                @FooterContent
            }
            else
            {
                <MonacoComparerFooter TotalDifferences="@TotalDifferences"
                                      Additions="@Additions"
                                      Deletions="@Deletions"
                                      Modifications="@Modifications"
                                      PercentageChanged="@PercentageChanged"
                                      SimilarityPercentage="@SimilarityPercentage"
                                      CurrentDifference="@CurrentDifference"
                                      TotalDifferencesForNav="@TotalDifferences"
                                      IsProcessing="@IsProcessing"
                                      HasError="@HasError"
                                      ErrorMessage="@ErrorMessage"
                                      ShowDiffStats="@ShowDiffStats"
                                      ShowNavigation="@ShowNavigation"
                                      ShowStatus="@ShowStatus" />
            }
        }
    </div>
}