@namespace OrbitHub.Ui.Components

<div class="dash-card dashboard-row section-card">
    <div class="section-header">
        <div class="card-header">
            <div class="section-title">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <span class="section-icon">@Icon</span>
                }
                <span class="card-title">@Title</span>
            </div>
            <div class="position-relative d-flex align-items-center gap-2">
                @if (Filter is not null)
                {
                    <button type="button"
                            class="meta-pill cursor-pointer border-0 bg-transparent d-flex align-items-center gap-1 filter-pill"
                            @onclick="ToggleFilter">
                        <span class="filter-pill-label">@Filter.Label</span>
                        <span class="filter-pill-icon">📅</span>
                    </button>
                    @if (_showFilter)
                    {
                        <div class="datepicker-overlay" @onclick="CloseFilter"></div>
                        <DateRangeFilter Value="@Filter" ValueChanged="@HandleFilterChanged" />
                    }
                }
                @HeaderActions
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Information))
    {
        <div class="section-divider"></div>
        <div class="section-information">@Information</div>
        <div class="section-divider section-divider-light"></div>
    }

    @if (Collapsible && Collapsed)
    {
        @if (Summary is not null)
        {
            <div class="section-summary section-fade">
                @Summary
            </div>
        }
    }
    else
    {
        <div class="section-body @(Collapsible ? "section-fade" : null)">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="section-footer">
                @Footer
            </div>
        }
    }

    @if (Collapsible)
    {
        <div class="section-toggle-wrap">
            <button type="button"
                    class="section-toggle"
                    @onclick="Toggle"
                    aria-expanded="@(!Collapsed)">
                <span>@(Collapsed ? "Show details" : "Hide details")</span>
                <i class="bi @(Collapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
            </button>
        </div>
    }
</div>
