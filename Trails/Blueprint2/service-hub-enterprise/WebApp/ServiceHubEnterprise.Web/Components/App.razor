@using System.Reflection
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new Assembly[] {
                        typeof(ServiceHubEnterprise.Dashboard.Pages.Dashboard).Assembly,
                        typeof(ServiceHubEnterprise.SoapApplications.Pages.Applications).Assembly,
                        typeof(ServiceHubEnterprise.RestApplications.Pages.Applications).Assembly,
                        typeof(ServiceHubEnterprise.FileManagement.Pages.FileLibrary).Assembly,
                        typeof(ServiceHubEnterprise.TestSuite.Pages.TestCases).Assembly,
                        typeof(ServiceHubEnterprise.MonitoringHealth.Pages.HealthDashboard).Assembly,
                        typeof(ServiceHubEnterprise.ADViewer.Pages.ADViewer).Assembly,
                        typeof(ServiceHubEnterprise.Settings.Pages.Settings).Assembly
                    }">
<Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="datagrid-card empty-state-card">
                <svg width="56" height="56" class="empty-state-icon" viewBox="0 0 24 24" fill="none"
                     stroke="var(--dg-text-faint)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <h3 class="empty-state-title">Page Not Found</h3>
                <p class="empty-state-desc">
                    The page you're looking for doesn't exist or has been moved.
                </p>
                <a href="/" class="btn btn-dark btn-dg-primary empty-state-actions"
                   style="text-decoration:none;margin-top:8px">Go to
                    Dashboard</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
