@inherits LayoutComponentBase

<div class="app-layout">
    <Sidebar />
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="main-content">
        <header class="main-header">
            <div class="main-header-left">
                <button class="btn btn-outline-secondary btn-dg-icon mobile-menu-btn" id="mobileMenuBtn"
                        aria-label="Open menu" style="display:none"
                        onclick="document.querySelector('.sidebar')?.classList.toggle('mobile-open');document.getElementById('sidebarOverlay')?.classList.toggle('show')">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="12" x2="20" y2="12" />
                        <line x1="4" y1="6" x2="20" y2="6" />
                        <line x1="4" y1="18" x2="20" y2="18" />
                    </svg>
                </button>
                <h1 class="main-header-title">
                    @Title</h1>
                </div>
                <div class="main-header-right">
                    <button class="btn btn-outline-secondary btn-dg-icon" aria-label="Toggle theme" onclick="toggleTheme()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                        </svg>
                    </button>
                    <span class="header-user-name">Admin &bull; Priya Sharma</span>
                    <div class="avatar-sm">PS
                    </div>
                </div>
            </header>
            <div class="main-body">
                @Body
            </div>
        </div>
    </div>

@code {
    [Parameter]
    public string Title { get; set; } = "Service Hub Enterprise";
}
