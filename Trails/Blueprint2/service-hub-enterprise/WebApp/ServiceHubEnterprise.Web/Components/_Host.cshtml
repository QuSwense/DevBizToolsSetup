@page "/{**browser}"
@using Microsoft.AspNetCore.Components.Web
@namespace ServiceHubEnterprise.Web.Components
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Service Hub Enterprise</title>
    <meta name="description"
          content="Service Hub V8 — REST & SOAP API management, file library, test suite execution, and monitoring dashboard." />
    <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
    <base href="~/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/service-hub.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features/soap-apps.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features/rest-apps.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features/file-mgmt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features/test-suite.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/ServiceHubEnterprise.Grid/css/grid.css" asp-append-version="true" />
    <HeadOutlet />
</head>

<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui"
         style="display:none;position:fixed;bottom:0;left:0;right:0;background:#dc2626;color:#fff;padding:12px;text-align:center;z-index:9999">
        An unhandled error has occurred.
        <a href="" style="color:#fff;text-decoration:underline">Reload</a>
        <a class="dismiss" style="cursor:pointer;margin-left:8px;text-decoration:underline">Dismiss</a>
    </div>

    <script src="~/_framework/blazor.server.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/_content/ServiceHubEnterprise.Grid/js/pagination.js" asp-append-version="true"></script>
    <script src="~/_content/ServiceHubEnterprise.Grid/js/filters.js" asp-append-version="true"></script>
    <script src="~/_content/ServiceHubEnterprise.Grid/js/actions.js" asp-append-version="true"></script>
    <script src="~/_content/ServiceHubEnterprise.Grid/js/contextmenu.js" asp-append-version="true"></script>
    <script src="~/_content/ServiceHubEnterprise.Grid/js/grid.js" asp-append-version="true"></script>
</body>

</html>
