<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <Name>servicehubdb</Name>
    <ProjectGuid>{2C6AA110-6694-4472-99CC-BF72E3C057C4}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql130DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="dbDesign\**" />
    <Build Remove="scripts\**" />
    <Build Remove="Script.PostDeployment.sql" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="Script.PostDeployment.sql" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="dbo" />
    <Folder Include="dbo\StoredProcedures" />
    <Folder Include="dbo\Tables" />
    <Folder Include="dbo\Functions" />
    <Folder Include="dbo\Views" />
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>