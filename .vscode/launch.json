{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch OrbitHub.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-webapp",
      "program": "${workspaceFolder}/WebApp/OrbitHub.Web/bin/Debug/net10.0/OrbitHub.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/WebApp/OrbitHub.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}