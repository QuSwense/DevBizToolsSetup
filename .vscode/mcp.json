{
  "servers": {
    "dotnet-source-mcp": {
      "type": "stdio",
      "command": "dotnet-source-mcp"
    },
    "sqlserver-schema": {
      "type": "stdio",
      "command": "sqlserverlocal-mcp",
      "env": {
        "SQL_SERVER_CONNECTION_STRING": "Data Source=localhost,1433;Initial Catalog=OrbitTool;User ID=sa;Password=root@1234;Encrypt=True;TrustServerCertificate=True;Command Timeout=30",
        "SQL_SERVER_READONLY": "true"
      }
    }
  }
}