{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-webapp",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/WebApp/OrbitHub.Web/OrbitHub.Web.csproj"
			],
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "run-webapp",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"${workspaceFolder}/WebApp/OrbitHub.Web/OrbitHub.Web.csproj"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "watch-webapp",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/WebApp/OrbitHub.Web/OrbitHub.Web.csproj"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "test",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"${workspaceFolder}/tests/OrbitHub.Tests/OrbitHub.Tests.csproj"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "test-coverage",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"${workspaceFolder}/tests/OrbitHub.Tests/OrbitHub.Tests.csproj",
				"--collect:XPlat Code Coverage",
				"--results-directory",
				"${workspaceFolder}/coverage"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "build-dashboard",
			"type": "shell",
			"command": "dotnet build Features/OrbitHub.Dashboard/OrbitHub.Dashboard.csproj",
			"group": "build"
		},
		{
			"label": "build-webapp-full",
			"type": "shell",
			"command": "dotnet build WebApp/OrbitHub.Web/OrbitHub.Web.csproj",
			"group": "build"
		},
		{
			"label": "build-dashboard-final",
			"type": "shell",
			"command": "dotnet build Features/OrbitHub.Dashboard/OrbitHub.Dashboard.csproj",
			"group": "build"
		},
		{
			"label": "build-solution-final",
			"type": "shell",
			"command": "dotnet build WebApp/OrbitHub.Web/OrbitHub.Web.csproj",
			"group": "build"
		},
		{
			"label": "build-dashboard",
			"type": "shell",
			"command": "dotnet build Features/OrbitHub.Dashboard/OrbitHub.Dashboard.csproj",
			"group": "build"
		},
		{
			"label": "sqlproj: Build servicehubdb",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"/Users/sndjones/Documents/SUBHADEEP/PROJECTS/GitHub/DevBizToolsSetup/servicehubdb/servicehubdb.sqlproj"
			],
			"problemMatcher": "$sqlproj-problem-matcher",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"detail": "Builds the servicehubdb SQL project"
		}
	]
}