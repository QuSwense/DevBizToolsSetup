@page "/file/library"

@* ── Loading Skeleton ── *@
@if (_isLoading)
{
    <div class="datagrid-card" style="padding:0">
        <div class="skeleton-table">
            <div class="skeleton-header">
                <div class="skeleton-cell skeleton-check"></div>
                <div class="skeleton-cell skeleton-name"></div>
                <div class="skeleton-cell skeleton-app"></div>
                <div class="skeleton-cell skeleton-type"></div>
                <div class="skeleton-cell skeleton-size"></div>
                <div class="skeleton-cell skeleton-linked"></div>
                <div class="skeleton-cell skeleton-actions"></div>
            </div>
            @RenderSkeletonRows
        </div>
    </div>
}
else if (_hasError)
{
    <div class="datagrid-card error-state-card">
        <i class="bi bi-exclamation-triangle fs-28 text-danger"></i>
        <p class="error-state-text">@_errorMessage</p>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="LoadFilesAsync" type="button">
            <i class="bi bi-arrow-repeat"></i>
            Retry
        </button>
        <button class="btn btn-outline-secondary btn-dg ms-2" @onclick="DismissError" type="button">Dismiss</button>
    </div>
}
else if (_allFiles.Length == 0)
{
    <div class="datagrid-card empty-state-card">
        <i class="bi bi-folder-open" style="font-size:36px;color:var(--sh-text-faint)"></i>
        <h4 class="empty-state-title">No files yet</h4>
        <p class="empty-state-desc">Upload your first file to get started with the file library.</p>
        <button class="btn btn-sh-primary btn-dg btn-dark mt-2" type="button" aria-label="Upload File">
            <i class="bi bi-plus-lg"></i>
            Upload File
        </button>
    </div>
}
else
{
    <ServiceHubGrid TItem="FileItem"
                    @ref="_grid"
                    Id="fileLibraryGrid"
                    Items="FilteredFiles"
                    PageSize="10"
                    EnableSelection="true"
                    EnablePagination="true"
                    EnableSearch="true"
                    SearchPlaceholder="Search files..."
                    EmptyText="No files found matching the current filters."
                    @bind-SortColumn="_sortColumn"
                    @bind-SortAscending="_sortAscending"
                    @bind-CurrentPage="_currentPage"
                    @bind-SearchText="_searchText"
                    @bind-SelectedIds="_selectedIds"
                    Columns="@_columns">

        <ToolbarRight>
            <button class="btn btn-sh-primary btn-dg btn-dark" type="button" aria-label="Upload File">
                <i class="bi bi-plus-lg"></i>
                Upload
            </button>
            <button class="btn btn-outline-secondary btn-dg" type="button" aria-label="Export">
                <i class="bi bi-download"></i>
                Export
            </button>
        </ToolbarRight>

        <RowActions Context="file">
            <div class="action-icons">
                <button class="action-icon-btn" @onclick="() => HandleViewFile(file)" type="button" aria-label="View" title="View">
                    <i class="bi bi-eye"></i>
                </button>
                <button class="action-icon-btn" @onclick="() => HandleDownloadFile(file)" type="button" aria-label="Download" title="Download">
                    <i class="bi bi-download"></i>
                </button>
                <button class="action-icon-btn text-danger" @onclick="() => HandleDeleteFile(file)" type="button" aria-label="Delete" title="Delete">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </RowActions>
    </ServiceHubGrid>
}
