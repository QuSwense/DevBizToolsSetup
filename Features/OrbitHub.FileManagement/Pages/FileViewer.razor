@page "/file/viewer"

@* ── Loading Skeleton ── *@
@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:300px">
        <div class="spinner-border text-sh-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_isEmpty)
{
    <div class="datagrid-card empty-state-card">
        <i class="bi bi-file-earmark-text empty-state-icon"></i>
        <h3 class="empty-state-title">No file selected</h3>
        <p class="empty-state-desc">
            Select a file from the File Library or specify <code>?app=</code> and <code>?file=</code> query parameters
            to preview its contents here. Supports JSON, XML, and plain text files.
        </p>
        <div class="empty-state-actions">
            <a href="/file/library" class="btn btn-outline-secondary btn-dg text-decoration-none">
                <i class="bi bi-file-earmark"></i>
                Browse File Library
            </a>
        </div>
    </div>
}
else if (_hasError)
{
    <div class="datagrid-card error-state-card">
        <i class="bi bi-exclamation-triangle fs-28 text-danger"></i>
        <p class="error-state-text">@_errorMessage</p>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="LoadFileAsync" type="button">
            <i class="bi bi-arrow-repeat"></i>
            Retry
        </button>
        <button class="btn btn-outline-secondary btn-dg ms-2" @onclick="DismissError" type="button">Dismiss</button>
    </div>
}
else
{
    <div class="editor-page">
        @* ── Toolbar ── *@
        <div class="editor-toolbar">
            <div class="d-flex align-items-center gap-8px">
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="GoBack" type="button" aria-label="Back" title="Go back">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <h5 class="m-0 mono-text">@_fileName</h5>
                <span class="file-type-badge">@_language.ToUpperInvariant()</span>
            </div>
            <div class="d-flex align-items-center gap-8px">
                <span class="fs-12 text-sh-faint">@_fileSize</span>
                <button class="btn btn-outline-secondary btn-dg" @onclick="OpenInEditor" type="button" title="Open in editor">
                    <i class="bi bi-pencil"></i>
                    Edit
                </button>
                <button class="btn btn-outline-secondary btn-dg" @onclick="DownloadFileAsync" type="button" title="Download">
                    <i class="bi bi-download"></i>
                    Download
                </button>
            </div>
        </div>

        @* ── Tabs ── *@
        <div class="tabs-header">
            <button class="tab-btn@(_activeTab == 0 ? " is-active" : "")"
                    @onclick="() => SetActiveTab(0)" type="button" role="tab" aria-selected="@(_activeTab == 0)">
                <i class="bi bi-info-circle"></i>
                Properties
            </button>
            <button class="tab-btn@(_activeTab == 1 ? " is-active" : "")"
                    @onclick="() => SetActiveTab(1)" type="button" role="tab" aria-selected="@(_activeTab == 1)">
                <i class="bi bi-code-slash"></i>
                Content
            </button>
        </div>

        <div class="tab-content">
            @* ── TAB 0: Properties (read-only) ── *@
            @if (_activeTab == 0)
            {
                <div class="tab-panel properties-tab" role="tabpanel">
                    <div class="viewer-properties-panel">
                        <div class="properties-grid">
                            <div class="property-field full-width">
                                <span class="pf-label">File Name</span>
                                <span class="pf-value mono">@_fileName</span>
                            </div>

                            @if (_isSoapFile || _isRestFile)
                            {
                                <div class="property-field">
                                    <span class="pf-label">Application</span>
                                    <span class="pf-value">@_appName</span>
                                </div>
                                <div class="property-field">
                                    <span class="pf-label">Operation</span>
                                    <span class="pf-value">@_operation</span>
                                </div>
                                <div class="property-field">
                                    <span class="pf-label">Verb</span>
                                    <span class="pf-value mono">@_verb</span>
                                </div>
                                <div class="property-field">
                                    <span class="pf-label">Status</span>
                                    <span class="pf-value">@_status</span>
                                </div>
                            }

                            <div class="property-field full-width">
                                <span class="pf-label">Description</span>
                                <span class="pf-value">@(string.IsNullOrWhiteSpace(_description) ? "—" : _description)</span>
                            </div>

                            <div class="audit-divider"></div>
                            <div class="audit-grid">
                                <div class="audit-item">
                                    <span class="audit-label">Created</span>
                                    <span class="audit-value">@_createdBy on @_createdAt</span>
                                </div>
                                <div class="audit-item">
                                    <span class="audit-label">Last Updated</span>
                                    <span class="audit-value">@_updatedBy @_updatedAt</span>
                                </div>
                                <div class="audit-item">
                                    <span class="audit-label">Size</span>
                                    <span class="audit-value mono-text">@_fileSize</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ── TAB 1: Content (read-only Monaco) ── *@
            @if (_activeTab == 1)
            {
                <div class="tab-panel content-tab" role="tabpanel">
                    <div class="editor-main">
                        <div id="file-viewer-monaco" class="monaco-editor-host"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}
