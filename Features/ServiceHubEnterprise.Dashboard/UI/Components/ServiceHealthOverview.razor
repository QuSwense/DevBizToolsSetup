@namespace ServiceHubEnterprise.Dashboard.UI.Components

<SectionCard Title="Service Health" Icon="🩺" Information="Current status & uptime over range" Filter="@_range" OnFilterChanged="ApplyRange"
             Collapsible="true" Collapsed="@Collapsed" OnToggle="OnToggle">
    <Summary>
        <div class="summary-chip">
            <span class="summary-chip-icon">🖥️</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Services</span>
                <span class="summary-chip-value">@TotalNow</span>
                <span class="summary-chip-sub">monitored</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">✅</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Operational</span>
                <span class="summary-chip-value summary-chip-value--success">@OperationalNow</span>
                <span class="summary-chip-sub">right now</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">⚠️</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Degraded</span>
                <span class="summary-chip-value summary-chip-value--warning">@DegradedNow</span>
                <span class="summary-chip-sub">right now</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">⛔</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Down</span>
                <span class="summary-chip-value summary-chip-value--danger">@DownNow</span>
                <span class="summary-chip-sub">right now</span>
            </div>
        </div>
    </Summary>
    <ChildContent>
    <div class="kpi-grid">
        <KpiTile Label="Services" Value="@TotalNow.ToString()" Icon="🖥️" />
        <KpiTile Label="Operational" Value="@OperationalNow.ToString()" Sub="right now" Color="var(--sh-success)" Icon="✅" />
        <KpiTile Label="Degraded" Value="@DegradedNow.ToString()" Sub="right now" Color="var(--sh-warning)" Icon="⚠️" />
        <KpiTile Label="Down" Value="@DownNow.ToString()" Sub="right now" Color="var(--sh-danger)" Icon="⛔" />
    </div>
    <div class="section-divider"></div>
    <div class="health-list">
        @foreach (var row in Rows)
        {
            <div class="health-row">
                <div class="health-row-main">
                    <span class="health-name">@row.Name</span>
                    <span class="sb-badge @StatusBadgeClass(row.CurrentStatus)">@row.CurrentStatus</span>
                </div>
                <div class="health-row-stats">
                    <span class="health-up">@row.UpPct%</span>
                    <span class="health-up-text">@row.UptimeText</span>
                </div>
                <div class="health-row-timeline">
                    <TimelineStrip Segments="row.Segments" />
                </div>
            </div>
        }
        @if (Rows.Count == 0)
        {
            <div class="activity-empty">No services configured.</div>
        }
    </div>
    </ChildContent>
</SectionCard>
