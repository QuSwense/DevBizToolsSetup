@namespace OrbitHub.Dashboard.UI.Components

<div class="dash-card">
    <div class="card-header">
        <span class="card-title">@Title</span>
        @if (!IsSuperuser && !string.IsNullOrEmpty(CurrentUser))
        {
            <small class="text-sh-faint">@CurrentUser</small>
        }
    </div>
    <div class="files-breakdown">
        @foreach (var item in Items)
        {
            <div class="files-breakdown-item @(item.IsCurrent ? "activity-row-current" : "")">
                <div class="d-flex align-items-center gap-6px">
                    <span class="flex-shrink-0 d-inline-block"
                          style="width:10px;height:10px;border-radius:50%;background:@item.Color"></span>
                    <span class="fw-medium fs-12 @(item.IsCurrent ? "text-sh-accent" : "text-sh-soft")">@item.Label</span>
                    @if (item.IsCurrent)
                    {
                        <span class="activity-you">you</span>
                    }
                </div>
                <div class="files-breakdown-bar">
                    <div class="files-breakdown-fill"
                         style="width:@item.Percent%;background:@item.Color"></div>
                </div>
                <span class="fs-14 fw-bold" style="color:@item.Color">@item.Count</span>
            </div>
        }
    </div>
    @if (Items.Count == 0)
    {
        <div class="activity-empty">No activity found.</div>
    }
</div>
