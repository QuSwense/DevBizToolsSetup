@page "/soap/wsdl-sync"
@using Microsoft.Extensions.Configuration
@inject SoapAppStore _appStore
@inject WsdlSyncStore _wsdlStore
@inject MockDbLoader _mockDbLoader
@inject IJSRuntime _js
@inject NavigationManager _nav
@inject IConfiguration _config

@* ── Page Header ── *@
<div class="datagrid-card" style="padding:18px 22px;margin-bottom:12px">
    <div class="d-flex align-items-start justify-content-between gap-16px">
        <div>
            <div class="d-flex align-items-center gap-10px">
                <i class="bi bi-globe2 fs-24 text-sh-accent"></i>
                <h3 class="m-0 fs-18 fw-semibold">WSDL Sync</h3>
            </div>
            <p class="fs-13 text-sh-soft mt-1" style="max-width:500px">
                Import WSDL documents to create and update SOAP application definitions.
                Parser extracts only values between XML tags and attribute values.
            </p>
        </div>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick='() => OpenSyncModal()' type="button">
            <i class="bi bi-arrow-repeat"></i>
            Sync WSDL
        </button>
    </div>

    @* App selector *@
    <div class="d-flex align-items-center gap-12px border-sh-top" style="margin-top:14px;padding-top:14px">
        <label class="fs-12 fw-semibold text-sh-soft text-nowrap">Application</label>
        <select class="form-control-dg" style="max-width:300px" @bind="_selectedAppId" @bind:event="oninput">
            <option value="">Select a SOAP application...</option>
            @foreach (var app in _appStore.Apps.OrderBy(a => a.Name))
            {
                <option value="@app.Id">@app.Name</option>
            }
        </select>
        <span class="meta-pill" style="display:@(_selectedAppId is null or "" ? "none" : "inline-flex")">
            @_wsdlStore.GetRecordsForApp(_selectedAppId ?? "").Length syncs
        </span>
    </div>
</div>

@if (_appStore.Apps.Length == 0)
{
    @* Empty state when no applications exist at all (first-run) *@
    <div class="datagrid-card empty-state-card gap-10px" style="padding:48px 20px">
        <i class="bi bi-globe2 fs-36 text-sh-faint"></i>
        <h4 class="empty-state-title">No applications yet</h4>
        <p class="empty-state-desc">
            WSDL sync requires a SOAP application. Add one from the Applications page to start syncing WSDL versions.
        </p>
        <a class="btn btn-sh-primary btn-dg btn-dark mt-2" href="/soap/applications"
           @onclick="NavigateToApplications" @onclick:preventDefault="true">
            <i class="bi bi-arrow-right-circle"></i>
            Go to Applications
        </a>
    </div>
}
else if (string.IsNullOrEmpty(_selectedAppId))
{
    @* Empty state when no app selected *@
    <div class="datagrid-card empty-state-card gap-10px" style="padding:48px 20px">
        <i class="bi bi-hand-index-thumb fs-36 text-sh-faint"></i>
        <p class="empty-state-desc text-sh-soft">
            Select an application above to view its WSDL sync versions and templates.
        </p>
    </div>
}
else
{
    @* ── Two-panel layout ── *@
    <div style="display:grid;grid-template-columns:280px 1fr;gap:12px;align-items:start">

        @* ── LEFT PANEL: Tree Navigation ── *@
        <div class="datagrid-card overflow-hidden p-0">
            <div class="fs-11 fw-semibold text-uppercase ls-05 text-sh-faint border-sh-bottom" style="padding:10px 14px">
                <i class="bi bi-diagram-2 me-2"></i>Application → Version
            </div>
            <div style="padding:6px 0">
                @{
                    var selectedApp = _appStore.Apps.FirstOrDefault(a => a.Id == _selectedAppId);
                }
                @if (selectedApp is not null)
                {
                    var appVersions = _wsdlStore.Records
                        .Where(r => r.AppId == selectedApp.Id)
                        .SelectMany(r => _wsdlStore.GetVersionsForSync(r.Id))
                        .OrderByDescending(v => v.VersionNumber)
                        .ToArray();
                    <div class="tree-node tree-root @(_treeExpandedApps.Contains(selectedApp.Id) ? "is-expanded" : "")">
                        <div class="tree-row" @onclick="() => ToggleTreeApp(selectedApp.Id)" role="button" tabindex="0">
                            <span class="tree-chevron"><i class="bi @(_treeExpandedApps.Contains(selectedApp.Id) ? "bi-chevron-down" : "bi-chevron-right")"></i></span>
                            <span class="avatar-sm fs-9" style="width:20px;height:20px;min-width:20px">@selectedApp.Name[..Math.Min(2, selectedApp.Name.Length)].ToUpper()</span>
                            <span class="tree-label">@selectedApp.Name</span>
                        </div>
                        @if (_treeExpandedApps.Contains(selectedApp.Id))
                        {
                            <div class="tree-children">
                                @if (appVersions.Length == 0)
                                {
                                    <div class="tree-empty">No versions yet</div>
                                }
                                @foreach (var ver in appVersions)
                                {
                                    <div class="tree-node">
                                        <div class="tree-row tree-row-sub @(_selectedVersionId == ver.Id ? "is-active" : "")"
                                             @onclick="() => SelectVersion(ver.Id)" role="button" tabindex="0">
                                            <span class="tree-label">@ver.Label</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── RIGHT PANEL: Content Area ── *@
        <div class="d-flex flex-column gap-12px">
            @if (!string.IsNullOrEmpty(_selectedVersionId))
            {
                @* ═══════════════════════════════════════════ *@
                @* ── VERSION DETAILS PANEL ── *@
                @* ═══════════════════════════════════════════ *@
                var selectedVersion = _wsdlStore.Versions.FirstOrDefault(v => v.Id == _selectedVersionId);
                var parentRecord = selectedVersion is not null
                    ? _wsdlStore.Records.FirstOrDefault(r => r.Id == selectedVersion.SyncRecordId)
                    : null;
                var app = selectedVersion is not null
                    ? _appStore.Apps.FirstOrDefault(a => parentRecord is not null && a.Id == parentRecord.AppId)
                    : null;
                if (selectedVersion is not null && parentRecord is not null && app is not null)
                {
                    var wsdlContent = parentRecord.WsdlContent;
                    // Determine sync status from parent record
                    var syncStatus = parentRecord.Status; // "synced" | "failed" | "parsing"
                    var syncStatusLabel = syncStatus == "synced" ? "Synced" : syncStatus == "failed" ? "Failed" : "Pending";
                    var syncStatusClass = syncStatus == "synced" ? "status-enabled" : syncStatus == "failed" ? "status-down" : "status-warn";
                    // Source type label
                    var sourceTypeLabel = parentRecord.SourceType == "url" ? "Auto-update from URL" : "Local file upload";
                    // Previous version for change detection
                    var previousVersion = _wsdlStore.Versions
                        .Where(v => v.SyncRecordId == selectedVersion.SyncRecordId && v.VersionNumber < selectedVersion.VersionNumber)
                        .OrderByDescending(v => v.VersionNumber)
                        .FirstOrDefault();
                    // Mock file size
                    var wsdlFileSize = wsdlContent.Length > 0 ? $"{wsdlContent.Length / 1024.0:F1} KB" : "—";
                    var wsdlFileName = parentRecord.SourceType == "upload" ? parentRecord.SourceUrl : "wsdl.xml";

                    @* ── HEADER SECTION ── *@
                    <div class="datagrid-card" style="padding:16px 20px">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="d-flex align-items-center gap-10px">
                                    <span class="version-label-monofs">@selectedVersion.Label</span>
                                    <span class="status-badge @syncStatusClass">@syncStatusLabel</span>
                                    @if (previousVersion is null)
                                    {
                                        <span class="verb-badge" style="font-size:10px;background:var(--sh-accent-soft);color:var(--sh-accent);border-color:currentColor">
                                            <i class="bi bi-star"></i> Initial Version
                                        </span>
                                    }
                                    @if (selectedVersion.Status == "archived")
                                    {
                                        <span class="status-badge status-disabled">Archived</span>
                                    }
                                </div>
                                <p class="fs-12 text-sh-soft mt-1">
                                    @app.Name · @selectedVersion.Notes
                                </p>
                            </div>
                        </div>

                        @* ── METADATA SECTION ── *@
                        <div class="border-sh bg-sh-surface-2" style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;margin-top:12px;padding:12px">
                            <div>
                                <div class="fs-10 text-uppercase ls-05 text-sh-faint">Sync Date</div>
                                <div class="fs-13 fw-medium d-flex align-items-center gap-4px" style="margin-top:2px">
                                    <i class="bi bi-calendar3 text-sh-faint fs-11"></i>
                                    @selectedVersion.UploadedAt
                                </div>
                            </div>
                            <div>
                                <div class="fs-10 text-uppercase ls-05 text-sh-faint">Synced By</div>
                                <div class="fs-13 fw-medium d-flex align-items-center gap-4px" style="margin-top:2px">
                                    <i class="bi bi-person text-sh-faint fs-11"></i>
                                    @selectedVersion.UploadedBy
                                </div>
                            </div>
                            <div>
                                <div class="fs-10 text-uppercase ls-05 text-sh-faint">Source Type</div>
                                <div class="fs-13 fw-medium d-flex align-items-center gap-4px" style="margin-top:2px">
                                    <i class="bi @(parentRecord.SourceType == "url" ? "bi-cloud-download" : "bi-upload") text-sh-faint fs-11"></i>
                                    @sourceTypeLabel
                                </div>
                            </div>
                            <div>
                                <div class="fs-10 text-uppercase ls-05 text-sh-faint">WSDL File</div>
                                <div class="fs-13 fw-medium d-flex align-items-center gap-4px" style="margin-top:2px">
                                    <i class="bi bi-file-earmark-code text-sh-faint fs-11"></i>
                                    @wsdlFileName
                                    <span class="fs-10 text-sh-faint">(@wsdlFileSize)</span>
                                </div>
                            </div>
                        </div>

                        @* Change description *@
                        @if (!string.IsNullOrWhiteSpace(selectedVersion.Notes))
                        {
                            <div class="d-flex align-items-start gap-8px border-sh-top" style="margin-top:10px;padding-top:10px">
                                <i class="bi bi-chat-dots text-sh-faint fs-13" style="margin-top:1px"></i>
                                <div>
                                    <div class="fs-10 text-uppercase ls-05 text-sh-faint mb-1">Description</div>
                                    <div class="fs-13" style="color:var(--sh-text)">@selectedVersion.Notes</div>
                                </div>
                            </div>
                        }
                    </div>

                    @* ── WSDL CONTENT SECTION (Collapsible) ── *@
                    <div class="datagrid-card overflow-hidden p-0">
                        <div class="d-flex align-items-center justify-content-between gap-8px" style="padding:10px 16px;cursor:pointer;user-select:none"
                             @onclick="() => _expandedWsdlView = !_expandedWsdlView" role="button">
                            <div class="d-flex align-items-center gap-8px">
                                <i class="bi @(_expandedWsdlView ? "bi-chevron-down" : "bi-chevron-right") text-sh-faint fs-12"></i>
                                <i class="bi bi-code-slash text-sh-accent"></i>
                                <span class="fs-13 fw-semibold">WSDL Content</span>
                                <span class="meta-pill">@wsdlContent.Length chars</span>
                            </div>
                            <div class="d-flex gap-4px">
                                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" style="width:auto;height:26px;padding:0 8px;font-size:11px"
                                        @onclick:stopPropagation @onclick="() => CopyWsdlContent(wsdlContent)" title="Copy WSDL content" type="button">
                                    <i class="bi @(_wsdlCopied ? "bi-check-lg" : "bi-clipboard")"></i>
                                    @(_wsdlCopied ? "Copied" : "Copy")
                                </button>
                            </div>
                        </div>
                        @if (_expandedWsdlView && !string.IsNullOrWhiteSpace(wsdlContent))
                        {
                            var editorId = $"wsdl-content-{selectedVersion.Id}";
                            <div id="@editorId" style="height:320px;border-top:1px solid var(--sh-border)"></div>
                        }
                    </div>

                    @* ── WSDL COMPARE SECTION (Collapsible) — hidden for initial versions ── *@
                    @if (previousVersion is not null)
                    {
                        var prevRecord = _wsdlStore.Records.FirstOrDefault(r => r.Id == previousVersion.SyncRecordId);
                        var prevContent = prevRecord?.WsdlContent ?? "";
                        var currContent = wsdlContent;
                        var comparerId = $"wsdl-compare-{selectedVersion.Id}";
                        <div class="datagrid-card overflow-hidden p-0">
                            <div class="d-flex align-items-center justify-content-between gap-8px" style="padding:10px 16px;cursor:pointer;user-select:none"
                                 @onclick="() => ToggleWsdlCompare()" role="button">
                                <div class="d-flex align-items-center gap-8px">
                                    <i class="bi @(_expandedWsdlCompare ? "bi-chevron-down" : "bi-chevron-right") text-sh-faint fs-12"></i>
                                    <i class="bi bi-files text-sh-accent"></i>
                                    <span class="fs-13 fw-semibold">WSDL Compare</span>
                                    <span class="meta-pill">@previousVersion.Label ← → @selectedVersion.Label</span>
                                </div>
                            </div>
                            @if (_expandedWsdlCompare)
                            {
                                <div style="border-top:1px solid var(--sh-border)">
                                    <div style="padding:0">
                                        <div class="d-flex align-items-center gap-8px border-sh-bottom" style="padding:8px 16px;background:var(--sh-surface-2)">
                                            <i class="bi bi-arrow-left-right text-sh-faint fs-11"></i>
                                            <span class="fs-11 text-sh-soft">Comparing <strong>@previousVersion.Label</strong> (previous) with <strong>@selectedVersion.Label</strong> (current)</span>
                                        </div>
                                        <div id="@comparerId" style="height:420px;width:100%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* ── ACTIONS SECTION ── *@
                    <div class="datagrid-card" style="padding:14px 18px">
                        <div class="d-flex align-items-center gap-8px flex-wrap">

                            <button class="btn btn-outline-secondary btn-dg fs-11 h-32" @onclick="() => DownloadWsdl(wsdlContent, wsdlFileName)" type="button">
                                <i class="bi bi-download"></i>
                                Download WSDL
                            </button>
                            @if (selectedVersion.VersionNumber > 1)
                            {
                                <button class="btn btn-outline-secondary btn-dg fs-11 h-32" style="color:#dc3545;border-color:rgba(220,53,69,0.3)"
                                        @onclick="() => _showRollbackConfirm = true" type="button">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    Rollback to this Version
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @* Version not found, show records grid *@
                    @RenderRecordsGrid(_selectedAppId ?? "")
                }
            }
            else if (!string.IsNullOrEmpty(_selectedSyncId))
            {
                @* WSDL Record selected, show versions *@
                var record = _wsdlStore.Records.FirstOrDefault(r => r.Id == _selectedSyncId);
                var recordVersions = _wsdlStore.GetVersionsForSync(_selectedSyncId);
                if (record is not null)
                {
                    <div class="datagrid-card" style="padding:16px 20px">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="d-flex align-items-center gap-8px">
                                    <h4 class="m-0 fs-15 fw-semibold">
                                        <i class="bi @(record.SourceType == "url" ? "bi-link-45deg" : "bi-file-earmark-arrow-up")" style="margin-right:6px;color:var(--sh-accent)"></i>
                                        @(record.SourceType == "url" ? TruncateUrl(record.SourceUrl) : record.SourceUrl)
                                    </h4>
                                    <span class="status-badge @(record.Status == "synced" ? "status-enabled" : "status-down")">
                                        @(record.Status == "synced" ? "Synced" : record.Status == "failed" ? "Failed" : "Parsing...")
                                    </span>
                                </div>
                                <p class="fs-12 text-sh-soft mt-1">
                                    @record.UploadedAt — @record.UploadedBy
                                </p>
                            </div>
                        </div>
                    </div>

                    @* Versions grid *@
                    <div class="datagrid-card">
                        <div class="grid-toolbar">
                            <div class="toolbar-left">
                                <div class="meta-group">
                                    <span class="meta-pill">@recordVersions.Length version(s)</span>
                                </div>
                            </div>
                        </div>
                        <div class="table-wrap">
                            <table class="datagrid">
                                <thead>
                                    <tr>
                                        <th class="sortable"><span class="th-inner">Version<span class="sort-indicator"><i class="bi bi-chevron-expand"></i></span></span></th>
                                        <th>Uploaded By</th>
                                        <th>Uploaded At</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ver in recordVersions)
                                    {
                                        <tr class="@(_selectedVersionId == ver.Id ? "is-selected" : "") cursor-pointer" @onclick="() => SelectVersion(ver.Id)" role="button">
                                            <td><span class="cell-id">@ver.Label</span></td>
                                            <td class="text-sh-soft">@ver.UploadedBy</td>
                                            <td class="text-sh-soft">@ver.UploadedAt</td>
                                            <td>
                                                <span class="status-badge @(ver.Status == "active" ? "status-enabled" : "status-disabled")">
                                                    @(ver.Status == "active" ? "Active" : "Archived")
                                                </span>
                                            </td>
                                            <td class="text-sh-soft" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@ver.Notes</td>
                                            <td>
                                                <div class="action-icons">
                                                    <button class="action-icon-btn" @onclick:stopPropagation @onclick="() => SelectVersion(ver.Id)" data-tooltip="View version details">
                                                        <i class="bi bi-eye"></i> View
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            else
            {
                @* Show all records for the selected app *@
                @RenderRecordsGrid(_selectedAppId ?? "")
            }
        </div>
    </div>

    @* ── TEMPLATES SECTION (below two-panel) ── *@
    <div class="mt-3">
        <div class="datagrid-card">
            <div class="grid-toolbar">
                <div class="toolbar-left">
                    <div class="fs-13 fw-semibold">
                        <i class="bi bi-file-text me-2 text-sh-accent"></i>Request File Templates
                    </div>
                    <div class="meta-group ms-3">
                        <span class="meta-pill">@_wsdlStore.Templates.Count templates</span>
                    </div>
                </div>
                <div class="toolbar-right">
                    <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => OpenTemplateEditor(null)" type="button">
                        <i class="bi bi-plus-lg"></i>
                        Create Template
                    </button>
                </div>
            </div>
            <div class="table-wrap">
                <table class="datagrid">
                    <thead>
                        <tr>
                            <th class="sortable"><span class="th-inner">Template Name<span class="sort-indicator"><i class="bi bi-chevron-expand"></i></span></span></th>
                            <th>Description</th>
                            <th>Extends</th>
                            <th>Variables</th>
                            <th>Usage</th>
                            <th>Updated</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tpl in _wsdlStore.GetTemplates())
                        {
                            <tr>
                                <td><span class="cell-id">@tpl.Name</span></td>
                                <td class="cell-truncated">@tpl.Description</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(tpl.ExtendsTemplateName))
                                    {
                                        <span class="type-badge text-sh-accent" style="background:var(--sh-accent-soft);border-color:currentColor">
                                            <i class="bi bi-arrow-up-short me-1"></i>@tpl.ExtendsTemplateName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-sh-faint">—</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;gap:4px;flex-wrap:wrap">
                                        @foreach (var v in tpl.Variables)
                                        {
                                            <span class="verb-badge" style="font-family:'JetBrains Mono','Menlo',monospace;font-size:10px;background:var(--sh-surface-2);border-color:var(--sh-border);color:var(--sh-text-soft)">
                                                {{@v}}
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-sh-soft">@tpl.Variables.Length</td>
                                <td class="text-sh-soft">@tpl.UpdatedAt</td>
                                <td>
                                    <div class="action-icons">
                                        <button class="action-icon-btn" @onclick="() => OpenTemplateEditor(tpl.Id)" data-tooltip="Edit template">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <button class="action-icon-btn" @onclick="() => OpenCreateFromTemplate(tpl.Id)" data-tooltip="Create request file from template">
                                            <i class="bi bi-file-earmark-plus"></i> Use
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════ *@
@* ── SYNC MODAL ── *@
@* ══════════════════════════════════════════════════ *@
@if (_showSyncModal)
{
    var syncApp = _appStore.Apps.FirstOrDefault(a => a.Id == _syncAppId);
    var autoVersion = syncApp is not null ? GenerateVersionNumber(syncApp.Name) : "";
    var autoSourceUrl = syncApp is not null
        ? $"{syncApp.BaseUrl.TrimEnd('/')}/{syncApp.WsdlPath.TrimStart('/')}"
        : "";

    <div class="modal-overlay" @onclick="() => _showSyncModal = false">
        <div class="modal-content-dg" style="width:600px" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>
                    <i class="bi bi-arrow-repeat"></i>
                    Sync WSDL
                </h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showSyncModal = false" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                @* Application (read-only) *@
                <div class="form-group">
                    <label>Application</label>
                    <div class="d-flex align-items-center gap-8px" style="padding:8px 12px;background:var(--sh-surface-2);border:1px solid var(--sh-border);border-radius:4px">
                        @if (syncApp is not null)
                        {
                            <span class="avatar-sm fs-9" style="width:22px;height:22px;min-width:22px">@syncApp.Name[..Math.Min(2, syncApp.Name.Length)].ToUpper()</span>
                            <span class="fw-medium fs-13">@syncApp.Name</span>
                        }
                        else
                        {
                            <span class="text-sh-faint fs-13">No application selected</span>
                        }
                    </div>
                </div>

                @* ── Sync Mode Toggle (Radio buttons) ── *@
                <div class="form-group">
                    <label>Sync Method</label>
                    <div class="d-flex gap-8px">
                        <button type="button" class="sync-mode-option @(_syncMode == "upload" ? "is-selected" : "")"
                                @onclick="() => SelectUploadMode()">
                            <i class="bi bi-upload"></i>
                            <span>Upload WSDL File</span>
                        </button>
                        <button type="button" class="sync-mode-option @(_syncMode == "auto-update" ? "is-selected" : "")"
                                @onclick="() => SelectAutoUpdateMode(autoSourceUrl)">
                            <i class="bi bi-cloud-download"></i>
                            <span>Auto-Update from Application</span>
                        </button>
                    </div>
                </div>

                @* Source details *@
                @if (_syncMode == "upload")
                {
                    <div class="form-group">
                        <label>WSDL File</label>
                        <div style="border:1px dashed var(--sh-border);padding:20px;text-align:center;background:var(--sh-surface-2);border-radius:4px;cursor:pointer"
                             @onclick='() => { _syncFileName = string.IsNullOrEmpty(_syncFileName) ? "sample.wsdl" : _syncFileName; if (!string.IsNullOrEmpty(_syncFileName) && !_comparisonPerformed) PerformComparison(""); }' role="button">
                            <i class="bi bi-file-earmark-code" style="font-size:28px;display:block;margin-bottom:6px;color:var(--sh-text-faint)"></i>
                            @if (string.IsNullOrEmpty(_syncFileName))
                            {
                                <div style="font-size:13px;color:var(--sh-text-soft)">
                                    Click to select a <strong>.wsdl</strong> or <strong>.xml</strong> file
                                </div>
                                <div style="font-size:11px;color:var(--sh-text-faint);margin-top:4px">
                                    or drag and drop here
                                </div>
                            }
                            else
                            {
                                <div style="font-size:13px;font-weight:500">@_syncFileName</div>
                                <div style="font-size:11px;color:var(--sh-text-faint);margin-top:4px">
                                    <i class="bi bi-check-circle" style="color:var(--sh-accent)"></i> File selected
                                </div>
                            }
                        </div>
                    </div>

                    @* Simulate file selection for mock demo *@
                    @if (string.IsNullOrEmpty(_syncFileName))
                    {
                        <div class="bg-sh-surface-2 border-sh" style="padding:8px 12px;margin-bottom:10px">
                            <div class="fs-10 text-uppercase ls-05 text-sh-faint mb-1">Mock Demo — Quick Select</div>
                            <div class="d-flex gap-6px">
                                <button class="btn btn-outline-secondary btn-dg fs-10" style="height:26px;padding:0 10px" @onclick='() => { _syncFileName = "billing_v3.wsdl"; PerformComparison(""); }' type="button">
                                    <i class="bi bi-check-circle text-sh-accent"></i> Same WSDL (no changes)
                                </button>
                                <button class="btn btn-outline-secondary btn-dg fs-10" style="height:26px;padding:0 10px" @onclick='() => { _syncFileName = "billing_v4.wsdl"; PerformComparison(""); }' type="button">
                                    <i class="bi bi-arrow-repeat text-sh-accent"></i> Changed WSDL (with changes)
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="form-group">
                        <label>Source URL</label>
                        <div class="d-flex align-items-center gap-6px" style="padding:8px 12px;background:var(--sh-surface-2);border:1px solid var(--sh-border);border-radius:4px">
                            <i class="bi bi-link-45deg text-sh-accent fs-14"></i>
                            <span class="fs-12 text-break">@autoSourceUrl</span>
                        </div>
                        <div style="font-size:11px;color:var(--sh-text-faint);margin-top:4px">
                            <i class="bi bi-info-circle"></i>
                            Fetched from the app's stored Base URL + WSDL path.
                        </div>
                    </div>
                }

                @* ═══ WSDL Change Detection Status ═══ *@
                @if (_comparisonPerformed)
                {
                    <div class="form-group">
                        <label>WSDL Change Detection</label>
                        @if (_changeDetected)
                        {
                            <div class="d-flex align-items-center gap-8px" style="padding:10px 14px;background:rgba(40,167,69,0.08);border:1px solid rgba(40,167,69,0.25);border-radius:4px">
                                <i class="bi bi-check-circle-fill" style="color:#28a745;font-size:16px"></i>
                                <div>
                                    <div class="fs-13 fw-semibold" style="color:#28a745">Changes detected in WSDL. Ready to update.</div>
                                    <div class="fs-11 text-sh-soft" style="margin-top:2px">New operations, bindings, or types found. A new version will be created.</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-8px" style="padding:10px 14px;background:rgba(255,193,7,0.08);border:1px solid rgba(255,193,7,0.25);border-radius:4px">
                                <i class="bi bi-exclamation-triangle-fill" style="color:#ffc107;font-size:16px"></i>
                                <div>
                                    <div class="fs-13 fw-semibold" style="color:#ffc107">No changes detected in WSDL. Update not required.</div>
                                    <div class="fs-11 text-sh-soft" style="margin-top:2px">The WSDL content matches the previously stored version. No new version needed.</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* Auto-generated version (read-only) *@
                <div class="form-group">
                    <label>Version</label>
                    <div class="d-flex align-items-center gap-6px" style="padding:8px 12px;background:var(--sh-surface-2);border:1px solid var(--sh-border);border-radius:4px">
                        <i class="bi bi-tag text-sh-accent fs-14"></i>
                        <span class="fw-semibold fs-14 mono-text text-sh-accent">@autoVersion</span>
                        <span class="fs-10 text-sh-faint">(auto-generated)</span>
                    </div>
                </div>

                @* Description (user input) *@
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control-dg textarea" placeholder="Describe what changed in this WSDL update..."
                              @bind="_syncDescription" @bind:event="oninput" style="min-height:70px"></textarea>
                </div>
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => _showSyncModal = false" type="button">Cancel</button>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => HandleSync(autoVersion, autoSourceUrl)" type="button"
                        disabled="@(!_changeDetected)">
                    <i class="bi bi-arrow-repeat"></i>
                    Sync WSDL
                </button>
                @if (!_changeDetected && _comparisonPerformed)
                {
                    <span class="fs-10 text-sh-faint ms-1">No changes — button disabled</span>
                }
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════ *@
@* ── TEMPLATE EDITOR MODAL ── *@
@* ══════════════════════════════════════════════════ *@
@if (_showTemplateEditor)
{
    <div class="modal-overlay" @onclick="() => _showTemplateEditor = false">
        <div class="modal-content-dg" style="width:680px" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>@(_editingTemplateId is null ? "Create" : "Edit") Template</h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" type="button" aria-label="Close" @onclick="() => _showTemplateEditor = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                <div class="form-group">
                    <label>Template Name</label>
                    <input type="text" class="form-control-dg" placeholder="e.g. Billing Invoice Request"
                           @bind="_editTplName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <input type="text" class="form-control-dg" placeholder="Describe what this template is for..."
                           @bind="_editTplDescription" @bind:event="oninput" />
                </div>

                @* Extend template *@
                <div class="form-group">
                    <label>Extends Template <span class="fw-normal text-sh-faint">(optional)</span></label>
                    <select class="form-control-dg" @bind="_editTplExtendsId" @bind:event="oninput">
                        <option value="">None — Base template</option>
                        @foreach (var t in _wsdlStore.GetTemplates().Where(t => t.Id != _editingTemplateId))
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                    <div class="fs-11 text-sh-faint mt-1">
                        <i class="bi bi-info-circle"></i>
                        Extending a template inherits its content and variables. The child can override or add new variables.
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_editTplExtendsId))
                {
                    var parent = _wsdlStore.GetTemplate(_editTplExtendsId);
                    if (parent is not null)
                    {
                        <div class="bg-sh-surface-2 border-sh mb-3" style="padding:10px 12px">
                            <div class="fs-10 text-uppercase ls-05 text-sh-faint" style="margin-bottom:6px">
                                <i class="bi bi-arrow-up-short"></i> Inherited from: @parent.Name
                            </div>
                            <div style="display:flex;gap:4px;flex-wrap:wrap">
                                @foreach (var v in parent.Variables)
                                {
                                    <span class="verb-badge mono-text fs-10 bg-sh-surface-2" style="border-color:var(--sh-border);color:var(--sh-accent)">
                                        {{@v}} <span class="text-sh-faint" style="font-size:9px">(inherited)</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }

                <div class="form-group">
                    <label>WSDL File</label>
                    <select class="form-control-dg" value="@_editTplWsdlFile" @onchange="OnTemplateWsdlFileChanged">
                        @foreach (var wsdlFile in _mockDbLoader.GetWsdlFileNames())
                        {
                            <option value="@wsdlFile">@wsdlFile</option>
                        }
                    </select>
                    <div class="fs-11 text-sh-faint mt-1">
                        <i class="bi bi-info-circle"></i>
                        The template references a WSDL file. Its content is loaded from — and saved back to — the selected file.
                    </div>
                </div>

                <div class="form-group">
                    <label>WSDL Content</label>
                    <textarea class="form-control-dg textarea" placeholder="WSDL content loaded from the selected file. Edit then save to update the file."
                              style="min-height:180px;font-family:'JetBrains Mono','Menlo',monospace;font-size:12px;line-height:1.6"
                              @bind="_editTplContent" @bind:event="oninput"></textarea>
                </div>

                @* Parsed variables preview *@
                @{
                    var parsedVars = ExtractTemplateVars(_editTplContent);
                }
                @if (parsedVars.Length > 0)
                {
                    <div class="bg-sh-surface-2 border-sh" style="padding:10px 12px">
                        <div class="fs-10 text-uppercase ls-05 text-sh-faint mb-1">
                            <i class="bi bi-tags"></i> Detected Variables (@parsedVars.Length)
                        </div>
                        <div class="d-flex gap-4px flex-wrap">
                            @foreach (var v in parsedVars)
                            {
                                <span class="verb-badge verb-badge-accent">
                                    {{@v}}
                                </span>
                            }
                        </div>
                        <div class="fs-10 text-sh-faint mt-1">
                            <i class="bi bi-lightbulb"></i>
                            These variables will prompt the user with a dynamic form when creating a request file.
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => _showTemplateEditor = false" type="button">Cancel</button>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="HandleSaveTemplate" type="button">
                    <i class="bi bi-check-lg"></i>
                    @(_editingTemplateId is null ? "Create" : "Save") Template
                </button>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════ *@
@* ── CREATE REQUEST FILE FROM TEMPLATE (Dynamic Form) ── *@
@* ══════════════════════════════════════════════════ *@
@if (_showCreateRequestModal)
{
    var template = _wsdlStore.GetTemplate(_selectedTemplateId);
    if (template is not null)
    {
        var allVars = _wsdlStore.ResolveVariables(template);
        var templateContent = _createRequestTemplateContent;

        <div class="modal-overlay" @onclick="() => _showCreateRequestModal = false">
            <div class="modal-content-dg" style="width:620px" @onclick:stopPropagation="true">
                <div class="modal-header-dg">
                    <h3>Create Request File</h3>
                    <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showCreateRequestModal = false" type="button" aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body-dg">
                    <div class="d-flex align-items-center gap-8px bg-sh-surface-2 border-sh" style="margin-bottom:14px;padding:8px 12px">
                        <i class="bi bi-file-text text-sh-accent"></i>
                        <span class="fs-13 fw-medium">Template: <span class="cell-id">@template.Name</span></span>
                        @if (!string.IsNullOrEmpty(template.ExtendsTemplateName))
                        {
                            <span class="fs-11 text-sh-faint">
                                (extends <span class="cell-id">@template.ExtendsTemplateName</span>)
                            </span>
                        }
                    </div>

                    <div class="form-group">
                        <label>File Name</label>
                        <input type="text" class="form-control-dg" placeholder="e.g. create_invoice.xml"
                               @bind="_requestFileName" @bind:event="oninput" />
                    </div>

                    @* Dynamic form generated from template variables *@
                    <div class="border-sh-top pt-3 mt-1">
                        <div class="fs-11 fw-semibold text-uppercase ls-05 text-sh-soft mb-2">
                            <i class="bi bi-pencil-square"></i> Fill in Template Variables
                        </div>
                        @foreach (var v in allVars)
                        {
                            <div class="form-group">
                                <label>@v.Label</label>
                                <div style="display:flex;align-items:center;gap:8px">
                                    <code class="fs-11 text-sh-faint text-nowrap">{{@v.Name}}</code>
                                    @if (v.InputType == "textarea")
                                    {
                                        <textarea class="form-control-dg" style="flex:1;font-family:'JetBrains Mono','Menlo',monospace;font-size:12px;min-height:60px"
                                                  placeholder="Enter @v.Label..."
                                                  @bind="_requestVarValues[v.Name]" @bind:event="oninput"></textarea>
                                    }
                                    else if (v.InputType == "select" && v.Options.Length > 0)
                                    {
                                        <select class="form-control-dg" style="flex:1" @bind="_requestVarValues[v.Name]" @bind:event="oninput">
                                            <option value="">Select @v.Label...</option>
                                            @foreach (var opt in v.Options)
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control-dg" style="flex:1;font-family:'JetBrains Mono','Menlo',monospace;font-size:12px"
                                               placeholder="Enter @v.Label..."
                                               @bind="_requestVarValues[v.Name]" @bind:event="oninput" />
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @* Preview of the generated request file *@
                    @{
                        var previewContent = WsdlSyncStore.ApplyVariables(templateContent, _requestVarValues);
                    }
                    <div class="border-sh-top" style="margin-top:12px;padding-top:12px">
                        <div class="d-flex align-items-center justify-content-between" style="margin-bottom:6px">
                            <span class="fs-11 fw-semibold text-uppercase ls-05 text-sh-soft">
                                <i class="bi bi-eye"></i> Preview
                            </span>
                            <span class="fs-10 text-sh-faint">@previewContent.Length chars</span>
                        </div>
                        <pre class="m-0 p-10 bg-sh-surface-2 border-sh mono-text" style="font-size:11px;line-height:1.5;max-height:200px;overflow:auto;white-space:pre-wrap;text-break">@previewContent</pre>
                    </div>
                </div>
                <div class="modal-footer-dg">
                    <button class="btn btn-dg" @onclick="() => _showCreateRequestModal = false" type="button">Cancel</button>
                    <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="HandleCreateRequestFile" type="button">
                        <i class="bi bi-file-earmark-check"></i>
                        Create Request File
                    </button>
                </div>
            </div>
        </div>
    }
}

@* ══════════════════════════════════════════════════ *@
@* ── ROLLBACK CONFIRMATION ── *@
@* ══════════════════════════════════════════════════ *@
@if (_showRollbackConfirm)
{
    <div class="modal-overlay" @onclick="() => _showRollbackConfirm = false">
        <div class="modal-content-dg" style="width:440px" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3><i class="bi bi-arrow-counterclockwise" style="color:#dc3545"></i> Rollback Version</h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showRollbackConfirm = false" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                <div class="d-flex align-items-start gap-10px" style="padding:10px 14px;background:rgba(220,53,69,0.06);border:1px solid rgba(220,53,69,0.2);border-radius:4px">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#dc3545;font-size:18px;flex-shrink:0;margin-top:1px"></i>
                    <div>
                        <div class="fs-13 fw-semibold" style="color:#dc3545">Confirm Rollback</div>
                        <div class="fs-12 text-sh-soft mt-1">
                            Rolling back will revert the WSDL to this version. A new version entry will be created with the restored content. This action can be tracked in the version history.
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => _showRollbackConfirm = false" type="button">Cancel</button>
                <button class="btn btn-dg" style="border-color:#dc3545;color:#dc3545" @onclick="HandleRollback" type="button">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Confirm Rollback
                </button>
            </div>
        </div>
    </div>
}

