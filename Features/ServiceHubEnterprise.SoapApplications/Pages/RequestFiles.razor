@page "/soap/request-files"
@inject SoapAppStore _appStore
@inject MockDbLoader _mockDbLoader
@inject NavigationManager _nav
@inject IExecutionEngine _engine
@inject SoapExecutionStore _executionStore
@inject SoapTestCaseStore _testCaseStore

@* ── Loading Skeleton ── *@
@if (_isLoading)
{
    <div class="datagrid-card" style="padding:0">
        <div class="skeleton-table">
            <div class="skeleton-header">
                <div class="skeleton-cell skeleton-check"></div>
                <div class="skeleton-cell skeleton-file-name"></div>
                <div class="skeleton-cell skeleton-app-name"></div>
                <div class="skeleton-cell skeleton-operation"></div>
                <div class="skeleton-cell skeleton-updated"></div>
                <div class="skeleton-cell skeleton-actions"></div>
            </div>
            @RenderSkeletonRows
        </div>
    </div>
}
else if (_hasError)
{
    <div class="datagrid-card error-state-card">
        <i class="bi bi-exclamation-triangle fs-28 text-danger"></i>
        <p class="error-state-text">@_errorMessage</p>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="LoadFilesAsync" type="button">
            <i class="bi bi-arrow-repeat"></i>
            Retry
        </button>
        <button class="btn btn-outline-secondary btn-dg ms-2" @onclick="DismissError" type="button">Dismiss</button>
    </div>
}
else if (_files.Length == 0)
{
    @if (_appStore.Apps.Length == 0)
    {
        <div class="datagrid-card empty-state-card">
            <i class="bi bi-folder-plus" style="font-size:36px;color:var(--sh-text-faint)"></i>
            <h4 class="empty-state-title">Add an application first</h4>
            <p class="empty-state-desc">Request files belong to a SOAP application. Head to the Applications page to create one.</p>
            <a class="btn btn-sh-primary btn-dg btn-dark mt-2" href="/soap/applications"
               @onclick="NavigateToApplications" @onclick:preventDefault="true">
                <i class="bi bi-arrow-right-circle"></i>
                Go to Applications
            </a>
        </div>
    }
    else
    {
        <div class="datagrid-card empty-state-card">
            <i class="bi bi-file-earmark-plus" style="font-size:36px;color:var(--sh-text-faint)"></i>
            <h4 class="empty-state-title">No request files yet</h4>
            <p class="empty-state-desc">Upload request files for your applications to start executing them.</p>
            <button class="btn btn-sh-primary btn-dg btn-dark mt-2" @onclick="() => _showUploadModal = true" type="button" aria-label="Upload File">
                <i class="bi bi-plus-lg"></i>
                Upload File
            </button>
        </div>
    }
}
else
{
    <ServiceHubGrid TItem="SoapRequestFile"
                    Id="requestFilesGrid"
                    @ref="_grid"
                    Items="FilteredFiles"
                    @bind-SelectedIds="_selectedIds"
                    PageSize="10"
                    EnableSelection="true"
                    EnablePagination="true"
                    EnableSearch="true"
                    EnableExpand="true"
                    EnableContextMenu="true"
                SearchPlaceholder="Search request files..."
                EmptyText="No request files found matching the current filters."
                FilterModalTitle="Filter Request Files"
                    @bind-SortColumn="_sortColumn"
                    @bind-SortAscending="_sortAscending"
                    @bind-CurrentPage="_currentPage"
                    @bind-SearchText="_searchText"
                    @bind-ShowFilterModal="_showFilterModal"
                    FilterApplied="OnFilterApplied"
                    RowIdSelector="@(f => f.FileName)"
                    ActionRowClosed="OnActionRowClosed"
                    Columns="@_columns">

    <ToolbarCenter>
        <button class="filter-btn" type="button" aria-label="Filter request files" @onclick="() => _showFilterModal = true">
            <i class="bi bi-funnel"></i>
            Filter
        </button>
    </ToolbarCenter>

    <ToolbarRight>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => _showUploadModal = true" type="button" aria-label="Upload File">
            <i class="bi bi-plus-lg"></i>
            Upload File
        </button>
        <div class="position-relative">
            <button class="btn btn-outline-secondary btn-dg" @onclick="() => _showDropdown = !_showDropdown" type="button">
                <i class="bi bi-three-dots-vertical"></i>
                Actions
                <i class="bi bi-chevron-down"></i>
            </button>
            @if (_showDropdown)
            {
                <div class="position-fixed" style="inset:0;z-index:50" @onclick="() => _showDropdown = false"></div>
                <div class="dropdown-menu-dg">
                    <div class="py-1">
                        <div class="dropdown-header-dg">Execute</div>
                        <button class="btn dropdown-item-dg" @onclick="ExecuteSelectedAsync" type="button">
                            <i class="bi bi-play-fill"></i>
                            Execute Selected
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <div class="dropdown-header-dg">Export</div>
                        <button class="btn dropdown-item-dg" @onclick="ExportToCsvAsync" type="button">
                            <i class="bi bi-download"></i>
                            Export to CSV
                        </button>
                        <button class="btn dropdown-item-dg" @onclick="ExportToJsonAsync" type="button">
                            <i class="bi bi-download"></i>
                            Export to JSON
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <button class="btn dropdown-item-dg dropdown-item-sh-danger" @onclick="DeleteSelectedAsync" type="button">
                            <i class="bi bi-trash3"></i>
                            Delete Selected
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <div class="dropdown-header-dg">View</div>
                        <button class="btn dropdown-item-dg"
                                @onclick="() => { _showDropdown = false; ResetAdvancedFilters(); }"
                                type="button">
                            <i class="bi bi-arrow-repeat"></i>
                            Reset Filter
                        </button>
                        <button class="btn dropdown-item-dg"
                                @onclick="HandleResetSort"
                                type="button">
                            <i class="bi bi-arrow-up-short"></i>
                            Reset Sort
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <button class="btn dropdown-item-dg"
                                @onclick="ExpandSelected"
                                type="button">
                            <i class="bi bi-arrows-expand"></i>
                            Expand Selected
                        </button>
                        <button class="btn dropdown-item-dg"
                                @onclick="CollapseSelected"
                                type="button">
                            <i class="bi bi-arrows-collapse"></i>
                            Collapse Selected
                        </button>
                    </div>
                </div>
            }
        </div>
    </ToolbarRight>

    <RowActions Context="file">
        <div class="row-actions-wrap blazor-managed@(_expandedActionRows.Contains(file.FileName) ? " is-open" : "")">
            <button class="action-trigger" type="button" aria-label="More actions" data-tooltip="More actions"
                    @onclick="() => _expandedActionRows.Add(file.FileName)">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
            </button>
            <div class="inline-actions">
                <button class="ia-btn ia-normal" type="button" aria-label="Execute" data-tooltip="Execute"
                        @onclick="() => ExecuteFileAsync(file)">
                    <i class="bi bi-play-fill" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-normal" type="button" aria-label="History" data-tooltip="Execution history"
                        @onclick="() => NavigateToFileHistory(file)">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-normal" type="button" aria-label="Test Cases" data-tooltip="Test cases"
                        @onclick="() => OpenTestCasesModal(file)">
                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-normal" type="button" aria-label="Edit" data-tooltip="Edit file content"
                        @onclick="() => NavigateToEditor(file)">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-danger" type="button" aria-label="Delete" data-tooltip="Delete"
                        @onclick="() => DeleteFileAsync(file)">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
                <button class="ia-btn @(file.Status == "active" ? "ia-enable" : "ia-normal")" type="button" aria-label="Toggle" data-tooltip="@(file.Status == "active" ? "Disable" : "Enable")"
                        @onclick="() => ToggleFileStatus(file)">
                    @if (file.Status == "active")
                    {
                        <i class="bi bi-toggle-off" aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="bi bi-toggle-on" aria-hidden="true"></i>
                    }
                </button>
                <button class="ia-btn ia-close" type="button" aria-label="Close" data-tooltip="Close"
                        @onclick="() => _expandedActionRows.Remove(file.FileName)">
                    <i class="bi bi-x-lg fs-11" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </RowActions>

    <DetailRow Context="file">
        <div class="detail-grid">
            <div>
                <div class="detail-label">File Name</div>
                <div class="detail-value mono-text">@file.FileName</div>
            </div>
            <div>
                <div class="detail-label">Application</div>
                <div class="detail-value">@file.AppName</div>
            </div>
            <div class="grid-col-full">
                <div class="detail-label">Operation</div>
                <div class="detail-value d-flex align-items-center gap-8px">
                    <span class="cell-id">@file.ApiPath</span>
                    <span class="verb-badge verb-badge-accent fs-10">@file.Verb</span>
                </div>
            </div>
            <div class="grid-col-full">
                <div class="detail-label">Description</div>
                <div class="detail-value">@(string.IsNullOrEmpty(file.Description) ? "—" : file.Description)</div>
            </div>
            <div>
                <div class="detail-label">Status</div>
                <div class="detail-value">
                    <span class="status-badge @(file.Status == "active" ? "status-enabled" : "status-disabled")">
                        @(file.Status == "active" ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
            <div>
                <div class="detail-label">Created By</div>
                <div class="detail-value">@file.CreatedBy</div>
            </div>
            <div>
                <div class="detail-label">Created At</div>
                <div class="detail-value">@file.CreatedAt.ToString("yyyy-MM-dd")</div>
            </div>
            <div>
                <div class="detail-label">Last Updated By</div>
                <div class="detail-value">@(file.UpdatedBy ?? "—")</div>
            </div>
            <div>
                <div class="detail-label">Last Updated At</div>
                <div class="detail-value">@(file.UpdatedAt?.ToString("yyyy-MM-dd") ?? "—")</div>
            </div>
        </div>
    </DetailRow>

    <FilterModalBody>
        <div class="form-group">
            <label>File Name</label>
            <input type="text" class="form-control-dg" placeholder="Filter by file name..."
                   @bind="_filterFileName" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Application</label>
            <input type="text" class="form-control-dg" placeholder="Filter by application..."
                   @bind="_filterAppName" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Operation</label>
            <input type="text" class="form-control-dg" placeholder="Filter by operation..."
                   @bind="_filterOperation" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Verb</label>
            <select class="form-control-dg" @bind="_filterVerb">
                <option value="">All</option>
                <option value="GET">GET</option>
                <option value="POST">POST</option>
            </select>
        </div>
        <div class="form-group">
            <label>Status</label>
            <select class="form-control-dg" @bind="_filterStatus">
                <option value="">All</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <div class="form-group">
            <label>Created By</label>
            <input type="text" class="form-control-dg" placeholder="Filter by creator..."
                   @bind="_filterCreatedBy" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Last Updated By</label>
            <input type="text" class="form-control-dg" placeholder="Filter by updater..."
                   @bind="_filterUpdatedBy" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Last Updated Date</label>
            <div class="d-flex gap-8px align-items-center">
                <input type="date" class="form-control-dg" @bind="_filterUpdatedDateFrom" />
                <span class="text-sh-faint">to</span>
                <input type="date" class="form-control-dg" @bind="_filterUpdatedDateTo" />
            </div>
        </div>
        <div class="form-group">
            <label>Created Date</label>
            <div class="d-flex gap-8px align-items-center">
                <input type="date" class="form-control-dg" @bind="_filterCreatedDateFrom" />
                <span class="text-sh-faint">to</span>
                <input type="date" class="form-control-dg" @bind="_filterCreatedDateTo" />
            </div>
        </div>
    </FilterModalBody>
</ServiceHubGrid>
}

@if (_showExecutionProgress && _activeGroup is not null)
{
    <div class="modal-overlay">
        <div class="modal-content-dg modal-w-760" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>
                    <i class="bi bi-play-circle me-2"></i>Executing
                    <span class="mono-text fs-12 ms-2">@_activeGroup.Id</span>
                </h3>
                <span class="status-badge @(_executionFinished ? "status-enabled" : "status-warn")">
                    @(_executionFinished ? "Completed" : "Running…")
                </span>
            </div>
            <div class="modal-body-dg">
                <div class="fs-12 text-sh-soft mb-3">
                    Triggered by @_activeGroup.TriggeredBy · Started @_activeGroup.StartedAt · @_activeGroup.Files.Count file(s)
                </div>
                @foreach (var file in _activeGroup.Files)
                {
                    <div class="exec-file-row">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="mono-text fw-semibold">@file.FileName</span>
                                <span class="text-sh-faint fs-11 ms-2">@file.AppName · @file.Operation</span>
                            </div>
                            <span class="status-badge @(file.Status == "success" ? "status-enabled" : file.Status == "failed" ? "status-down" : "status-warn")">
                                @(file.Status == "success" ? "Success" : file.Status == "failed" ? "Failed" : GetStageLabel(file.Stage))
                            </span>
                        </div>
                        <div class="exec-stage-strip">
                            @foreach (var stage in Enum.GetValues<ExecutionStage>())
                            {
                                var state = GetStageState(file, stage);
                                <div class="exec-stage exec-stage-@state" title="@GetStageLabel(stage)">
                                    <i class="bi @(state == "done" ? "bi-check-circle-fill" : state == "active" ? "bi-arrow-repeat spin" : "bi-circle")"></i>
                                    <span>@GetStageLabel(stage)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer-dg">
                <span class="fs-12 text-sh-soft me-auto">
                    <i class="bi bi-database-check me-1"></i>Saved to execution history when complete
                </span>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => _showExecutionProgress = false" type="button">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@if (_showTestCasesModal && _tcFile is not null)
{
    <div class="modal-overlay" @onclick="CloseTestCasesModal">
        <div class="modal-content-dg modal-w-640" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3><i class="bi bi-clipboard-check me-2"></i>Test Cases</h3>
                <span class="mono-text fs-12 text-sh-soft me-auto ms-2">@_tcFile.FileName</span>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="CloseTestCasesModal" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                @if (_fileTestCases.Length == 0)
                {
                    <div class="empty-state-desc mb-3">
                        No test cases attached to this request file yet. Create one to extract values from the
                        request/response payload and assert them during execution.
                    </div>
                }
                else
                {
                    @foreach (var tc in _fileTestCases)
                    {
                        <div class="exec-group-file">
                            <div class="d-flex flex-column align-items-start">
                                <span class="fw-semibold fs-13">@tc.Name @(!tc.Enabled ? "(disabled)" : "")</span>
                                <span class="text-sh-faint fs-11">@tc.Extractors.Count extractor(s) · updated @(tc.UpdatedAt ?? tc.CreatedAt)</span>
                            </div>
                            <span class="ms-auto d-flex gap-8px">
                                <button class="ia-btn ia-normal" type="button" aria-label="Edit" @onclick="() => OpenEditTestCase(tc)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="ia-btn @(tc.Enabled ? "ia-enable" : "ia-normal")" type="button" aria-label="Toggle" @onclick="() => ToggleTestCase(tc)">
                                    <i class="bi @(tc.Enabled ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                                <button class="ia-btn ia-danger" type="button" aria-label="Delete" @onclick="() => DeleteTestCaseAsync(tc)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </span>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="OpenCreateTestCase" type="button">
                    <i class="bi bi-plus-lg"></i>
                    Create Test Case
                </button>
                <button class="btn btn-outline-secondary btn-dg" @onclick="CloseTestCasesModal" type="button">Close</button>
            </div>
        </div>
    </div>
}

@if (_showTestCaseModal && _tcFile is not null)
{
    <div class="modal-overlay" @onclick="() => _showTestCaseModal = false">
        <div class="modal-content-dg modal-w-720" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>@(_editingTestCase is null ? "Create" : "Edit") Test Case</h3>
                <span class="mono-text fs-12 text-sh-soft me-auto ms-2">@_tcFile.FileName</span>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showTestCaseModal = false" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                @if (_tcValidationErrors.Count > 0)
                {
                    <div class="alert-validation">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Please fix the following:
                        <ul class="mt-1 mb-0 ps-20">
                            @foreach (var err in _tcValidationErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                <div class="form-group">
                    <label>Test Case Name</label>
                    <input type="text" class="form-control-dg" @bind="_tcName" placeholder="e.g. Validate invoice status" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control-dg" @bind="_tcDescription" rows="2" placeholder="Optional description"></textarea>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" @bind="_tcEnabled" id="tcEnabled" />
                    <label class="form-check-label fs-12" for="tcEnabled">Enabled (run during execution)</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="fs-12 fw-semibold text-sh-soft m-0">Extractors</label>
                    <button class="btn btn-outline-secondary btn-dg btn-sm" @onclick="AddExtractor" type="button">
                        <i class="bi bi-plus-lg"></i>
                        Add Extractor
                    </button>
                </div>
                @if (_tcExtractors.Count == 0)
                {
                    <div class="empty-state-desc">No extractors yet. Add one to pull values from the request/response payload.</div>
                }
                @for (var i = 0; i < _tcExtractors.Count; i++)
                {
                    var idx = i;
                    <div class="tc-extractor-row">
                        <div class="d-flex gap-8px flex-wrap align-items-end">
                            <div class="form-group" style="margin-bottom:0">
                                <label>Name</label>
                                <input type="text" class="form-control-dg" @bind="_tcExtractors[idx].Name" placeholder="e.g. status" />
                            </div>
                            <div class="form-group" style="margin-bottom:0">
                                <label>Source</label>
                                <select class="form-control-dg" @bind="_tcExtractors[idx].Source" @bind:event="oninput">
                                    <option value="response">Response</option>
                                    <option value="request">Request</option>
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom:0">
                                <label>Type</label>
                                <select class="form-control-dg" @bind="_tcExtractors[idx].Type" @bind:event="oninput">
                                    <option value="xpath">XPath (XML)</option>
                                    <option value="jsonpath">JSON Path</option>
                                    <option value="pdf">PDF field</option>
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom:0;flex:1;min-width:180px">
                                <label>Path / Expression</label>
                                <input type="text" class="form-control-dg mono-text" @bind="_tcExtractors[idx].Path" placeholder="//status or $.status or field label" />
                            </div>
                            <div class="form-group" style="margin-bottom:0;flex:1;min-width:140px">
                                <label>Expected (optional)</label>
                                <input type="text" class="form-control-dg" @bind="_tcExtractors[idx].ExpectedValue" placeholder="assert value" />
                            </div>
                            <button class="ia-btn ia-danger" type="button" aria-label="Remove extractor" @onclick="() => RemoveExtractor(idx)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="SaveTestCaseAsync" type="button">
                    <i class="bi bi-check-lg"></i>
                    Save Test Case
                </button>
                <button class="btn btn-outline-secondary btn-dg" @onclick="() => _showTestCaseModal = false" type="button">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_showUploadModal)
{
    <div class="modal-overlay" @onclick="() => _showUploadModal = false">
        <div class="modal-content-dg modal-w-560" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>Upload Request Files</h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showUploadModal = false" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                @if (_validationErrors.Count > 0)
                {
                    <div class="alert-validation">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Please fix the following:
                        <ul class="mt-1 mb-0 ps-20">
                            @foreach (var err in _validationErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                <div class="form-group">
                    <label>Application <span class="text-danger">*</span></label>
                    <select class="form-control-dg" @bind="_uploadAppName" @bind:event="oninput">
                        <option value="">Select an application...</option>
                        @foreach (var app in _availableApps)
                        {
                            <option value="@app">@app</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Operation <span class="text-danger">*</span></label>
                    <select class="form-control-dg" @bind="_uploadApiPath" @bind:event="oninput"
                            disabled="@(!_availableOperations.Any())">
                        <option value="">@(_availableOperations.Any() ? "Select an operation..." : "Select an application first")</option>
                        @foreach (var op in _availableOperations)
                        {
                            <option value="@op.Name">@op.Name — @op.Description</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Description <span class="text-sh-faint fw-normal fs-11">(optional)</span></label>
                    <textarea class="form-control-dg textarea" placeholder="Describe the purpose of these request files..."
                              @bind="_uploadDescription" @bind:event="oninput"></textarea>
                </div>

                <div class="border-sh-top my-1 mb-2"></div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fs-11 fw-semibold text-uppercase ls-05 text-sh-soft">
                        <i class="bi bi-files me-1"></i>
                        Files (@_uploadFiles.Count)
                    </span>
                    <div class="d-flex gap-6px">
                        <button class="btn btn-dg fs-11 h-30" @onclick="AddUploadFileEntry" type="button">
                            <i class="bi bi-plus-lg"></i>
                            Add File
                        </button>
                        <label class="btn btn-dg fs-11 cursor-pointer h-30 m-0">
                            <i class="bi bi-folder2-open"></i>
                            Upload from Local
                            <InputFile OnChange="HandleLocalFileUpload" multiple hidden />
                        </label>
                    </div>
                </div>
                @for (var i = 0; i < _uploadFiles.Count; i++)
                {
                    var idx = i;
                    <div class="d-flex gap-8px align-items-start mb-2 p-10 border-sh bg-sh-surface-2">
                        <div class="flex-grow-1 d-flex flex-column gap-6px">
                            <div class="d-flex align-items-center gap-6px">
                                <span class="fs-10 fw-semibold text-sh-faint minw-28">#@(idx + 1)</span>
                                <input type="text" class="form-control-dg flex-grow-1" placeholder="File name (e.g. invoice_create.xml)"
                                       @bind="_uploadFiles[idx].FileName" @bind:event="oninput" />
                            </div>
                            <textarea class="form-control-dg textarea mono-textarea" placeholder="Paste or type XML/SOAP envelope content..."
                                      @bind="_uploadFiles[idx].Content" @bind:event="oninput">@_uploadFiles[idx].Content</textarea>
                            @if (!string.IsNullOrEmpty(_uploadFiles[idx].FileName))
                            {
                                <div class="d-flex gap-6px align-items-center flex-wrap">
                                    <span class="verb-badge verb-badge-accent fs-10">
                                        @System.IO.Path.GetExtension(_uploadFiles[idx].FileName)?.TrimStart('.')?.ToUpper() ?? "XML"
                                    </span>
                                    <span class="file-chars-info">
                                        <i class="bi bi-file-text"></i>
                                        @(_uploadFiles[idx].Content?.Length ?? 0) chars
                                    </span>
                                </div>
                            }
                        </div>
                        <button class="btn btn-dg btn-sh-ghost btn-remove-file"
                                @onclick="() => RemoveUploadFileEntry(idx)" type="button" aria-label="Remove file" title="Remove file">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                @if (_uploadFiles.Count == 0)
                {
                    <div class="upload-empty-state">
                        <i class="bi bi-upload fs-18 d-block mb-1"></i>
                        No files added yet. Click "Add File" or "Upload from Local" to include request files.
                    </div>
                }
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => _showUploadModal = false" type="button">Cancel</button>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="HandleUploadFiles" type="button">
                    <i class="bi bi-cloud-upload"></i>
                    Upload @(_uploadFiles.Count > 0 ? $"{_uploadFiles.Count} File(s)" : "Files")
                </button>
            </div>
        </div>
    </div>
}

@if (_showEditModal)
{
    <div class="modal-overlay" @onclick="() => _showEditModal = false">
        <div class="modal-content-dg modal-w-560" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>Edit Request File</h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showEditModal = false" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                @if (_editValidationErrors.Count > 0)
                {
                    <div class="alert-validation">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Please fix the following:
                        <ul class="mt-1 mb-0 ps-20">
                            @foreach (var err in _editValidationErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                <div class="form-group">
                    <label>File Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control-dg" placeholder="e.g. invoice_create.xml"
                           @bind="_editFileName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Application <span class="text-danger">*</span></label>
                    <select class="form-control-dg" @bind="_editAppName" @bind:event="oninput">
                        @foreach (var app in _availableApps)
                        {
                            <option value="@app">@app</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Operation <span class="text-danger">*</span></label>
                    <select class="form-control-dg" @bind="_editApiPath" @bind:event="oninput"
                            disabled="@(!EditAvailableOperations.Any())">
                        <option value="">@(EditAvailableOperations.Any() ? "Select an operation..." : "Select an application first")</option>
                        @foreach (var op in EditOperationOptions)
                        {
                            <option value="@op.Name">@op.Name — @op.Description</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Description <span class="text-sh-faint fw-normal fs-11">(optional)</span></label>
                    <textarea class="form-control-dg textarea" placeholder="Describe the purpose of this request file..."
                              @bind="_editDescription" @bind:event="oninput"></textarea>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select class="form-control-dg" @bind="_editStatus">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => _showEditModal = false" type="button">Cancel</button>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => SaveEditDialogAsync()" type="button">
                    <i class="bi bi-check-lg"></i>
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

@* ── Transient feedback toast ── *@
@if (_toastMessage is not null)
{
    <div class="sh-toast @(_toastType == "danger" ? "sh-toast-danger" : "sh-toast-success")"
         @onclick="DismissToast"
         role="status"
         aria-live="polite">
        <i class="bi @(_toastType == "danger" ? "bi-exclamation-circle" : "bi-check-circle")"></i>
        <span>@_toastMessage</span>
    </div>
}

