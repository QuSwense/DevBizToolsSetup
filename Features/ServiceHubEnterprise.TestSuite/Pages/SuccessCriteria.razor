@page "/test/criteria"

<div class="datagrid-card empty-state-card">
    <i class="bi bi-check2-square empty-state-icon"></i>
    <h3 class="empty-state-title">Success Criteria</h3>
    <p class="empty-state-desc">
        Define pass/fail conditions for your test cases. Set expected HTTP status codes, response body validation rules,
        headers, and response time thresholds.
    </p>
    <div class="empty-state-actions">
        <button class="btn btn-dark btn-sh-primary">
            <i class="bi bi-plus-lg"></i>
            Add Criterion
        </button>
    </div>
</div>
