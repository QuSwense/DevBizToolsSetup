@namespace OrbitHub.SoapApplications.Components

@if (File is not null)
{
    <div class="datagrid-card" style="margin-top:12px">
        <div class="d-flex align-items-center justify-content-between" style="padding:16px 20px;border-bottom:1px solid var(--sh-border)">
            <div>
                <div class="d-flex align-items-center gap-8px">
                    <span class="mono-text fw-semibold">@File.FileName</span>
                    <span class="status-badge @(StatusBadge(File.Status).Css)">@(StatusBadge(File.Status).Label)</span>
                </div>
                <div class="fs-12 text-sh-soft mt-1">
                    @File.AppName · @File.Operation · @FormatDuration(File.DurationMs)
                </div>
            </div>
            @if (Group is not null)
            {
                <span class="mono-text fs-12 text-sh-faint">@Group.Id</span>
            }
        </div>

        <div class="exec-tabs">
            @{
                var tabs = new (string Key, string Label)[]
                {
                    ("request", "Request"),
                    ("response", "Response"),
                    ("parsed", "Parsed Fields"),
                    ("extractions", "Test Extractions"),
                    ("logs", "Logs")
                };
            }
            @foreach (var tab in tabs)
            {
                <button type="button" class="exec-tab @(_activeTab == tab.Key ? "is-active" : "")"
                        @onclick="() => SetActiveTab(tab.Key)">
                    @tab.Label
                </button>
            }
        </div>

        <div style="padding:16px 20px">
            @if (_activeTab == "request")
            {
                @if (string.IsNullOrWhiteSpace(File.RequestContent))
                {
                    <div class="empty-state-desc">No request content captured for this file.</div>
                }
                else
                {
                    <pre class="exec-viewer">@File.RequestContent</pre>
                }
            }
            else if (_activeTab == "response")
            {
                @if (string.IsNullOrWhiteSpace(File.ResponseContent))
                {
                    <div class="empty-state-desc">No response content captured for this file.</div>
                }
                else
                {
                    <div class="mb-2">
                        <span class="verb-badge fs-10">@File.ResponseMimeType</span>
                    </div>
                    <pre class="exec-viewer">@File.ResponseContent</pre>
                }
            }
            else if (_activeTab == "parsed")
            {
                @if (File.ParsedFields.Count == 0)
                {
                    <div class="empty-state-desc">No fields were parsed from the payloads.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-dg align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Source</th>
                                    <th>Path</th>
                                    <th>Value</th>
                                    <th>Embedded</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var field in File.ParsedFields)
                                {
                                    <tr>
                                        <td class="fw-semibold">@field.Name</td>
                                        <td><span class="verb-badge fs-10">@field.Source</span></td>
                                        <td class="mono-text fs-11 text-sh-soft">@field.Path</td>
                                        <td class="mono-text">@field.Value</td>
                                        <td>
                                            @if (field.IsEmbedded)
                                            {
                                                <span class="text-sh-warn" data-tooltip="@field.DecodedPreview">
                                                    <i class="bi bi-file-earmark-binary me-1"></i>base64
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-sh-faint">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (_activeTab == "extractions")
            {
                @if (File.Extractions.Count == 0)
                {
                    <div class="empty-state-desc">
                        No test-case extractions ran for this file. Attach a test case from the Request Files page.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-dg align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Extraction</th>
                                    <th>Source</th>
                                    <th>Type</th>
                                    <th>Path</th>
                                    <th>Value</th>
                                    <th>Expected</th>
                                    <th>Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ex in File.Extractions)
                                {
                                    <tr>
                                        <td class="fw-semibold">@ex.Name</td>
                                        <td><span class="verb-badge fs-10">@ex.Source</span></td>
                                        <td class="fs-11 text-sh-soft">@ex.Type</td>
                                        <td class="mono-text fs-11 text-sh-soft">@ex.Path</td>
                                        <td class="mono-text">@ex.Value</td>
                                        <td class="mono-text text-sh-soft">@(ex.Expected ?? "—")</td>
                                        <td>
                                            @if (ex.HasExpected)
                                            {
                                                <span class="status-badge @(ex.Passed ? "status-enabled" : "status-down")">
                                                    @(ex.Passed ? "Pass" : "Fail")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-sh-faint fs-11">informational</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (File.Logs.Count == 0)
                {
                    <div class="empty-state-desc">No logs recorded for this file.</div>
                }
                else
                {
                    <div class="exec-log-list">
                        @foreach (var log in File.Logs)
                        {
                            <div class="exec-log-row">
                                <span class="mono-text fs-11 text-sh-faint">@log.Timestamp</span>
                                <span class="exec-log-type @LogTypeBadge(log.Type)">@log.Type</span>
                                <span class="fs-12">@log.Message</span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}
