@namespace OrbitHub.SoapApplications.Components

<SectionCard Title="Templates" Icon="📝" Information="Request file templates (extends-chain)"
             Collapsible="true" Collapsed="@Collapsed" OnToggle="OnToggle">
    <Summary>
        <div class="summary-chip">
            <span class="summary-chip-icon">📝</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Templates</span>
                <span class="summary-chip-value">@Templates.Count</span>
                <span class="summary-chip-sub">total</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">🔗</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Extending</span>
                <span class="summary-chip-value">@ExtendingCount</span>
                <span class="summary-chip-sub">inherit a parent</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">🏷️</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Variables</span>
                <span class="summary-chip-value">@TotalVariables</span>
                <span class="summary-chip-sub">across templates</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">🔁</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Usage</span>
                <span class="summary-chip-value">@TotalUsage</span>
                <span class="summary-chip-sub">total uses</span>
            </div>
        </div>
        <div class="summary-chip summary-chip-donut">
            <MiniDonut Value="@ExtendingCount" Total="@Templates.Count" Label="extending" ValueColor="var(--sh-accent)" Size="56" />
            <div class="summary-chip-main">
                <span class="summary-chip-label">Extending share</span>
                <span class="summary-chip-value">@(Templates.Count > 0 ? ExtendingCount * 100 / Templates.Count : 0)%</span>
            </div>
        </div>
    </Summary>
    <ChildContent>
    <div class="kpi-grid">
        <KpiTile Label="Templates" Value="@Templates.Count.ToString()" Sub="total" Icon="📝" />
        <KpiTile Label="Extending" Value="@ExtendingCount.ToString()" Sub="inherit a parent" Color="var(--sh-accent)" Icon="🔗" />
        <KpiTile Label="Variables" Value="@TotalVariables.ToString()" Sub="across templates" Icon="🏷️" />
        <KpiTile Label="Usage" Value="@TotalUsage.ToString()" Sub="total uses" Icon="🔁" />
        <div class="kpi-tile kpi-donut-tile">
            <div class="kpi-header"><span class="kpi-title">Extending Share</span></div>
            <div class="kpi-donut">
                <MiniDonut Value="@ExtendingCount" Total="@Templates.Count" Label="extending" ValueColor="var(--sh-accent)" />
            </div>
        </div>
    </div>
    </ChildContent>
</SectionCard>
