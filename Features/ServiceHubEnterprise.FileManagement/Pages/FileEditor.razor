@page "/file/editor"
@inject NavigationManager _nav
@inject IConfiguration _config
@inject SoapAppStore _appStore
@inject SoapDbContext _soapDb
@inject RestDbContext _restDb
@inject FileManagementDbContext _fmDb

@* ── Loading Skeleton ── *@
@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:300px">
        <div class="spinner-border text-sh-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_isEmpty)
{
    <div class="datagrid-card empty-state-card">
        <i class="bi bi-file-earmark-text" style="font-size:36px;color:var(--sh-text-faint)"></i>
        <h4 class="empty-state-title">No file selected</h4>
        <p class="empty-state-desc">
            Specify a file to edit using the <code>?app=</code> and <code>?file=</code> query parameters.
            Browse the File Library to find and open a file.
        </p>
        <div class="empty-state-actions">
            <a href="/file/library" class="btn btn-outline-secondary btn-dg text-decoration-none">
                <i class="bi bi-file-earmark"></i>
                Browse File Library
            </a>
        </div>
    </div>
}
else if (_hasError)
{
    <div class="datagrid-card error-state-card">
        <i class="bi bi-exclamation-triangle fs-28 text-danger"></i>
        <p class="error-state-text">@_errorMessage</p>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="InitializeAsync" type="button">
            <i class="bi bi-arrow-repeat"></i>
            Retry
        </button>
        <button class="btn btn-outline-secondary btn-dg ms-2" @onclick="DismissError" type="button">Dismiss</button>
    </div>
}
else
{
    <div class="editor-page">
        @* ── Tabs ── *@
        <div class="tabs-header">
            <button class="tab-btn@(_activeTab == 0 ? " is-active" : "")"
                    @onclick="() => SetActiveTab(0)" type="button" role="tab" aria-selected="@(_activeTab == 0)">
                <i class="bi bi-info-circle"></i>
                Properties
            </button>
            <button class="tab-btn@(_activeTab == 1 ? " is-active" : "")"
                    @onclick="() => SetActiveTab(1)" type="button" role="tab" aria-selected="@(_activeTab == 1)">
                <i class="bi bi-code-slash"></i>
                Content
            </button>
        </div>

        <div class="tab-content">
            @* ── TAB 0: Properties (editable) ── *@
            @if (_activeTab == 0)
            {
                <div class="tab-panel properties-tab" role="tabpanel">
                    <div class="editor-properties-panel">
                        <div class="properties-grid">
                            <div class="form-group">
                                <label>File Name</label>
                                <input type="text" class="form-control-dg" @bind="_editFileName" @bind:event="oninput" />
                            </div>

                            @if (_isSoapFile || _isRestFile)
                            {
                                <div class="form-group">
                                    <label>Application</label>
                                    <input type="text" class="form-control-dg" value="@_appName" disabled readonly />
                                </div>
                                <div class="form-group">
                                    <label>Operation</label>
                                    <input type="text" class="form-control-dg" value="@_operation" disabled readonly />
                                </div>
                                <div class="form-group">
                                    <label>Verb</label>
                                    <input type="text" class="form-control-dg" value="@_verb" disabled readonly />
                                </div>
                            }

                            <div class="form-group full-width">
                                <label>Description</label>
                                <textarea class="form-control-dg textarea" rows="3" @bind="_editDescription" @bind:event="oninput"></textarea>
                            </div>

                            @if (_isSoapFile || _isRestFile)
                            {
                                <div class="form-group">
                                    <label>Status</label>
                                    <select class="form-control-dg" @bind="_editStatus">
                                        <option value="active">Active</option>
                                        <option value="inactive">Inactive</option>
                                    </select>
                                </div>
                            }

                            <div class="form-group audit-section">
                                <div class="audit-header">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    <div class="properties-section-title">Audit Trail</div>
                                </div>
                                <div class="audit-grid">
                                    <div class="audit-item audit-item-created">
                                        <span class="audit-label">Created</span>
                                        <span class="audit-user">@(string.IsNullOrWhiteSpace(_createdBy) ? "Unknown user" : _createdBy)</span>
                                        <span class="audit-time">
                                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                                            @(string.IsNullOrWhiteSpace(_createdAt) ? "Date unavailable" : _createdAt)
                                        </span>
                                    </div>
                                    <div class="audit-item audit-item-updated">
                                        <span class="audit-label">Last Updated</span>
                                        <span class="audit-user">@(string.IsNullOrWhiteSpace(_lastUpdatedBy) ? "Not updated yet" : _lastUpdatedBy)</span>
                                        <span class="audit-time">
                                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                                            @(string.IsNullOrWhiteSpace(_lastUpdatedAt) ? "Date unavailable" : _lastUpdatedAt)
                                        </span>
                                    </div>
                                    @if (_versionNumber > 0)
                                    {
                                        <div class="audit-item audit-item-version">
                                            <span class="audit-label">Version</span>
                                            <span class="audit-version-pill mono-text">v@(_versionNumber)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ── TAB 1: Content (Monaco editor) ── *@
            @if (_activeTab == 1)
            {
                <div class="tab-panel content-tab" role="tabpanel">
                    <div class="editor-main" style="height: calc(100vh - 220px);">
                        <MonacoEditor @ref="_monacoEditorRef"
                                      FileName="@_fileName"
                                      Content="@_fileContent"
                                      ContentChanged="@OnEditorContentChanged"
                                      Language="@_language"
                                      HasUnsavedChanges="@_hasUnsavedChanges"
                                      IsSaving="@_isSaving"
                                      ShowBackButton="false"
                                      ShowFileName="true"
                                      ShowFontSelector="true"
                                      ShowWordWrapToggle="true"
                                      ShowLineNumbersToggle="true"
                                      ShowThemeSelector="true"
                                      ShowSearchBox="true"
                                      ShowCursorPosition="true"
                                      ShowGoToLine="true"
                                      ShowSaveButton="true"
                                      ShowFormatButton="true"
                                      ShowValidateButton="true"
                                      ShowDownloadButton="true"
                                      ShowCompareButton="@_hasPreviousVersion"
                                      ShowUndoRedo="true"
                                      ShowActionMenu="true"
                                      ShowFooter="true"
                                      ShowFooterLeftStats="true"
                                      ShowFooterCenterStats="true"
                                      ShowFooterRightStats="true"
                                      OnBackClick="@GoBack"
                                      OnSaveClick="@SaveAsync"
                                      OnFormatClick="@FormatDocumentAsync"
                                      OnValidateClick="@ValidateDocumentAsync"
                                      OnDownloadClick="@DownloadFileAsync"
                                      OnCompareClick="@OpenComparer"
                                      OnUndo="@HandleUndoAsync"
                                      OnRedo="@HandleRedoAsync"
                                      OnFontFamilyChanged="@HandleFontFamilyChangedAsync"
                                      OnFontSizeChanged="@HandleFontSizeChangedAsync"
                                      OnThemeChanged="@HandleThemeChangedAsync"
                                      OnWordWrapToggled="@HandleWordWrapToggledAsync"
                                      OnLineNumbersToggled="@HandleLineNumbersToggledAsync"
                                      OnMinimapToggled="@HandleMinimapToggledAsync"
                                      OnSearch="@HandleSearchAsync"
                                      OnGoToLine="@HandleGoToLineAsync"
                                      OnActionMenuItem="@HandleActionMenuItemAsync" />
                    </div>
                </div>
            }
        </div>
    </div>
}