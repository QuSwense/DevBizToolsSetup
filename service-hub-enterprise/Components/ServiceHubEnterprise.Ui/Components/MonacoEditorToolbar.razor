@namespace ServiceHubEnterprise.Ui.Components

<div class="monaco-editor-toolbar">
    @* ── Left Group: Navigation & File Info ── *@
    <div class="toolbar-left">
        @if (ShowBackButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnBackClick.InvokeAsync()" title="Go back" aria-label="Back">
                <i class="bi bi-arrow-left"></i>
            </button>
        }
        @if (ShowFileName)
        {
            <div class="toolbar-file-name" title="@FilePath ?? FileName">
                <span class="mono-text">@FileName</span>
                @if (!string.IsNullOrEmpty(LanguageBadgeText))
                {
                    <span class="file-type-badge @GetBadgeClass()">@LanguageBadgeText</span>
                }
                @if (HasUnsavedChanges)
                {
                    <span class="unsaved-badge">Unsaved</span>
                }
            </div>
        }
    </div>

    @* ── Center Group: Editor Settings & Search ── *@
    <div class="toolbar-center">
        @if (ShowFontSelector)
        {
            <select class="toolbar-select" @bind="FontFamily" @bind:after="() => OnFontFamilyChanged.InvokeAsync(FontFamily)" title="Font family">
                @foreach (var f in AvailableFontFamilies)
                {
                    <option value="@f">@f</option>
                }
            </select>
            <select class="toolbar-select toolbar-select-sm" @bind="FontSize" @bind:after="() => OnFontSizeChanged.InvokeAsync(FontSize)" title="Font size">
                @foreach (var s in AvailableFontSizes)
                {
                    <option value="@s">@s</option>
                }
            </select>
        }
        @if (ShowWordWrapToggle)
        {
            <button type="button" class="toolbar-btn @(WordWrapEnabled ? "is-active" : "")" @onclick="() => OnWordWrapToggled.InvokeAsync(!WordWrapEnabled)" title="Toggle word wrap">
                <i class="bi bi-text-wrap"></i>
            </button>
        }
        @if (ShowLineNumbersToggle)
        {
            <button type="button" class="toolbar-btn @(LineNumbersEnabled ? "is-active" : "")" @onclick="() => OnLineNumbersToggled.InvokeAsync(!LineNumbersEnabled)" title="Toggle line numbers">
                <i class="bi bi-list-ol"></i>
            </button>
        }
        @if (ShowCursorPosition)
        {
            <span class="toolbar-stat" title="Cursor position">Ln @CursorLine, Col @CursorColumn</span>
        }
        @if (ShowGoToLine)
        {
            <input type="number" class="toolbar-input toolbar-input-sm" placeholder="Go to line"
                   @bind="_goToLineValue"
                   @onkeydown="HandleGoToLineKeydown" title="Go to line number" />
        }
        @if (ShowSearchBox)
        {
            <div class="toolbar-search">
                <i class="bi bi-search toolbar-search-icon"></i>
                <input type="text" class="toolbar-input toolbar-search-input" placeholder="Search"
                       @bind="_searchValue"
                       @onkeydown="HandleSearchKeydown" title="Search in file" />
            </div>
        }
    </div>

    @* ── Right Group: Actions & Status ── *@
    <div class="toolbar-right">
        @if (ShowUndoRedo)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnUndo.InvokeAsync()" title="Undo (Ctrl+Z)">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
            <button type="button" class="toolbar-btn" @onclick="() => OnRedo.InvokeAsync()" title="Redo (Ctrl+Y)">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        }
        @if (ShowFormatButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnFormatClick.InvokeAsync()" title="Format document">
                <i class="bi bi-file-indent"></i>
            </button>
        }
        @if (ShowValidateButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnValidateClick.InvokeAsync()" title="Validate XML/JSON">
                <i class="bi bi-check-circle"></i>
            </button>
        }
        @if (ShowCompareButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnCompareClick.InvokeAsync()" title="Compare with saved version">
                <i class="bi bi-file-diff"></i>
            </button>
        }
        @if (ShowDownloadButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnDownloadClick.InvokeAsync()" title="Download file">
                <i class="bi bi-download"></i>
            </button>
        }
        @if (ShowThemeSelector)
        {
            <select class="toolbar-select toolbar-select-sm" @bind="Theme" @bind:after="() => OnThemeChanged.InvokeAsync(Theme)" title="Editor theme">
                @foreach (var t in AvailableThemes)
                {
                    <option value="@t">@t</option>
                }
            </select>
        }
        @if (ShowSaveButton)
        {
            <button type="button" class="toolbar-btn toolbar-btn-primary" @onclick="() => OnSaveClick.InvokeAsync()" disabled="@IsSaving" title="Save (Ctrl+S)">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="width:12px;height:12px"></span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i>
                }
            </button>
        }
        @if (ShowActionMenu)
        {
            <div class="toolbar-action-menu" @onclick="ToggleActionMenu" @onfocusout="HandleActionMenuFocusOut" tabindex="0" @ref="_actionMenuRef">
                <button type="button" class="toolbar-btn" title="More actions">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                @if (_showActionMenuDropdown)
                {
                    <div class="action-menu-dropdown">
                        @foreach (var group in ActionMenuGroups)
                        {
                            <div class="action-menu-group">
                                <div class="action-menu-group-title">@group.Title</div>
                                @foreach (var item in group.Items)
                                {
                                    @if (item.IsSeparator)
                                    {
                                        <div class="action-menu-separator"></div>
                                    }
                                    else
                                    {
                                        <button type="button" class="action-menu-item" disabled="@(!item.Enabled)"
                                                @onclick="() => HandleActionMenuItem(item.Id)" title="@item.Label">
                                            @if (!string.IsNullOrEmpty(item.Icon))
                                            {
                                                <i class="@item.Icon"></i>
                                            }
                                            <span class="action-menu-label">@item.Label</span>
                                            @if (!string.IsNullOrEmpty(item.Shortcut))
                                            {
                                                <span class="action-menu-shortcut">@item.Shortcut</span>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>