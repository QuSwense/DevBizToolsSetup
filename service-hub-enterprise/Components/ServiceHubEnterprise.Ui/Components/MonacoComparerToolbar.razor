@namespace ServiceHubEnterprise.Ui.Components

<div class="monaco-diff-controls">
    <div class="controls-left">
        @if (ShowUnchangedLinesToggle)
        {
            <button type="button" class="toolbar-btn @(ShowUnchangedLines ? "is-active" : "")"
                    @onclick="() => OnShowUnchangedLinesChanged.InvokeAsync(!ShowUnchangedLines)"
                    title="Show/hide unchanged lines">
                <i class="bi bi-eye"></i>
            </button>
        }
        @if (ShowWhitespaceToggles)
        {
            <button type="button" class="toolbar-btn @(!IgnoreWhitespace ? "is-active" : "")"
                    @onclick="() => OnIgnoreWhitespaceChanged.InvokeAsync(!IgnoreWhitespace)"
                    title="Ignore whitespace changes">
                <i class="bi bi-text-paragraph"></i>
            </button>
        }
        @if (ShowCaseToggle)
        {
            <button type="button" class="toolbar-btn @(!IgnoreCase ? "is-active" : "")"
                    @onclick="() => OnIgnoreCaseChanged.InvokeAsync(!IgnoreCase)"
                    title="Ignore case">
                <i class="bi bi-font-case"></i>
            </button>
        }
    </div>
    <div class="controls-center">
        @if (ShowNavigation)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnPreviousDiff.InvokeAsync()" title="Previous difference">
                <i class="bi bi-chevron-up"></i>
            </button>
            @if (ShowDiffCounter)
            {
                <span class="toolbar-stat">@CurrentDifference / @TotalDifferences</span>
            }
            <button type="button" class="toolbar-btn" @onclick="() => OnNextDiff.InvokeAsync()" title="Next difference">
                <i class="bi bi-chevron-down"></i>
            </button>
        }
        @if (ShowScrollSync)
        {
            <button type="button" class="toolbar-btn @(ScrollSync ? "is-active" : "")"
                    @onclick="() => OnScrollSyncChanged.InvokeAsync(!ScrollSync)"
                    title="Synchronize scroll">
                <i class="bi bi-link-45deg"></i>
            </button>
        }
    </div>
    <div class="controls-right">
        @if (ShowViewModeToggle)
        {
            <button type="button" class="toolbar-btn @(ViewMode == DiffViewMode.SideBySide ? "is-active" : "")"
                    @onclick="() => OnViewModeChanged.InvokeAsync(DiffViewMode.SideBySide)"
                    title="Side by side view">
                <i class="bi bi-layout-split"></i>
            </button>
            <button type="button" class="toolbar-btn @(ViewMode == DiffViewMode.Inline ? "is-active" : "")"
                    @onclick="() => OnViewModeChanged.InvokeAsync(DiffViewMode.Inline)"
                    title="Inline view">
                <i class="bi bi-layout-text-window"></i>
            </button>
        }
        @if (ShowSwapButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnSwap.InvokeAsync()" title="Swap versions">
                <i class="bi bi-arrow-left-right"></i>
            </button>
        }
        @if (ShowRefreshButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnRefresh.InvokeAsync()" title="Refresh comparison">
                <i class="bi bi-arrow-repeat"></i>
            </button>
        }
        @if (ShowExportButton)
        {
            <button type="button" class="toolbar-btn" @onclick="() => OnExportReport.InvokeAsync()" title="Export report">
                <i class="bi bi-download"></i>
            </button>
        }
    </div>
</div>