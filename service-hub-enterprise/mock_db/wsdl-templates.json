[
  {
    "id": "tpl-1",
    "name": "Standard SOAP Envelope",
    "description": "Basic SOAP envelope with header and body",
    "content": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Header>\n    <Authentication>\n      <Username>{{username}}</Username>\n      <Password>{{password}}</Password>\n    </Authentication>\n  </soap:Header>\n  <soap:Body>\n    <{{operation}} xmlns=\"{{namespace}}\">\n      <Request>\n        <Id>{{request_id}}</Id>\n      </Request>\n    </{{operation}}>\n  </soap:Body>\n</soap:Envelope>",
    "extendsTemplateId": null,
    "extendsTemplateName": null,
    "variables": ["username", "password", "operation", "namespace", "request_id"],
    "createdBy": "System",
    "createdAt": "2026-01-15",
    "updatedAt": "2026-01-15",
    "usageCount": 24
  },
  {
    "id": "tpl-2",
    "name": "Billing Invoice Request",
    "description": "Extends Standard SOAP Envelope for billing invoice operations",
    "content": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Header>\n    <Authentication>\n      <Username>{{username}}</Username>\n      <Password>{{password}}</Password>\n    </Authentication>\n  </soap:Header>\n  <soap:Body>\n    <{{operation}} xmlns=\"http://billing.example.com/\">\n      <InvoiceRequest>\n        <InvoiceId>{{invoice_id}}</InvoiceId>\n        <CustomerId>{{customer_id}}</CustomerId>\n        <Amount>{{amount}}</Amount>\n        <Currency>{{currency}}</Currency>\n      </InvoiceRequest>\n    </{{operation}}>\n  </soap:Body>\n</soap:Envelope>",
    "extendsTemplateId": "tpl-1",
    "extendsTemplateName": "Standard SOAP Envelope",
    "variables": ["username", "password", "operation", "invoice_id", "customer_id", "amount", "currency"],
    "createdBy": "Suresh Kumar",
    "createdAt": "2026-02-10",
    "updatedAt": "2026-07-05",
    "usageCount": 15
  },
  {
    "id": "tpl-3",
    "name": "Order Processing Template",
    "description": "Extends Standard SOAP Envelope for order management",
    "content": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Header>\n    <Authentication>\n      <Username>{{username}}</Username>\n      <Password>{{password}}</Password>\n    </Authentication>\n  </soap:Header>\n  <soap:Body>\n    <{{operation}} xmlns=\"http://orders.example.com/\">\n      <OrderRequest>\n        <OrderId>{{order_id}}</OrderId>\n        <CustomerId>{{customer_id}}</CustomerId>\n        <ItemCode>{{item_code}}</ItemCode>\n        <Quantity>{{quantity}}</Quantity>\n      </OrderRequest>\n    </{{operation}}>\n  </soap:Body>\n</soap:Envelope>",
    "extendsTemplateId": "tpl-1",
    "extendsTemplateName": "Standard SOAP Envelope",
    "variables": ["username", "password", "operation", "order_id", "customer_id", "item_code", "quantity"],
    "createdBy": "Rahul Patel",
    "createdAt": "2026-03-10",
    "updatedAt": "2026-07-01",
    "usageCount": 9
  }
]
