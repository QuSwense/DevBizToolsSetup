@page "/soap/applications"
@inject SoapAppStore _appStore

<ServiceHubGrid TItem="SoapApp"
                Id="soapAppsGrid"
                Items="FilteredApps"
                PageSize="5"
                EnableSelection="true"
                EnablePagination="true"
                EnableSearch="true"
                EnableExpand="true"
                EnableContextMenu="true"
                SearchPlaceholder="Search applications..."
                EmptyText="No applications found matching the current filters."
                FilterModalTitle="Filter Applications"
                @bind-SortColumn="_sortColumn"
                @bind-SortAscending="_sortAscending"
                @bind-CurrentPage="_currentPage"
                @bind-SearchText="_searchText"
                @bind-ShowFilterModal="_showFilterModal"
                FilterApplied="OnFilterApplied"
                RowIdSelector="@(app => app.Id)"
                Columns="@_columns">

    <ToolbarCenter>
        <button class="filter-btn" @onclick="() => _showFilterModal = true" type="button">
            <i class="bi bi-funnel"></i>
            Filter
        </button>
    </ToolbarCenter>

    <ToolbarRight>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => _showAddModal = true" type="button">
            <i class="bi bi-plus-lg"></i>
            Add Application
        </button>
        <div class="position-relative">
            <button class="btn btn-outline-secondary btn-dg" @onclick="() => _showDropdown = !_showDropdown" type="button">
                <i class="bi bi-three-dots-vertical"></i>
                Actions
                <i class="bi bi-chevron-down"></i>
            </button>
            @if (_showDropdown)
            {
                <div class="position-fixed" style="inset:0;z-index:50" @onclick="() => _showDropdown = false"></div>
                <div class="dropdown-menu-dg">
                    <div style="padding:4px 0">
                        <div class="dropdown-header-dg">Export</div>
                        <button class="btn dropdown-item-dg" @onclick="() => _showDropdown = false" type="button">
                            <i class="bi bi-download"></i>
                            Export to CSV
                        </button>
                        <button class="btn dropdown-item-dg" @onclick="() => _showDropdown = false" type="button">
                            <i class="bi bi-download"></i>
                            Export to JSON
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <button class="btn dropdown-item-dg dropdown-item-sh-danger" @onclick="() => _showDropdown = false" type="button">
                            <i class="bi bi-trash3"></i>
                            Delete Selected
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <div class="dropdown-header-dg">View</div>
                        <button class="btn dropdown-item-dg"
                                @onclick="() => { _showDropdown = false; ResetAdvancedFilters(); }"
                                type="button">
                            <i class="bi bi-arrow-repeat"></i>
                            Reset Filter
                        </button>
                        <button class="btn dropdown-item-dg"
                                @onclick="HandleResetSort"
                                type="button">
                            <i class="bi bi-arrow-up-short"></i>
                            Reset Sort
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <button class="btn dropdown-item-dg"
                                @onclick="() => { _showDropdown = false; }"
                                type="button">
                            <i class="bi bi-arrows-expand"></i>
                            Expand Selected
                        </button>
                        <button class="btn dropdown-item-dg"
                                @onclick="() => { _showDropdown = false; }"
                                type="button">
                            <i class="bi bi-arrows-collapse"></i>
                            Collapse Selected
                        </button>
                    </div>
                </div>
            }
        </div>
    </ToolbarRight>

    <RowActions Context="app">
        <div class="row-actions-wrap blazor-managed@(_expandedActionRows.Contains(app.Id) ? " is-open" : "")">
            <button class="action-trigger" type="button" aria-label="More actions" data-tooltip="More actions"
                    @onclick="() => _expandedActionRows.Add(app.Id)">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
            </button>
            <div class="inline-actions">
                <button class="ia-btn ia-edit" type="button" aria-label="Edit" data-tooltip="Edit"
                        @onclick="() => OpenEditDialog(app)">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-danger" type="button" aria-label="Delete" data-tooltip="Delete">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-close" type="button" aria-label="Close" data-tooltip="Close"
                        @onclick="() => _expandedActionRows.Remove(app.Id)">
                    <i class="bi bi-x-lg" style="font-size: 11px" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </RowActions>

    <DetailRow Context="app">
        <div class="detail-grid">
            <div>
                <div class="detail-label">Application ID</div>
                <div class="detail-value">@app.Id</div>
            </div>
            <div>
                <div class="detail-label">Full URL</div>
                <div class="detail-value" style="word-break:break-all">@app.BaseUrl</div>
            </div>
            <div style="grid-column:1/-1">
                <div class="detail-label">Description</div>
                <div class="detail-value">@(string.IsNullOrEmpty(app.Description) ? "—" : app.Description)</div>
            </div>
            <div>
                <div class="detail-label">Status</div>
                <div class="detail-value">
                    <span class="status-badge @(app.Status == "enabled" ? "status-enabled" : "status-disabled")">
                        @(app.Status == "enabled" ? "Enabled" : "Disabled")
                    </span>
                </div>
            </div>
            <div>
                <div class="detail-label">Last Modified</div>
                <div class="detail-value">@app.CreatedDate by @app.UpdatedBy</div>
            </div>

            <div style="grid-column:1/-1;border-top:1px solid var(--sh-border);padding-top:8px;margin-top:4px">
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--sh-text-faint);margin-bottom:8px">
                    <i class="bi bi-shield-lock" style="margin-right:4px"></i>Authentication
                </div>
            </div>
            <div>
                <div class="detail-label">Auth Type</div>
                <div class="detail-value">
                    <span style="display:inline-flex;align-items:center;height:20px;padding:0 7px;font-size:10px;font-weight:600;background:var(--sh-accent-soft);color:var(--sh-accent);border:1px solid var(--sh-border)">
                        @(app.AuthType switch
                        {
                            "none" => "None",
                            "basic" => "Basic",
                            "api-key" => "API Key",
                            "bearer" => "Bearer",
                            "ntlm" => "NTLM",
                            _ => app.AuthType
                        })
                    </span>
                </div>
            </div>
            <div>
                <div class="detail-label">Credentials</div>
                <div class="detail-value">
                    @(app.AuthType switch
                    {
                        "none" => "—",
                        "api-key" => app.AuthUsername,
                        "bearer" => "Token configured",
                        _ => string.IsNullOrEmpty(app.AuthUsername) ? "—" : app.AuthUsername
                    })
                    @if (app.AuthType == "ntlm" && !string.IsNullOrEmpty(app.AuthExtra))
                    {
                        <span style="color:var(--sh-text-faint)">(@app.AuthExtra)</span>
                    }
                </div>
            </div>

            <div style="grid-column:1/-1;border-top:1px solid var(--sh-border);padding-top:8px;margin-top:4px">
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--sh-text-faint);margin-bottom:8px">
                    <i class="bi bi-diagram-3" style="margin-right:4px"></i>SOAP APIs (@app.ApisCount)
                </div>
            </div>
            @if (app.Apis.Length > 0)
            {
                <div style="grid-column:1/-1">
                    <div style="display:flex;flex-direction:column;gap:4px">
                        @foreach (var api in app.Apis)
                        {
                            <div style="display:flex;align-items:center;gap:8px;padding:5px 10px;background:var(--sh-surface-2);border:1px solid var(--sh-border)">
                                <span style="font-weight:500;font-size:12px;color:var(--sh-text);white-space:nowrap">@api.Name</span>
                                @if (!string.IsNullOrEmpty(api.Description))
                                {
                                    <span style="color:var(--sh-text-soft);font-size:11px">— @api.Description</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div style="grid-column:1/-1">
                    <div class="detail-value" style="color:var(--sh-text-faint);font-style:italic">No APIs configured</div>
                </div>
            }
        </div>
    </DetailRow>

    <FilterModalBody>
        <div class="form-group">
            <label>App Name</label>
            <input type="text" class="form-control-dg" placeholder="Filter by name..."
                   @bind="_filterName" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Base URL</label>
            <input type="text" class="form-control-dg" placeholder="Filter by URL..."
                   @bind="_filterUrl" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Status</label>
            <select class="form-control-dg" @bind="_filterStatus">
                <option value="">All</option>
                <option value="enabled">Enabled</option>
                <option value="disabled">Disabled</option>
            </select>
        </div>
        <div class="form-group">
            <label>Last Updated By</label>
            <input type="text" class="form-control-dg" placeholder="Filter by user..."
                   @bind="_filterUpdatedBy" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Created Date</label>
            <input type="text" class="form-control-dg" placeholder="Filter by date..."
                   @bind="_filterCreatedDate" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Operations</label>
            <input type="text" class="form-control-dg" placeholder="Filter by operations count..."
                   @bind="_filterOperations" @bind:event="oninput" />
        </div>
    </FilterModalBody>
</ServiceHubGrid>

@if (_showAddModal)
{
    <div class="modal-overlay" @onclick="() => _showAddModal = false">
        <div class="modal-content-dg" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>@(_editingApp is null ? "Add" : "Edit") SOAP Application</h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showAddModal = false" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                <div class="form-group">
                    <label>App Name</label>
                    <input type="text" class="form-control-dg" placeholder="Enter application name..."
                           @bind="_newAppName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Base URL</label>
                    <input type="text" class="form-control-dg" placeholder="https://soap.example.com/Service"
                           @bind="_newAppUrl" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control-dg textarea" placeholder="Describe the SOAP application..."
                              @bind="_newAppDescription" @bind:event="oninput"></textarea>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select class="form-control-dg" @bind="_newAppStatus">
                        <option value="enabled">Enabled</option>
                        <option value="disabled">Disabled</option>
                    </select>
                </div>

                <div style="border-top:1px solid var(--sh-border);margin:4px 0 8px"></div>
                <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--sh-text-soft);margin-bottom:8px">
                    Authentication Details
                </div>
                <div class="form-group">
                    <label>Auth Type</label>
                    <select class="form-control-dg" @bind="_newAuthType">
                        <option value="none">No Authentication</option>
                        <option value="basic">Basic Auth</option>
                        <option value="api-key">API Key</option>
                        <option value="bearer">Bearer Token</option>
                        <option value="ntlm">NTLM</option>
                    </select>
                </div>

                @if (_newAuthType == "basic")
                {
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" class="form-control-dg" placeholder="Authentication username..."
                               @bind="_newAuthUsername" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" class="form-control-dg" placeholder="Authentication password..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                }
                else if (_newAuthType == "api-key")
                {
                    <div class="form-group">
                        <label>Key Name</label>
                        <input type="text" class="form-control-dg" placeholder="e.g. X-API-Key"
                               @bind="_newAuthUsername" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Key Value</label>
                        <input type="text" class="form-control-dg" placeholder="API key value..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                }
                else if (_newAuthType == "bearer")
                {
                    <div class="form-group">
                        <label>Token</label>
                        <input type="password" class="form-control-dg" placeholder="Bearer token..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                }
                else if (_newAuthType == "ntlm")
                {
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" class="form-control-dg" placeholder="DOMAIN\\Username"
                               @bind="_newAuthUsername" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" class="form-control-dg" placeholder="NTLM password..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Domain</label>
                        <input type="text" class="form-control-dg" placeholder="NTLM domain..."
                               @bind="_newAuthExtra" @bind:event="oninput" />
                    </div>
                }

                <div style="border-top:1px solid var(--sh-border);margin:4px 0 8px"></div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                    <span style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--sh-text-soft)">
                        SOAP APIs
                    </span>
                    <button class="btn btn-dg" style="height:30px;font-size:11px" @onclick="AddApiEntry" type="button">
                        <i class="bi bi-plus-lg"></i>
                        Add API
                    </button>
                </div>
                @for (var i = 0; i < _newApis.Count; i++)
                {
                    var idx = i;
                    <div style="display:flex;gap:8px;align-items:flex-start;margin-bottom:8px">
                        <div style="flex:1;display:flex;flex-direction:column;gap:6px">
                            <input type="text" class="form-control-dg" placeholder="API name..."
                                   @bind="_newApis[idx].Name" @bind:event="oninput" />
                            <input type="text" class="form-control-dg" placeholder="API description..."
                                   @bind="_newApis[idx].Description" @bind:event="oninput" />
                        </div>
                        <button class="btn btn-dg btn-sh-ghost" style="height:36px;width:36px;padding:0;flex-shrink:0;color:var(--sh-error);border-color:transparent"
                                @onclick="() => RemoveApiEntry(idx)" type="button" aria-label="Remove API">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                @if (_newApis.Count == 0)
                {
                    <div style="font-size:12px;color:var(--sh-text-faint);padding:4px 0">
                        No APIs added yet. Click "Add API" to define SOAP endpoints.
                    </div>
                }
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => _showAddModal = false" type="button">Cancel</button>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="HandleAddApplication" type="button">
                    <i class="bi @(_editingApp is null ? "bi-plus-lg" : "bi-check-lg")"></i>
                    @(_editingApp is null ? "Add" : "Save Changes") Application
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<GridColumn<SoapApp>> _columns = [];

    protected override void OnInitialized()
    {
        _columns =
        [
            new()
            {
                Title = "App Name",
                Sortable = true,
                Field = a => a.Name,
                Template = context => builder =>
                {
                    var app = context;
                    var initials = app.Name.Length >= 2 ? app.Name[..2].ToUpper() : app.Name.ToUpper();
                    builder.OpenElement(0, "div");
                    builder.AddAttribute(1, "class", "name-stack");
                    builder.OpenElement(2, "span");
                    builder.AddAttribute(3, "class", "avatar-sm");
                    builder.AddContent(4, initials);
                    builder.CloseElement();
                    builder.OpenElement(5, "span");
                    builder.AddAttribute(6, "style", "font-weight:500");
                    builder.AddContent(7, app.Name);
                    builder.CloseElement();
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Base URL",
                Sortable = true,
                Field = a => a.BaseUrl,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "cell-id");
                    builder.AddContent(2, context.BaseUrl);
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Status",
                Sortable = true,
                Field = a => a.Status,
                Template = context => builder =>
                {
                    var badgeClass = context.Status == "enabled" ? "status-enabled" : "status-disabled";
                    var label = context.Status == "enabled" ? "Enabled" : "Disabled";
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", $"status-badge {badgeClass}");
                    builder.AddContent(2, label);
                    builder.CloseElement();
                }
            },
            new() { Title = "Last Updated By", Sortable = true, Field = a => a.UpdatedBy },
            new() { Title = "Created Date", Sortable = true, Field = a => a.CreatedDate },
            new() { Title = "Operations", Sortable = true, Field = a => a.ApisCount }
        ];
    }

    private string _searchText = "";
    private string _filterName = "";
    private string _filterUrl = "";
    private string _filterStatus = "";
    private string _filterUpdatedBy = "";
    private string _filterCreatedDate = "";
    private string _filterOperations = "";
    private int _currentPage = 1;
    private bool _showFilterModal = false;
    private bool _showAddModal = false;
    private string _newAppName = "";
    private string _newAppUrl = "";
    private string _newAppDescription = "";
    private string _newAppStatus = "enabled";
    private string _newAuthType = "basic";
    private string _newAuthUsername = "";
    private string _newAuthPassword = "";
    private string _newAuthExtra = "";
    private List<SoapApiEntry> _newApis = [];
    private bool _showDropdown = false;
    private HashSet<string> _expandedActionRows = [];
    private SoapApp? _editingApp = null;
    private string _sortColumn = "";
    private bool _sortAscending = true;

    private SoapApp[] FilteredApps
    {
        get
        {
            var query = _appStore.Apps.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var q = _searchText.ToLower();
                query = query.Where(a =>
                    a.Name.ToLower().Contains(q) ||
                    a.BaseUrl.ToLower().Contains(q) ||
                    a.UpdatedBy.ToLower().Contains(q) ||
                    a.Status.ToLower().Contains(q));
            }

            if (!string.IsNullOrWhiteSpace(_filterName))
                query = query.Where(a => a.Name.ToLower().Contains(_filterName.ToLower()));
            if (!string.IsNullOrWhiteSpace(_filterUrl))
                query = query.Where(a => a.BaseUrl.ToLower().Contains(_filterUrl.ToLower()));
            if (!string.IsNullOrWhiteSpace(_filterStatus))
                query = query.Where(a => a.Status == _filterStatus);
            if (!string.IsNullOrWhiteSpace(_filterUpdatedBy))
                query = query.Where(a => a.UpdatedBy.ToLower().Contains(_filterUpdatedBy.ToLower()));
            if (!string.IsNullOrWhiteSpace(_filterCreatedDate))
                query = query.Where(a => a.CreatedDate.ToLower().Contains(_filterCreatedDate.ToLower()));
            if (!string.IsNullOrWhiteSpace(_filterOperations) && int.TryParse(_filterOperations, out var ops))
                query = query.Where(a => a.ApisCount == ops);

            if (!string.IsNullOrWhiteSpace(_sortColumn))
            {
                query = _sortColumn switch
                {
                    "Name" => _sortAscending ? query.OrderBy(a => a.Name) : query.OrderByDescending(a => a.Name),
                    "BaseUrl" => _sortAscending ? query.OrderBy(a => a.BaseUrl) : query.OrderByDescending(a => a.BaseUrl),
                    "Status" => _sortAscending ? query.OrderBy(a => a.Status) : query.OrderByDescending(a => a.Status),
                    "UpdatedBy" => _sortAscending ? query.OrderBy(a => a.UpdatedBy) : query.OrderByDescending(a => a.UpdatedBy),
                    "CreatedDate" => _sortAscending ? query.OrderBy(a => a.CreatedDate) : query.OrderByDescending(a => a.CreatedDate),
                    "ApisCount" => _sortAscending ? query.OrderBy(a => a.ApisCount) : query.OrderByDescending(a => a.ApisCount),
                    _ => query
                };
            }

            return query.ToArray();
        }
    }

    private void OnFilterApplied()
    {
        _currentPage = 1;
    }

    private void OpenEditDialog(SoapApp app)
    {
        _editingApp = app;
        _newAppName = app.Name;
        _newAppUrl = app.BaseUrl;
        _newAppDescription = app.Description;
        _newAppStatus = app.Status;
        _newAuthType = app.AuthType;
        _newAuthUsername = app.AuthUsername;
        _newAuthPassword = app.AuthPassword;
        _newAuthExtra = app.AuthExtra;
        _newApis = [..app.Apis];
        _expandedActionRows.Remove(app.Id);
        _showAddModal = true;
    }

    private void HandleAddApplication()
    {
        if (string.IsNullOrWhiteSpace(_newAppName) || string.IsNullOrWhiteSpace(_newAppUrl))
            return;

        if (_editingApp is not null)
        {
            var updatedApp = new SoapApp(
                _editingApp.Id,
                _newAppName.Trim(),
                _newAppUrl.Trim(),
                _newAppDescription.Trim(),
                _newAppStatus,
                _editingApp.UpdatedBy,
                _editingApp.CreatedDate,
                _newApis.Count,
                _newAuthType,
                _newAuthUsername.Trim(),
                _newAuthPassword.Trim(),
                _newAuthExtra.Trim(),
                [.._newApis]
            );
            _appStore.UpdateApps([.._appStore.Apps.Where(a => a.Id != _editingApp.Id), updatedApp]);
        }
        else
        {
            var newId = $"s{_appStore.Apps.Length + 1}";
            var newApp = new SoapApp(
                newId,
                _newAppName.Trim(),
                _newAppUrl.Trim(),
                _newAppDescription.Trim(),
                _newAppStatus,
                "Anonymous",
                DateTime.Now.ToString("yyyy-MM-dd"),
                _newApis.Count,
                _newAuthType,
                _newAuthUsername.Trim(),
                _newAuthPassword.Trim(),
                _newAuthExtra.Trim(),
                [.._newApis]
            );
            _appStore.UpdateApps([.._appStore.Apps, newApp]);
        }

        _showAddModal = false;
        _editingApp = null;
        ResetAddForm();
        _currentPage = 1;
    }

    private void AddApiEntry()
    {
        _newApis.Add(new SoapApiEntry());
    }

    private void RemoveApiEntry(int index)
    {
        _newApis.RemoveAt(index);
    }

    private void ResetAddForm()
    {
        _newAppName = "";
        _newAppUrl = "";
        _newAppDescription = "";
        _newAppStatus = "enabled";
        _newAuthType = "basic";
        _newAuthUsername = "";
        _newAuthPassword = "";
        _newAuthExtra = "";
        _newApis = [];
    }

    private void HandleResetSort()
    {
        _showDropdown = false;
        _sortColumn = "";
        _sortAscending = true;
        _currentPage = 1;
    }

    private void ResetAdvancedFilters()
    {
        _searchText = "";
        _filterName = "";
        _filterUrl = "";
        _filterStatus = "";
        _filterUpdatedBy = "";
        _filterCreatedDate = "";
        _filterOperations = "";
        _currentPage = 1;
    }
}
