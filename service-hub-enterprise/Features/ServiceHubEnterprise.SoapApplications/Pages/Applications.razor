@page "/soap/applications"
@inject SoapAppStore _appStore

@* ── Loading Skeleton ── *@
@if (_isLoading)
{
    <div class="datagrid-card" style="padding:0">
        <div class="skeleton-table">
            <div class="skeleton-header">
                <div class="skeleton-cell skeleton-check"></div>
                <div class="skeleton-cell skeleton-name"></div>
                <div class="skeleton-cell skeleton-url"></div>
                <div class="skeleton-cell skeleton-status"></div>
                <div class="skeleton-cell skeleton-updatedby"></div>
                <div class="skeleton-cell skeleton-date"></div>
                <div class="skeleton-cell skeleton-actions"></div>
            </div>
            @RenderSkeletonRows
        </div>
    </div>
}
else if (_hasError)
{
    <div class="datagrid-card error-state-card">
        <i class="bi bi-exclamation-triangle fs-28 text-sh-error"></i>
        <p class="error-state-text">@_errorMessage</p>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="LoadAppsAsync" type="button">
            <i class="bi bi-arrow-repeat"></i>
            Retry
        </button>
        <button class="btn btn-outline-secondary btn-dg ms-2" @onclick="DismissError" type="button">Dismiss</button>
    </div>
}
else
{
    @* ── Loading Grid ── *@
    <ServiceHubGrid TItem="SoapApp"
                    Id="soapAppsGrid"
                    Items="FilteredApps"
                PageSize="5"
                EnableSelection="true"
                EnablePagination="true"
                EnableSearch="true"
                EnableExpand="true"
                EnableContextMenu="true"
                SearchPlaceholder="Search applications..."
                EmptyText="No applications found matching the current filters."
                FilterModalTitle="Filter Applications"
                @bind-SortColumn="_sortColumn"
                @bind-SortAscending="_sortAscending"
                @bind-CurrentPage="_currentPage"
                @bind-SearchText="_searchText"
                @bind-ShowFilterModal="_showFilterModal"
                FilterApplied="OnFilterApplied"
                RowIdSelector="@(app => app.Id)"
                Columns="@_columns">

    <ToolbarCenter>
        <button class="filter-btn" @onclick="() => _showFilterModal = true" type="button" aria-label="Filter applications">
            <i class="bi bi-funnel"></i>
            Filter
        </button>
    </ToolbarCenter>

    <ToolbarRight>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => { _validationErrors = []; _showAddModal = true; }" type="button" aria-label="Add Application">
            <i class="bi bi-plus-lg"></i>
            Add Application
        </button>
        <div class="position-relative">
            <button class="btn btn-outline-secondary btn-dg" @onclick="() => _showDropdown = !_showDropdown" type="button">
                <i class="bi bi-three-dots-vertical"></i>
                Actions
                <i class="bi bi-chevron-down"></i>
            </button>
            @if (_showDropdown)
            {
                <div class="position-fixed" style="inset:0;z-index:50" @onclick="() => _showDropdown = false"></div>
                <div class="dropdown-menu-dg">
                    <div class="py-1">
                        <div class="dropdown-header-dg">Export</div>
                        <button class="btn dropdown-item-dg" @onclick="() => _showDropdown = false" type="button">
                            <i class="bi bi-download"></i>
                            Export to CSV
                        </button>
                        <button class="btn dropdown-item-dg" @onclick="() => _showDropdown = false" type="button">
                            <i class="bi bi-download"></i>
                            Export to JSON
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <button class="btn dropdown-item-dg dropdown-item-sh-danger" @onclick="() => _showDropdown = false" type="button">
                            <i class="bi bi-trash3"></i>
                            Delete Selected
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <div class="dropdown-header-dg">View</div>
                        <button class="btn dropdown-item-dg"
                                @onclick="() => { _showDropdown = false; ResetAdvancedFilters(); }"
                                type="button">
                            <i class="bi bi-arrow-repeat"></i>
                            Reset Filter
                        </button>
                        <button class="btn dropdown-item-dg"
                                @onclick="HandleResetSort"
                                type="button">
                            <i class="bi bi-arrow-up-short"></i>
                            Reset Sort
                        </button>
                        <div class="dropdown-divider-dg"></div>
                        <button class="btn dropdown-item-dg"
                                @onclick="() => { _showDropdown = false; }"
                                type="button">
                            <i class="bi bi-arrows-expand"></i>
                            Expand Selected
                        </button>
                        <button class="btn dropdown-item-dg"
                                @onclick="() => { _showDropdown = false; }"
                                type="button">
                            <i class="bi bi-arrows-collapse"></i>
                            Collapse Selected
                        </button>
                    </div>
                </div>
            }
        </div>
    </ToolbarRight>

    <RowActions Context="app">
        @{
            var isEnabled = string.Compare(app.Status, "enabled", StringComparison.OrdinalIgnoreCase) == 0;
        }
        <div class="row-actions-wrap blazor-managed@(_expandedActionRows.Contains(app.Id) ? " is-open" : "")">
            <button class="action-trigger" type="button" aria-label="More actions" data-tooltip="More actions"
                    @onclick="() => _expandedActionRows.Add(app.Id)">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
            </button>
            <div class="inline-actions">
                <button class="ia-btn ia-normal" type="button" aria-label="Edit" data-tooltip="Edit"
                        @onclick="() => OpenEditDialog(app)">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-danger" type="button" aria-label="Delete" data-tooltip="Delete">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
                <button class="ia-btn @(isEnabled ? "ia-enable" : "ia-normal")" type="button" aria-label="Toggle" data-tooltip="Toggle">
                    @if(isEnabled)
                    {
                        <i class="bi bi-toggle-off" aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="bi bi-toggle-on" aria-hidden="true"></i>
                    }
                </button>
                <button class="ia-btn ia-close" type="button" aria-label="Close" data-tooltip="Close" @onclick="() => _expandedActionRows.Remove(app.Id)" >
                    <i class="bi bi-x-lg fs-11" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </RowActions>

    <DetailRow Context="app">
        @{
            var isEnabled = string.Compare(app.Status, "enabled", StringComparison.OrdinalIgnoreCase) == 0;
        }
        <div class="detail-grid">
            <div>
                <div class="detail-label">Application ID</div>
                <div class="detail-value">@app.Id</div>
            </div>
            <div>
                <div class="detail-label">Full URL</div>
                <div class="detail-value text-break">@app.BaseUrl</div>
            </div>
            <div class="grid-col-full">
                <div class="detail-label">Description</div>
                <div class="detail-value">@(string.IsNullOrEmpty(app.Description) ? "—" : app.Description)</div>
            </div>
            <div>
                <div class="detail-label">Status</div>
                <div class="detail-value">
                    <span class="status-badge @(isEnabled ? "status-enabled" : "status-disabled")">
                        @(isEnabled ? "Enabled" : "Disabled")
                    </span>
                </div>
            </div>
            <div>
                <div class="detail-label">Last Modified</div>
                <div class="detail-value">@(app.UpdatedAt?.ToString("yyyy-MM-dd") ?? "—") by @(app.UpdatedBy ?? "—")</div>
            </div>

            <div class="grid-col-full border-sh-top pt-2 mt-1">
                <div class="fs-10 fw-semibold text-uppercase ls-06 text-sh-faint mb-2">
                    <i class="bi bi-shield-lock me-1"></i>Authentication
                </div>
            </div>
            <div>
                <div class="detail-label">Auth Type</div>
                <div class="detail-value">
                    <span class="d-inline-flex align-items-center fs-10 fw-semibold text-sh-accent" style="height:20px;padding:0 7px;background:var(--sh-accent-soft);border:1px solid var(--sh-border)">
                        @(app.AuthType switch
                        {
                            "none" => "None",
                            "basic" => "Basic",
                            "api-key" => "API Key",
                            "bearer" => "Bearer",
                            "ntlm" => "NTLM",
                            _ => app.AuthType
                        })
                    </span>
                </div>
            </div>
            <div>
                <div class="detail-label">Credentials</div>
                <div class="detail-value">
                    @(app.AuthType switch
                    {
                        "none" => "—",
                        "api-key" => app.AuthUsername,
                        "bearer" => "Token configured",
                        _ => string.IsNullOrEmpty(app.AuthUsername) ? "—" : app.AuthUsername
                    })
                    @if (app.AuthType == "ntlm" && !string.IsNullOrEmpty(app.AuthExtra))
                    {
                        <span class="text-sh-faint">(@app.AuthExtra)</span>
                    }
                </div>
            </div>

            <div class="grid-col-full border-sh-top pt-2 mt-1">
                <div class="fs-10 fw-semibold text-uppercase ls-06 text-sh-faint mb-2">
                    <i class="bi bi-diagram-3 me-1"></i>SOAP APIs (@app.ApisCount)
                </div>
            </div>
            @if (app.Apis.Length > 0)
            {
                <div style="grid-column:1/-1">
                    <div class="d-flex flex-column gap-1">
                        @foreach (var api in app.Apis)
                        {
                            <div class="d-flex align-items-center gap-8px bg-sh-surface-2 border-sh" style="padding:5px 10px">
                                <span class="fw-medium fs-12 text-nowrap" style="color:var(--sh-text)">@api.Name</span>
                                @if (!string.IsNullOrEmpty(api.Description))
                                {
                                    <span class="text-sh-soft fs-11">— @api.Description</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="grid-col-full">
                    <div class="detail-value text-sh-faint fst-italic">No APIs configured</div>
                </div>
            }
        </div>
    </DetailRow>

    <FilterModalBody>
        <div class="form-group">
            <label>App Name</label>
            <input type="text" class="form-control-dg" placeholder="Filter by name..."
                   @bind="_filterName" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Base URL</label>
            <input type="text" class="form-control-dg" placeholder="Filter by URL..."
                   @bind="_filterUrl" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Status</label>
            <select class="form-control-dg" @bind="_filterStatus">
                <option value="">All</option>
                <option value="enabled">Enabled</option>
                <option value="disabled">Disabled</option>
            </select>
        </div>
        <div class="form-group">
            <label>Last Updated By</label>
            <input type="text" class="form-control-dg" placeholder="Filter by user..."
                   @bind="_filterUpdatedBy" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label>Last Updated Date</label>
            <div class="d-flex gap-8px align-items-center">
                <input type="date" class="form-control-dg" @bind="_filterUpdatedDateFrom" />
                <span class="text-sh-faint">to</span>
                <input type="date" class="form-control-dg" @bind="_filterUpdatedDateTo" />
            </div>
        </div>
        <div class="form-group">
            <label>Created Date</label>
            <div class="d-flex gap-8px align-items-center">
                <input type="date" class="form-control-dg" @bind="_filterCreatedDateFrom" />
                <span class="text-sh-faint">to</span>
                <input type="date" class="form-control-dg" @bind="_filterCreatedDateTo" />
            </div>
        </div>
        <div class="form-group">
            <label>Operations</label>
            <input type="text" class="form-control-dg" placeholder="Filter by operations..."
                   @bind="_filterOperations" @bind:event="oninput" />
        </div>
    </FilterModalBody>
</ServiceHubGrid>
}

@if (_showAddModal)
{
    <div class="modal-overlay" @onclick="() => { _validationErrors = []; _showAddModal = false; }">
        <div class="modal-content-dg" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>@(_editingApp is null ? "Add" : "Edit") SOAP Application</h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" type="button" aria-label="Close" @onclick="() => { _validationErrors = []; _showAddModal = false; }">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                @if (_validationErrors.Count > 0)
                {
                    <div class="alert-validation">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Please fix the following:
                        <ul class="mt-1 mb-0 ps-20">
                            @foreach (var err in _validationErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                <div class="form-group">
                    <label>App Name <span class="text-sh-error">*</span></label>
                    <input type="text" class="form-control-dg" placeholder="Enter application name..."
                           @bind="_newAppName" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Base URL <span class="text-sh-error">*</span></label>
                    <input type="text" class="form-control-dg" placeholder="https://soap.example.com/Service"
                           @bind="_newAppUrl" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>WSDL Path</label>
                    <input type="text" class="form-control-dg" placeholder="?wsdl"
                           @bind="_newAppWsdlPath" @bind:event="oninput" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control-dg textarea" placeholder="Describe the SOAP application..."
                              @bind="_newAppDescription" @bind:event="oninput"></textarea>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select class="form-control-dg" @bind="_newAppStatus">
                        <option value="enabled">Enabled</option>
                        <option value="disabled">Disabled</option>
                    </select>
                </div>

                <div class="border-sh-top my-1 mb-2"></div>
                <div class="fs-11 fw-semibold text-uppercase ls-05 text-sh-soft mb-2">
                    Authentication Details <span class="text-sh-error">*</span>
                </div>
                <div class="form-group">
                    <label>Auth Type</label>
                    <select class="form-control-dg" @bind="_newAuthType">
                        <option value="none">No Authentication</option>
                        <option value="basic">Basic Auth</option>
                        <option value="api-key">API Key</option>
                        <option value="bearer">Bearer Token</option>
                        <option value="ntlm">NTLM</option>
                    </select>
                </div>

                @if (_newAuthType == "basic")
                {
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" class="form-control-dg" placeholder="Authentication username..."
                               @bind="_newAuthUsername" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" class="form-control-dg" placeholder="Authentication password..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                }
                else if (_newAuthType == "api-key")
                {
                    <div class="form-group">
                        <label>Key Name</label>
                        <input type="text" class="form-control-dg" placeholder="e.g. X-API-Key"
                               @bind="_newAuthUsername" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Key Value</label>
                        <input type="text" class="form-control-dg" placeholder="API key value..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                }
                else if (_newAuthType == "bearer")
                {
                    <div class="form-group">
                        <label>Token</label>
                        <input type="password" class="form-control-dg" placeholder="Bearer token..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                }
                else if (_newAuthType == "ntlm")
                {
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" class="form-control-dg" placeholder="DOMAIN\\Username"
                               @bind="_newAuthUsername" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" class="form-control-dg" placeholder="NTLM password..."
                               @bind="_newAuthPassword" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label>Domain</label>
                        <input type="text" class="form-control-dg" placeholder="NTLM domain..."
                               @bind="_newAuthExtra" @bind:event="oninput" />
                    </div>
                }

                <div class="border-sh-top my-1 mb-2"></div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fs-11 fw-semibold text-uppercase ls-05 text-sh-soft">
                        SOAP APIs <span class="text-sh-error">*</span>
                    </span>
                    <button class="btn btn-dg fs-11 h-30" @onclick="AddApiEntry" type="button">
                        <i class="bi bi-plus-lg"></i>
                        Add API
                    </button>
                </div>
                @for (var i = 0; i < _newApis.Count; i++)
                {
                    var idx = i;
                    <div class="d-flex gap-8px align-items-start mb-2">
                        <div class="d-flex flex-column flex-fill" style="gap:6px">
                            <input type="text" class="form-control-dg" placeholder="API name..."
                                   @bind="_newApis[idx].Name" @bind:event="oninput" />
                            <input type="text" class="form-control-dg" placeholder="API description..."
                                   @bind="_newApis[idx].Description" @bind:event="oninput" />
                        </div>
                        <button class="btn btn-dg btn-sh-ghost btn-remove-file"
                                @onclick="() => RemoveApiEntry(idx)" type="button" aria-label="Remove API">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                @if (_newApis.Count == 0)
                {
                    <div class="fs-12 text-sh-faint py-1">
                        No APIs added yet. Click "Add API" to define SOAP endpoints.
                    </div>
                }
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => { _validationErrors = []; _showAddModal = false; }" type="button">Cancel</button>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="HandleAddApplication" type="button">
                    <i class="bi @(_editingApp is null ? "bi-plus-lg" : "bi-check-lg")"></i>
                    @(_editingApp is null ? "Add" : "Save Changes") Application
                </button>
            </div>
        </div>
    </div>
}