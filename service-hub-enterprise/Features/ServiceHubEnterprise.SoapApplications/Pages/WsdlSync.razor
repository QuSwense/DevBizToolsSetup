@page "/soap/wsdl-sync"

<div class="datagrid-card empty-state-card" style="padding:60px 20px;gap:12px">
    <i class="bi bi-globe2 empty-state-icon" style="font-size:48px"></i>
    <h3 class="empty-state-title">WSDL Sync</h3>
    <p class="empty-state-desc">
        Import WSDL documents to automatically create and update SOAP application definitions and operations.
    </p>
    <div class="empty-state-actions">
        <button class="btn btn-dark btn-sh-primary">
            <i class="bi bi-download"></i>
            Import WSDL URL
        </button>
        <button class="btn btn-outline-secondary btn-dg">
            <i class="bi bi-upload"></i>
            Upload File
        </button>
    </div>
</div>
