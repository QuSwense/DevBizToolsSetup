@page "/soap/execute-history"
@inject RequestExecutionStore ExecutionStore

@* Executions are now served by the shared ExecutionsOverview section card,
   reading real data from mock_db/request-executions.json (SOAP filter). *@

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading execution history...</span>
        </div>
    </div>
}
else
{
    <div class="dashboard-stack">
        <ExecutionsOverview Executions="@_executions" />
    </div>
}

@code {
    private bool _isLoading = true;
    private SoapExecution[] _executions = [];

    protected override void OnInitialized()
    {
        _executions = ExecutionStore.SoapExecutions;
        _isLoading = false;
    }
}
