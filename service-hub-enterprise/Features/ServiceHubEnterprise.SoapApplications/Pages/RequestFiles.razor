@page "/soap/request-files"
@inject SoapAppStore _appStore

<ServiceHubGrid TItem="RequestFile"
                Id="requestFilesGrid"
                Items="Files"
                PageSize="10"
                EnableSelection="true"
                EnablePagination="true"
                EnableSearch="true"
                EnableExpand="true"
                SearchPlaceholder="Search request files..."
                EmptyText="No request files found."
                RowIdSelector="@(f => f.FileName)"
                Columns="@_columns">

    <ToolbarRight>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="() => _showUploadModal = true" type="button">
            <i class="bi bi-plus-lg"></i>
            Upload File
        </button>
        <button class="btn btn-outline-secondary btn-dg">
            <i class="bi bi-download"></i>
            Export
        </button>
    </ToolbarRight>

    <RowActions Context="file">
        <div class="row-actions-wrap blazor-managed@(_expandedActionRows.Contains(file.FileName) ? " is-open" : "")">
            <button class="action-trigger" type="button" aria-label="More actions" data-tooltip="More actions"
                    @onclick="() => _expandedActionRows.Add(file.FileName)">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
            </button>
            <div class="inline-actions">
                <button class="ia-btn ia-edit" type="button" aria-label="Edit" data-tooltip="Edit">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-danger" type="button" aria-label="Delete" data-tooltip="Delete">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-close" type="button" aria-label="Close" data-tooltip="Close"
                        @onclick="() => _expandedActionRows.Remove(file.FileName)">
                    <i class="bi bi-x-lg" style="font-size: 11px" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </RowActions>

    <DetailRow Context="file">
        <div class="detail-grid">
            <div style="grid-column:1/-1">
                <div class="detail-label">Description</div>
                <div class="detail-value">@file.Description</div>
            </div>
            <div>
                <div class="detail-label">Created</div>
                <div class="detail-value">@file.Created</div>
            </div>
            <div>
                <div class="detail-label">Last Updated</div>
                <div class="detail-value">@file.Updated</div>
            </div>
        </div>
    </DetailRow>
</ServiceHubGrid>

@if (_showUploadModal)
{
    <div class="modal-overlay" @onclick="() => _showUploadModal = false">
        <div class="modal-content-dg" style="width:560px" @onclick:stopPropagation="true">
            <div class="modal-header-dg">
                <h3>Upload Request Files</h3>
                <button class="btn btn-sh-ghost btn-dg btn-icon-sm" @onclick="() => _showUploadModal = false" type="button" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-dg">
                <div class="form-group">
                    <label>Application</label>
                    <select class="form-control-dg" @bind="_uploadAppName" @bind:event="oninput">
                        <option value="">Select an application...</option>
                        @foreach (var app in _availableApps)
                        {
                            <option value="@app">@app</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Operation</label>
                    <select class="form-control-dg" @bind="_uploadApiPath" @bind:event="oninput"
                            disabled="@(!_availableOperations.Any())">
                        <option value="">@(_availableOperations.Any() ? "Select an operation..." : "Select an application first")</option>
                        @foreach (var op in _availableOperations)
                        {
                            <option value="@op.Name">@op.Name — @op.Description</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control-dg textarea" placeholder="Describe the purpose of these request files..."
                              @bind="_uploadDescription" @bind:event="oninput"></textarea>
                </div>

                <div style="border-top:1px solid var(--sh-border);margin:4px 0 8px"></div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                    <span style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--sh-text-soft)">
                        <i class="bi bi-files" style="margin-right:4px"></i>
                        Files (@_uploadFiles.Count)
                    </span>
                    <div style="display:flex;gap:6px">
                        <button class="btn btn-dg" style="height:30px;font-size:11px" @onclick="AddUploadFileEntry" type="button">
                            <i class="bi bi-plus-lg"></i>
                            Add File
                        </button>
                        <label class="btn btn-dg" style="height:30px;font-size:11px;cursor:pointer;margin:0">
                            <i class="bi bi-folder2-open"></i>
                            Upload from Local
                            <InputFile OnChange="HandleLocalFileUpload" multiple hidden />
                        </label>
                    </div>
                </div>
                @for (var i = 0; i < _uploadFiles.Count; i++)
                {
                    var idx = i;
                    <div style="display:flex;gap:8px;align-items:flex-start;margin-bottom:8px;padding:10px;border:1px solid var(--sh-border);background:var(--sh-surface-2)">
                        <div style="flex:1;display:flex;flex-direction:column;gap:6px">
                            <div style="display:flex;align-items:center;gap:6px">
                                <span style="font-size:10px;font-weight:600;color:var(--sh-text-faint);min-width:28px">#@(idx + 1)</span>
                                <input type="text" class="form-control-dg" placeholder="File name (e.g. invoice_create.xml)"
                                       style="flex:1" @bind="_uploadFiles[idx].FileName" @bind:event="oninput" />
                            </div>
                            <textarea class="form-control-dg textarea" placeholder="Paste or type XML/SOAP envelope content..."
                                      style="min-height:70px;font-family:'JetBrains Mono','Menlo',monospace;font-size:12px"
                                      @bind="_uploadFiles[idx].Content" @bind:event="oninput">@_uploadFiles[idx].Content</textarea>
                            @if (!string.IsNullOrEmpty(_uploadFiles[idx].FileName))
                            {
                                <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                                    <span class="verb-badge" style="background:var(--sh-accent-soft);color:var(--sh-accent);border-color:currentColor;font-size:10px;padding:0 6px">
                                        @System.IO.Path.GetExtension(_uploadFiles[idx].FileName)?.TrimStart('.')?.ToUpper() ?? "XML"
                                    </span>
                                    <span style="font-size:10px;color:var(--sh-text-faint)">
                                        <i class="bi bi-file-text"></i>
                                        @(_uploadFiles[idx].Content?.Length ?? 0) chars
                                    </span>
                                </div>
                            }
                        </div>
                        <button class="btn btn-dg btn-sh-ghost" style="height:36px;width:36px;padding:0;flex-shrink:0;color:var(--sh-error);border-color:transparent"
                                @onclick="() => RemoveUploadFileEntry(idx)" type="button" aria-label="Remove file" title="Remove file">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                @if (_uploadFiles.Count == 0)
                {
                    <div style="font-size:12px;color:var(--sh-text-faint);padding:8px 0;text-align:center;border:1px dashed var(--sh-border);background:var(--sh-surface-2)">
                        <i class="bi bi-upload" style="font-size:18px;display:block;margin-bottom:4px"></i>
                        No files added yet. Click "Add File" or "Upload from Local" to include request files.
                    </div>
                }
            </div>
            <div class="modal-footer-dg">
                <button class="btn btn-dg" @onclick="() => _showUploadModal = false" type="button">Cancel</button>
                <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="HandleUploadFiles" type="button">
                    <i class="bi bi-cloud-upload"></i>
                    Upload @(_uploadFiles.Count > 0 ? $"{_uploadFiles.Count} File(s)" : "Files")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private record RequestFile(string FileName, string AppName, string ApiPath, string Verb, string Description, string Updated, string Created);
    private class UploadFileEntry
    {
        public string FileName { get; set; } = "";
        public string Content { get; set; } = "";
    }

    private List<GridColumn<RequestFile>> _columns = [];
    private HashSet<string> _expandedActionRows = [];

    private bool _showUploadModal = false;
    private string _uploadAppName = "";
    private string _uploadApiPath = "";
    private string _uploadDescription = "";
    private List<UploadFileEntry> _uploadFiles = [];

    private string[] _availableApps => _appStore.Apps.Select(a => a.Name).OrderBy(a => a).ToArray();
    private SoapApiEntry[] _availableOperations =>
        _appStore.Apps.FirstOrDefault(a => a.Name == _uploadAppName)?.Apis ?? [];

    private static string GetVerbFromOperation(string operationName)
    {
        if (string.IsNullOrWhiteSpace(operationName))
            return "POST";
        var name = operationName.Trim();
        if (name.StartsWith("Get", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("Find", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("Search", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("List", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("Check", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("Validate", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("Track", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("Export", StringComparison.OrdinalIgnoreCase))
            return "GET";
        return "POST";
    }

    protected override void OnInitialized()
    {
        _columns =
        [
            new()
            {
                Title = "File Name",
                Sortable = true,
                Field = f => f.FileName,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "mono-text");
                    builder.AddContent(2, context.FileName);
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Application",
                Sortable = true,
                Field = f => f.AppName,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "style", "color:var(--sh-text-soft)");
                    builder.AddContent(2, context.AppName);
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Operation",
                Sortable = true,
                Field = f => f.ApiPath,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "cell-id");
                    builder.AddContent(2, context.ApiPath);
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Verb",
                Sortable = true,
                Field = f => f.Verb,
                Template = context => builder =>
                {
                    var verbColor = "var(--sh-success)";
                    var verbBg = "var(--sh-success-bg)";
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "verb-badge");
                    builder.AddAttribute(2, "style", $"background:{verbBg};color:{verbColor};border-color:currentColor");
                    builder.AddContent(3, context.Verb);
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Updated",
                Sortable = true,
                Field = f => f.Updated,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "style", "color:var(--sh-text-soft)");
                    builder.AddContent(2, context.Updated);
                    builder.CloseElement();
                }
            }
        ];
    }

    private static RequestFile[] Files =
    [
        new("invoice_create.xml", "LegacyBilling", "CreateInvoice", "POST", "SOAP envelope for invoice creation with tax", "2024-03-20", "2024-03-15"),
        new("order_submit.xml", "OrderProcessing", "SubmitOrder", "POST", "Submit a new order with line items and shipping information", "2024-04-10", "2024-04-05"),
        new("track_shipment.xml", "ShippingSOAP", "TrackShipment", "GET", "Track package location by tracking number across carriers", "2024-03-01", "2024-02-28"),
        new("get_customer_profile.xml", "CustomerPortal", "GetProfile", "GET", "Fetch customer profile by customer ID with contact details", "2024-05-12", "2024-05-10"),
        new("process_payment.xml", "PaymentGateway", "ProcessPayment", "POST", "Process credit card payment with amount, currency and descriptor", "2024-06-01", "2024-05-25"),
        new("sync_inventory.xml", "InventorySync", "SyncInventory", "POST", "Synchronize inventory levels across all warehouses in the network", "2024-02-15", "2024-02-10"),
        new("generate_report.xml", "ReportingEngine", "GenerateReport", "GET", "Generate monthly sales report in PDF format with charts", "2024-04-22", "2024-04-20"),
        new("send_email_notification.xml", "NotificationHub", "SendEmail", "POST", "Send transactional email notification with HTML template and attachments", "2024-05-30", "2024-05-28"),
        new("refund_transaction.xml", "PaymentGateway", "RefundTransaction", "POST", "Issue full or partial refund for a processed transaction", "2024-06-15", "2024-06-10"),
        new("cancel_order.xml", "OrderProcessing", "CancelOrder", "POST", "Cancel an existing order before it has been shipped", "2024-03-25", "2024-03-22"),
        new("validate_card.xml", "PaymentGateway", "ValidateCard", "GET", "Validate credit card number and expiry without charging", "2024-06-20", "2024-06-18"),
        new("get_delivery_status.xml", "NotificationHub", "GetDeliveryStatus", "GET", "Check delivery status of a sent notification by message ID", "2024-05-05", "2024-05-02"),
        new("get_invoice_status.xml", "LegacyBilling", "GetInvoiceStatus", "GET", "Check the processing status of a submitted invoice", "2024-03-22", "2024-03-18"),
        new("create_shipping_label.xml", "ShippingSOAP", "CreateLabel", "POST", "Generate shipping label with weight, dimensions and service type", "2024-03-05", "2024-03-01"),
        new("update_customer_profile.xml", "CustomerPortal", "UpdateProfile", "POST", "Update customer profile fields such as email, phone and address", "2024-05-15", "2024-05-12")
    ];

    private void AddUploadFileEntry()
    {
        _uploadFiles = [.._uploadFiles, new UploadFileEntry()];
    }

    private void RemoveUploadFileEntry(int index)
    {
        _uploadFiles = [.._uploadFiles.Where((_, i) => i != index)];
    }

    private async Task HandleLocalFileUpload(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            if (file.Size > 10 * 1024 * 1024)
                continue;

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            _uploadFiles = [.._uploadFiles, new UploadFileEntry { FileName = file.Name, Content = content }];
        }
    }

    private void HandleUploadFiles()
    {
        if (string.IsNullOrWhiteSpace(_uploadAppName) || string.IsNullOrWhiteSpace(_uploadApiPath))
            return;

        var validFiles = _uploadFiles.Where(f => !string.IsNullOrWhiteSpace(f.FileName)).ToArray();
        if (validFiles.Length == 0)
            return;

        var today = DateTime.Now.ToString("yyyy-MM-dd");
        var verb = GetVerbFromOperation(_uploadApiPath);

        var newFiles = validFiles.Select(f => new RequestFile(
            f.FileName.Trim(),
            _uploadAppName.Trim(),
            _uploadApiPath.Trim(),
            verb,
            _uploadDescription.Trim(),
            today,
            today
        )).ToArray();

        Files = [..Files, ..newFiles];

        // Reset form
        _uploadAppName = "";
        _uploadApiPath = "";
        _uploadDescription = "";
        _uploadFiles = [];
        _showUploadModal = false;
    }
}
