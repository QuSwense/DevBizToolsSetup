@page "/soap/templates"

<ServiceHubGrid TItem="Template"
                Id="templatesGrid"
                Items="TemplateItems"
                PageSize="10"
                EnableSelection="true"
                EnablePagination="true"
                EnableSearch="true"
                EnableExpand="true"
                SearchPlaceholder="Search templates..."
                EmptyText="No templates found."
                RowIdSelector="@(t => t.Name)"
                Columns="@_columns">

    <ToolbarRight>
        <button class="btn btn-sh-primary btn-dg btn-dark" type="button" aria-label="Create Template">
            <i class="bi bi-plus-lg"></i>
            Create Template
        </button>
    </ToolbarRight>

    <RowActions Context="tpl">
        <div class="row-actions-wrap blazor-managed@(_expandedActionRows.Contains(tpl.Name) ? " is-open" : "")">
            <button class="action-trigger" type="button" aria-label="More actions" data-tooltip="More actions"
                    @onclick="() => _expandedActionRows.Add(tpl.Name)">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
            </button>
            <div class="inline-actions">
                <button class="ia-btn ia-normal" type="button" aria-label="Edit" data-tooltip="Edit">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-normal" type="button" aria-label="Use" data-tooltip="Use">
                    <i class="bi bi-play-fill" aria-hidden="true"></i>
                </button>
                <button class="ia-btn ia-close" type="button" aria-label="Close" data-tooltip="Close"
                        @onclick="() => _expandedActionRows.Remove(tpl.Name)">
                    <i class="bi bi-x-lg fs-11" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </RowActions>

    <DetailRow Context="tpl">
        <div class="detail-grid">
            <div>
                <div class="detail-label">Template Name</div>
                <div class="detail-value mono-text">@tpl.Name</div>
            </div>
            <div>
                <div class="detail-label">Type</div>
                <div class="detail-value">
                    <span class="verb-badge verb-badge-accent fs-10">@tpl.Type</span>
                </div>
            </div>
            <div>
                <div class="detail-label">Created</div>
                <div class="detail-value">@tpl.Created</div>
            </div>
            <div>
                <div class="detail-label">Last Updated</div>
                <div class="detail-value">@tpl.Updated</div>
            </div>
            <div>
                <div class="detail-label">Usage</div>
                <div class="detail-value">@tpl.Usage uses</div>
            </div>
        </div>
    </DetailRow>
</ServiceHubGrid>

@code {
    private record Template(string Name, string Type, string Updated, string Created, int Usage);

    private List<GridColumn<Template>> _columns = [];
    private HashSet<string> _expandedActionRows = [];

    protected override void OnInitialized()
    {
        _columns =
        [
            new()
            {
                Title = "Template Name",
                Sortable = true,
                Field = t => t.Name,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "mono-text");
                    builder.AddContent(2, context.Name);
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Updated",
                Sortable = true,
                Field = t => t.Updated,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "text-sh-soft");
                    builder.AddContent(2, context.Updated);
                    builder.CloseElement();
                }
            },
            new()
            {
                Title = "Usage",
                Sortable = true,
                Field = t => t.Usage,
                Template = context => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "text-sh-soft");
                    builder.AddContent(2, context.Usage);
                    builder.AddContent(3, " uses");
                    builder.CloseElement();
                }
            }
        ];
    }

    private static Template[] TemplateItems =
    [
        new("Billing Invoice Request", "XML", "2024-02-10", "2024-02-10", 15),
        new("Shipping Track Envelope", "XML", "2024-02-10", "2024-02-22", 9),
        new("Billing Cancel Envelope", "XML", "2024-02-10", "2024-03-05", 6)
    ];
}
