@namespace ServiceHubEnterprise.SoapApplications.Components

<SectionCard Title="Applications" Icon="📦" Subtitle="SOAP applications, auth & operations"
             Collapsible="true" Collapsed="@Collapsed" OnToggle="OnToggle">
    <Summary>
        <div class="summary-chip">
            <span class="summary-chip-icon">📦</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Apps</span>
                <span class="summary-chip-value">@TotalApps</span>
                <span class="summary-chip-sub">@EnabledApps enabled</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">🟢</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Enabled</span>
                <span class="summary-chip-value summary-chip-value--success">@EnabledApps</span>
                <span class="summary-chip-sub">active</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">⛔</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Disabled</span>
                <span class="summary-chip-value summary-chip-value--warning">@DisabledApps</span>
                <span class="summary-chip-sub">inactive</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">🔁</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Operations</span>
                <span class="summary-chip-value">@TotalOperations</span>
                <span class="summary-chip-sub">SOAP APIs</span>
            </div>
        </div>
        <div class="summary-chip summary-chip-donut">
            <MiniDonut Value="@EnabledApps" Total="@TotalApps" Label="enabled" ValueColor="var(--sh-success)" Size="56" />
            <div class="summary-chip-main">
                <span class="summary-chip-label">Enabled share</span>
                <span class="summary-chip-value">@(TotalApps > 0 ? EnabledApps * 100 / TotalApps : 0)%</span>
            </div>
        </div>
    </Summary>
    <ChildContent>
    <div class="kpi-grid">
        <KpiTile Label="Total Apps" Value="@TotalApps.ToString()" Sub="applications" Icon="📦" />
        <KpiTile Label="Enabled" Value="@EnabledApps.ToString()" Sub="active" Color="var(--sh-success)" Icon="🟢" />
        <KpiTile Label="Disabled" Value="@DisabledApps.ToString()" Sub="inactive" Color="var(--sh-warning)" Icon="⛔" />
        <KpiTile Label="Operations" Value="@TotalOperations.ToString()" Sub="SOAP APIs" Icon="🔁" />
        <div class="kpi-tile kpi-donut-tile">
            <div class="kpi-header"><span class="kpi-title">Enabled Share</span></div>
            <div class="kpi-donut">
                <MiniDonut Value="@EnabledApps" Total="@TotalApps" Label="enabled" ValueColor="var(--sh-success)" />
            </div>
        </div>
    </div>
    </ChildContent>
</SectionCard>
