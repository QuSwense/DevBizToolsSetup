@namespace ServiceHubEnterprise.SoapApplications.Components

<SectionCard Title="Executions" Icon="▶️" Subtitle="SOAP request-file executions over range" Filter="@_range" OnFilterChanged="ApplyRange"
             Collapsible="true" Collapsed="@Collapsed" OnToggle="OnToggle">
    <Summary>
        <div class="summary-chip">
            <span class="summary-chip-icon">▶️</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Executions</span>
                <span class="summary-chip-value">@InRangeExecutions.Count</span>
                <span class="summary-chip-sub">in selected range</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">✅</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Success</span>
                <span class="summary-chip-value summary-chip-value--success">@SuccessCount</span>
                <span class="summary-chip-sub">runs</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">⛔</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Failed</span>
                <span class="summary-chip-value summary-chip-value--danger">@FailCount</span>
                <span class="summary-chip-sub">runs</span>
            </div>
        </div>
        <div class="summary-chip">
            <span class="summary-chip-icon">⏱️</span>
            <div class="summary-chip-main">
                <span class="summary-chip-label">Avg duration</span>
                <span class="summary-chip-value">@AvgDurationText</span>
                <span class="summary-chip-sub">per run</span>
            </div>
        </div>
        <div class="summary-chip summary-chip-donut">
            <MiniDonut Value="@SuccessCount" Total="@InRangeExecutions.Count" Label="success" ValueColor="var(--sh-success)" Size="56" />
            <div class="summary-chip-main">
                <span class="summary-chip-label">Pass rate</span>
                <span class="summary-chip-value">@SuccessCount / @InRangeExecutions.Count</span>
            </div>
        </div>
    </Summary>
    <ChildContent>
    <div class="kpi-grid">
        <KpiTile Label="Executions" Value="@InRangeExecutions.Count.ToString()" Sub="in selected range" Icon="▶️" />
        <KpiTile Label="Success" Value="@SuccessCount.ToString()" Sub="runs" Color="var(--sh-success)" Icon="✅" />
        <KpiTile Label="Failed" Value="@FailCount.ToString()" Sub="runs" Color="var(--sh-danger)" Icon="⛔" />
        <KpiTile Label="Avg Duration" Value="@AvgDurationText" Sub="per run" Icon="⏱️" />
        <div class="kpi-tile kpi-donut-tile">
            <div class="kpi-header"><span class="kpi-title">Pass Rate</span></div>
            <div class="kpi-donut">
                <MiniDonut Value="@SuccessCount" Total="@InRangeExecutions.Count" Label="success" ValueColor="var(--sh-success)" />
            </div>
        </div>
    </div>
    <div class="section-divider"></div>
    <div class="sub-heading">
        <i class="bi bi-graph-up me-1"></i>
        Success / failure over range
        <span class="meta-pill ms-2">@_range.Label</span>
    </div>
    <TimelineStrip Segments="@TimelineSegments" />
    </ChildContent>
</SectionCard>
