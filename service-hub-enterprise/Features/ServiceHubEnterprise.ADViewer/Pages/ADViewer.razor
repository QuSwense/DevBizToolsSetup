@page "/adviewer"

<div class="datagrid-card empty-state-card">
    <i class="bi bi-people empty-state-icon"></i>
    <h3 class="empty-state-title">Active Directory Viewer</h3>
    <p class="empty-state-desc">
        Browse and search Active Directory users, groups, and organizational units. View member details, group
        membership, and directory structure.
    </p>
    <div class="empty-state-actions">
        <button class="btn btn-dark btn-sh-primary">
            <i class="bi bi-search"></i>
            Search Directory
        </button>
        <button class="btn btn-outline-secondary btn-dg">
            <i class="bi bi-people"></i>
            Browse Users
        </button>
    </div>
</div>
