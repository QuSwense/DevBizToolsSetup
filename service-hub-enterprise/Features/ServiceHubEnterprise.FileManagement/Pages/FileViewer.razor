@page "/file/viewer"

<div class="datagrid-card empty-state-card">
    <i class="bi bi-file-earmark-text empty-state-icon"></i>
    <h3 class="empty-state-title">No file selected</h3>
    <p class="empty-state-desc">
        Select a file from the File Library or File Browser to preview its contents here. Supports JSON, XML, and plain
        text files.
    </p>
    <div class="empty-state-actions">
        <a href="/File/Library" class="btn btn-outline-secondary btn-dg text-decoration-none">Browse File
            Library</a>
            <a href="/File/Browser" class="btn btn-outline-secondary btn-dg text-decoration-none">Open File
                Browser</a>
            </div>
        </div>
