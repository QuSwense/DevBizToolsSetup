@page "/file/browser"

@{
    var items = new[]
    {
        new { Name = "requests/", Type = "Directory", Modified = "2024-06-15 14:30", Size = "--" },
        new { Name = "responses/", Type = "Directory", Modified = "2024-06-15 13:12", Size = "--" },
        new { Name = "templates/", Type = "Directory", Modified = "2024-06-14 09:00", Size = "--" },
        new { Name = "payment_create_001.json", Type = "JSON File", Modified = "2024-04-01 10:22", Size = "2.4 KB" },
        new { Name = "user_list_filter.xml", Type = "XML File", Modified = "2024-04-02 15:45", Size = "1.8 KB" },
        new { Name = "invoice_create.xml", Type = "XML File", Modified = "2024-03-20 08:30", Size = "3.1 KB" }
    };
}

<div class="datagrid-card">
    <div class="grid-toolbar">
        <div class="toolbar-left">
            <div class="breadcrumb-dg">
                <span class="breadcrumb-root">Root /</span>
                <span class="breadcrumb-current">service-hub-files</span>
            </div>
        </div>
        <div class="toolbar-right">
            <button class="btn btn-dark btn-sh-primary">
                <i class="bi bi-plus-lg"></i>
                New Folder
            </button>
            <button class="btn btn-outline-secondary btn-dg">
                <i class="bi bi-upload"></i>
                Upload
            </button>
        </div>
    </div>
    <div class="table-wrap">
        <table class="datagrid">
            <thead>
                <tr>
                    <th class="check-cell"><input type="checkbox" class="form-check-input" aria-label="Select all" />
                    </th>
                    <th class="sortable">
                        <span class="th-inner">Name<span class="sort-indicator">
                            <i class="bi bi-chevron-expand"></i>
                        </span></span>
                    </th>
                    <th>Type</th>
                    <th>Modified</th>
                    <th>Size</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var isDir = item.Type == "Directory";
                    var iconColor = isDir ? "var(--sh-accent)" : item.Name.EndsWith(".json") ? "var(--sh-success)" :
        "var(--sh-warning)";
                    <tr style="cursor:pointer">
                        <td class="check-cell"><input type="checkbox" class="form-check-input"
                                                          aria-label="Select @item.Name" /></td>
                            <td>
                                <div class="name-stack">
                                    @if (isDir)
                                    {
                                        <i class="bi bi-folder" style="color:var(--sh-accent);font-size:16px"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark file-icon" style="color:@iconColor"></i>
                                    }
                                    <span style="font-weight:@(isDir ? "500" : "400")">@item.Name</span>
                                </div>
                            </td>
                            <td style="color:var(--sh-text-soft)">@item.Type</td>
                            <td style="color:var(--sh-text-soft)">@item.Modified</td>
                            <td style="color:var(--sh-text-soft)">@item.Size</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
