@page "/file/comparer"

<div class="datagrid-card empty-state-card">
    <i class="bi bi-file-diff empty-state-icon"></i>
    <h3 class="empty-state-title">Editor Comparer</h3>
    <p class="empty-state-desc">
        Compare two files side by side. Upload or select files from the library to see differences highlighted with a
        diff view.
    </p>
    <div class="empty-state-actions">
        <button class="btn btn-dark btn-dg-primary">
            <i class="bi bi-plus-lg"></i>
            Select Files to Compare
        </button>
    </div>
</div>
