@page "/settings"

<div class="datagrid-card empty-state-card">
    <i class="bi bi-gear empty-state-icon"></i>
    <h3 class="empty-state-title">Settings</h3>
    <p class="empty-state-desc">
        Configure global application settings including theme preferences, notification preferences, API timeout values,
        and user profile management.
    </p>
    <div class="w-100" style="max-width:480px;margin-top:12px">
        <div style="display:flex;flex-direction:column;gap:12px">
            <div class="form-group">
                <label>Theme Preference</label>
                <select class="form-control-dg">
                    <option>Light</option>
                    <option>Dark</option>
                    <option>System</option>
                </select>
            </div>
            <div class="form-group">
                <label>API Request Timeout (seconds)</label>
                <input type="number" class="form-control-dg" value="30" />
            </div>
            <div class="form-group">
                <label>Default Page Size</label>
                <input type="number" class="form-control-dg" value="25" />
            </div>
            <div class="empty-state-actions justify-content-end">
                <button class="btn btn-outline-secondary btn-dg">Reset</button>
                <button class="btn btn-dark btn-sh-primary">Save Settings</button>
            </div>
        </div>
    </div>
</div>
