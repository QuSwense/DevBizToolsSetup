@page "/test/executions"

@{
    var executions = new[]
    {
        new { Id = "EX-001", Suite = "Smoke Suite", Status = "success", Cases = 6, Files = 18, Duration = "3.2s", Date =
"2024-06-15 14:30:22", TriggeredBy = "Rahul Patel" },
        new { Id = "EX-002", Suite = "Regression Core", Status = "running", Cases = 7, Files = 42, Duration = "12.5s", Date =
"2024-06-15 13:12:05", TriggeredBy = "System" },
        new { Id = "EX-003", Suite = "Payment Full", Status = "success", Cases = 4, Files = 15, Duration = "2.8s", Date =
"2024-06-14 11:45:33", TriggeredBy = "Priya Sharma" },
        new { Id = "EX-004", Suite = "SOAP Billing", Status = "failed", Cases = 1, Files = 9, Duration = "8.4s", Date =
"2024-06-14 09:20:18", TriggeredBy = "Suresh Kumar" }
    };
}

<div class="datagrid-card">
    <div class="grid-toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <span class="search-icon">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" placeholder="Search executions..." aria-label="Search executions" />
            </div>
            <div class="meta-group">
                <span class="meta-pill">4 records</span>
                <span class="meta-sep"></span>
                <select class="form-control-dg status-select">
                    <option>All Status</option>
                    <option>Success</option>
                    <option>Failed</option>
                    <option>Running</option>
                </select>
            </div>
        </div>
        <div class="toolbar-right">
            <button class="btn btn-outline-secondary btn-dg">
                <i class="bi bi-download"></i>
                Export
            </button>
        </div>
    </div>
    <div class="table-wrap">
        <table class="datagrid">
            <thead>
                <tr>
                    <th class="sortable">
                        <span class="th-inner">Execution ID<span class="sort-indicator">
                            <i class="bi bi-chevron-expand"></i>
                        </span></span>
                    </th>
                    <th>Suite</th>
                    <th>Status</th>
                    <th>Cases</th>
                    <th>Files</th>
                    <th>Duration</th>
                    <th>Date</th>
                    <th>Triggered By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exec in executions)
                {
                    var statusClass = exec.Status == "success" ? "status-enabled" : exec.Status == "failed" ? "status-down" : "status-disabled";
                    var statusLabel = exec.Status == "success" ? "Success" : exec.Status == "failed" ? "Failed" : "Running";
                    <tr>
                        <td><span class="cell-id">@exec.Id</span></td>
                        <td>@exec.Suite</td>
                        <td><span class="status-badge @statusClass">@statusLabel</span></td>
                        <td class="text-sh-soft">@exec.Cases</td>
                        <td class="text-sh-soft">@exec.Files</td>
                        <td class="text-sh-soft">@exec.Duration</td>
                        <td class="text-sh-soft">@exec.Date</td>
                        <td class="text-sh-soft">@exec.TriggeredBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
