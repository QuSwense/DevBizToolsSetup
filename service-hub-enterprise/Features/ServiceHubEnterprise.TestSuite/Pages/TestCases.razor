@page "/test/cases"

<div class="datagrid-card empty-state-card">
    <i class="bi bi-ui-checks empty-state-icon"></i>
    <h3 class="empty-state-title">Test Cases</h3>
    <p class="empty-state-desc">
        Create, manage, and organize individual test cases for your REST and SOAP API endpoints. Define request
        parameters, expected responses, and assertions.
    </p>
    <div class="empty-state-actions">
        <button class="btn btn-dark btn-sh-primary">
            <i class="bi bi-plus-lg"></i>
            Create Test Case
        </button>
    </div>
</div>
