@page "/rest/request-files"

@* ── Loading Skeleton ── *@
@if (_isLoading)
{
    <div class="datagrid-card" style="padding:0">
        <div class="skeleton-table">
            <div class="skeleton-header">
                <div class="skeleton-cell skeleton-check"></div>
                <div class="skeleton-cell skeleton-filename"></div>
                <div class="skeleton-cell skeleton-app"></div>
                <div class="skeleton-cell skeleton-apipath"></div>
                <div class="skeleton-cell skeleton-verb"></div>
                <div class="skeleton-cell skeleton-description"></div>
                <div class="skeleton-cell skeleton-type"></div>
                <div class="skeleton-cell skeleton-created"></div>
            </div>
            @RenderSkeletonRows
        </div>
    </div>
}
else if (_hasError)
{
    <div class="datagrid-card error-state-card">
        <i class="bi bi-exclamation-triangle fs-28 text-sh-error"></i>
        <p class="error-state-text">@_errorMessage</p>
        <button class="btn btn-sh-primary btn-dg btn-dark" @onclick="LoadFilesAsync" type="button">
            <i class="bi bi-arrow-repeat"></i>
            Retry
        </button>
        <button class="btn btn-outline-secondary btn-dg ms-2" @onclick="DismissError" type="button">Dismiss</button>
    </div>
}
else
{
    <div class="datagrid-card">
    <div class="grid-toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <span class="search-icon">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" placeholder="Search request files..." aria-label="Search request files" />
            </div>
            <div class="meta-group">
                <span class="meta-pill">@_allFiles.Length records</span>
            </div>
        </div>
        <div class="toolbar-right">
            <button class="btn btn-dark btn-sh-primary">
                <i class="bi bi-plus-lg"></i>
                Upload File
            </button>
            <button class="btn btn-outline-secondary btn-dg">
                <i class="bi bi-download"></i>
                Export
            </button>
        </div>
    </div>
    <div class="table-wrap">
        <table class="datagrid">
            <thead>
                <tr>
                    <th class="check-cell"><input type="checkbox" class="form-check-input" aria-label="Select all" />
                    </th>
                    <th class="sortable">
                        <span class="th-inner">File Name<span class="sort-indicator">
                            <i class="bi bi-chevron-expand"></i>
                        </span></span>
                    </th>
                    <th>Application</th>
                    <th>API Path</th>
                    <th>Verb</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var file in _allFiles)
                {
                    var verbColor = file.Verb == "POST" ? "var(--sh-success)" : file.Verb == "GET" ? "var(--sh-accent)" :
                file.Verb == "DELETE" ? "var(--sh-error)" : "var(--sh-warning)";
                    var verbBg = file.Verb == "POST" ? "var(--sh-success-bg)" : file.Verb == "GET" ? "var(--sh-accent-soft)" : file.Verb == "DELETE" ?
             "var(--sh-error-bg)" : "var(--sh-warning-bg)";
                    var typeIcon = file.Type == "json"
                        ? "<i class=\"bi bi-file-earmark-code\" style=\"color:var(--sh-success);font-size:14px\"></i>"
                        : "<i class=\"bi bi-file-earmark-code\" style=\"color:var(--sh-warning);font-size:14px\"></i>";
                    <tr>
                        <td class="check-cell"><input type="checkbox" class="form-check-input"
                                                          aria-label="Select @file.FileName" /></td>
                            <td>
                                <span class="mono-text">@file.FileName</span>
                            </td>
                            <td class="text-sh-soft">@file.AppName</td>
                            <td><span class="cell-id">@file.ApiPath</span></td>
                            <td>
                                <span class="verb-badge"
                                      style="background:@verbBg;color:@verbColor;border-color:currentColor">@file.Verb</span>
                            </td>
                            <td class="cell-truncated">
                                @file.Description</td>
                                <td>@((MarkupString)typeIcon)</td>
                                <td class="text-sh-soft">@file.Created</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
}
