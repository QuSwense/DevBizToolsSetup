@page "/rest/swagger-sync"

<div class="datagrid-card empty-state-card" style="padding:60px 20px;gap:12px">
    <i class="bi bi-box-arrow-up-right empty-state-icon fs-48"></i>
    <h3 class="empty-state-title">Swagger Sync</h3>
    <p class="empty-state-desc">
        Import OpenAPI/Swagger specifications to automatically create and update REST application definitions.
    </p>
    <div class="empty-state-actions">
        <button class="btn btn-dark btn-sh-primary">
            <i class="bi bi-download"></i>
            Import Swagger URL
        </button>
        <button class="btn btn-outline-secondary btn-dg">
            <i class="bi bi-upload"></i>
            Upload File
        </button>
    </div>
</div>
