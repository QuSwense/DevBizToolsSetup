@page "/"

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading dashboard...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Failed to load dashboard:</strong> @_errorMessage
    </div>
}
else if (_viewModel.IsLoaded)
{
    <div class="dashboard-stack">
        <!-- Users -->
        <UsersOverview Users="@_viewModel.Users"
                       Activities="@_viewModel.UserActivities" />

        <!-- REST Applications -->
        <RestAppsOverview Apps="@_viewModel.RestApps"
                          RequestFiles="@_viewModel.RestRequestFiles"
                          Executions="@_viewModel.RequestExecutions" />

        <!-- SOAP Applications -->
        <SoapAppsOverview Apps="@_viewModel.SoapApps"
                          RequestFiles="@_viewModel.RequestFiles"
                          WsdlRecords="@_viewModel.WsdlRecords"
                          Executions="@_viewModel.RequestExecutions" />

        <!-- Test Suites -->
        <TestSuitesOverview Suites="@_viewModel.TestSuites"
                            History="@_viewModel.TestSuiteHistory" />

        <!-- Service Health -->
        <ServiceHealthOverview Services="@_viewModel.HealthServices"
                               Uptime="@_viewModel.ServiceUptime" />

        <!-- Recent Activity -->
        <RecentActivity Title="Recent Activity"
                        ShowViewAll="true"
                        ViewAllHref="#"
                        Activities="@BuildActivityLog()"
                        Users="@BuildUserNames()" />

        <!-- Quick Actions -->
        <div class="dashboard-grid">
            <QuickActions Actions="@QuickActionItems" />
        </div>
    </div>
}


