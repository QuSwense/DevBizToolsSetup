@namespace ServiceHubEnterprise.Dashboard.UI.Components

<div class="dash-card">
    <div class="card-header">
        <span class="card-title">@Title</span>
        @if (!string.IsNullOrEmpty(PassingSummary))
        {
            <small class="text-sh-faint">@PassingSummary</small>
        }
    </div>
    <div class="suite-progress">
        @foreach (var suite in Suites)
        {
            var pct = suite.Files > 0 ? (suite.Cases * 100 / suite.Files) : 0;
            var barColor = pct >= 50 ? "var(--sh-success)" : "var(--sh-warning)";
            <div class="d-flex align-items-center gap-2">
                <span class="suite-name">@suite.Name</span>
                <div class="suite-bar">
                    <div style="width:@(pct)%;height:100%;background:@barColor;transition:width .3s">
                    </div>
                </div>
                <span class="suite-stats">@suite.Cases / @suite.Files</span>
            </div>
        }
    </div>
</div>


