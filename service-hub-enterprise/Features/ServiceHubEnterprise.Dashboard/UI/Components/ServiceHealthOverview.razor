@namespace ServiceHubEnterprise.Dashboard.UI.Components

<SectionCard Title="Service Health" Icon="🩺" Subtitle="Current status & uptime over range" Filter="@_range" OnFilterChanged="ApplyRange">
    <div class="kpi-grid">
        <KpiTile Label="Services" Value="@TotalNow.ToString()" Icon="🖥️" />
        <KpiTile Label="Operational" Value="@OperationalNow.ToString()" Sub="right now" Color="var(--sh-success)" Icon="✅" />
        <KpiTile Label="Degraded" Value="@DegradedNow.ToString()" Sub="right now" Color="var(--sh-warning)" Icon="⚠️" />
        <KpiTile Label="Down" Value="@DownNow.ToString()" Sub="right now" Color="var(--sh-danger)" Icon="⛔" />
    </div>
    <div class="section-divider"></div>
    <div class="health-list">
        @foreach (var row in Rows)
        {
            <div class="health-row">
                <div class="health-row-main">
                    <span class="health-name">@row.Name</span>
                    <span class="sb-badge @StatusBadgeClass(row.CurrentStatus)">@row.CurrentStatus</span>
                </div>
                <div class="health-row-stats">
                    <span class="health-up">@row.UpPct%</span>
                    <span class="health-up-text">@row.UptimeText</span>
                </div>
                <div class="health-row-timeline">
                    <TimelineStrip Segments="row.Segments" />
                </div>
            </div>
        }
        @if (Rows.Count == 0)
        {
            <div class="activity-empty">No services configured.</div>
        }
    </div>
</SectionCard>
