@namespace ServiceHubEnterprise.Dashboard.UI.Components

<div class="dash-card">
    <div class="card-header">
        <span class="card-title">@Title</span>
        <small class="text-sh-faint">@DisplayedCount files</small>
    </div>
    <div class="card-filters">
        <div class="segmented-control">
            <button class="seg-btn @(_statusFilter == "all" ? "active" : "")" @onclick="ShowAll">All</button>
            <button class="seg-btn @(_statusFilter == "enabled" ? "active" : "")" @onclick="ShowEnabled">Enabled</button>
            <button class="seg-btn @(_statusFilter == "disabled" ? "active" : "")" @onclick="ShowDisabled">Disabled</button>
        </div>
        <label class="pill-check">
            <input type="checkbox" @bind="_onlyMine" />
            <span>Only mine</span>
        </label>
    </div>
    <div class="files-breakdown mt-2">
        @foreach (var item in Grouped)
        {
            var pct = DisplayedCount > 0 ? item.Count * 100.0 / DisplayedCount : 0;
            <div class="files-breakdown-item">
                <div class="d-flex align-items-center gap-6px">
                    <span class="flex-shrink-0 d-inline-block"
                          style="width:10px;height:10px;border-radius:50%;background:@item.Color"></span>
                    <span class="fw-medium fs-12 text-sh-soft">@item.AppName</span>
                </div>
                <div class="files-breakdown-bar">
                    <div class="files-breakdown-fill"
                         style="width:@(pct)%;background:@item.Color"></div>
                </div>
                <div class="d-flex align-items-center gap-4px flex-shrink-0">
                    <span class="fs-14 fw-bold" style="color:@item.Color">@item.Count</span>
                    <span class="fs-11 text-sh-faint">@pct.ToString("0")%</span>
                </div>
            </div>
        }
    </div>
    @if (Grouped.Count == 0)
    {
        <div class="activity-empty">No files match the current filters.</div>
    }
</div>
