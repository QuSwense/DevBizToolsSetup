@namespace ServiceHubEnterprise.Dashboard.UI.Components

<SectionCard Title="SOAP Applications" Icon="🔁" Subtitle="Apps, WSDL sync, request files & executions" Filter="@_range" OnFilterChanged="ApplyRange">
    <div class="kpi-grid">
        <KpiTile Label="Total Apps" Value="@TotalApps.ToString()" Sub="@($"{EnabledApps} enabled")" Icon="📦" />
        <KpiTile Label="Enabled" Value="@EnabledApps.ToString()" Sub="applications" Color="var(--sh-success)" Icon="🟢" />
        <KpiTile Label="Disabled" Value="@DisabledApps.ToString()" Sub="applications" Color="var(--sh-warning)" Icon="⛔" />
        <KpiTile Label="WSDL Synced" Value="@WsdlSynced.ToString()" Sub="@($"{WsdlTotal} records")" Icon="🧾" />
        <KpiTile Label="Request Files" Value="@FilesActive.ToString()" Sub="@($"{FilesTotal} total")" Icon="📄" />
        <KpiTile Label="Executions" Value="@ExecCount.ToString()" Sub="in selected range" Icon="▶️" />
        <KpiTile Label="Success" Value="@SuccessCount.ToString()" Sub="@($"{FailCount} failed")" Color="var(--sh-success)" Icon="✅" />
    </div>
    <div class="section-divider"></div>
    <div class="app-table">
        <div class="app-table-head">
            <span>Application</span><span>Status</span><span>WSDL</span><span>Request files</span><span>Executions</span><span>Success</span>
        </div>
        @foreach (var row in Rows)
        {
            <div class="app-table-row">
                <span class="app-table-name">@row.Name</span>
                <span class="sb-badge @(row.Enabled ? "sb-enabled" : "sb-disabled")">@(row.Enabled ? "Enabled" : "Disabled")</span>
                <span class="sb-badge @WsdlBadgeClass(row.WsdlStatus)">@row.WsdlStatus</span>
                <span class="app-table-muted">@row.FilesActive / @row.FilesTotal</span>
                <span class="app-table-muted">@row.Executions</span>
                <div class="app-table-success">
                    <div class="suite-bar">
                        <div style="width:@(row.SuccessPct)%;height:100%;background:var(--sh-success);border-radius:4px"></div>
                    </div>
                    <span class="suite-stats">@row.SuccessPct%</span>
                </div>
            </div>
        }
    </div>
</SectionCard>
