@page "/"

@{
    // Dashboard data - matching the original Service Hub React dashboard
    var statsCards = new[]
    {
        new { Label = "REST Apps", Value = "4", Sub = "3 enabled, 1 disabled", Color = "var(--sh-accent)" },
        new { Label = "SOAP Apps", Value = "2", Sub = "1 enabled, 1 disabled", Color = "var(--sh-text)" },
        new { Label = "Test Suites", Value = "4", Sub = "25 / 84 cases passing", Color = "var(--sh-success)" }
    };

    var healthServices = new[]
    {
        new { Name = "Payment Gateway", Status = "ok" },
        new { Name = "User API", Status = "ok" },
        new { Name = "Billing SOAP", Status = "down" },
        new { Name = "Inventory", Status = "ok" },
        new { Name = "Shipping SOAP", Status = "down" }
    };

    var testSuites = new[]
    {
        new { Name = "Smoke Suite", Cases = 6, Files = 18 },
        new { Name = "Regression Core", Cases = 12, Files = 42 },
        new { Name = "Payment Full", Cases = 4, Files = 15 },
        new { Name = "SOAP Billing", Cases = 3, Files = 9 }
    };

    var activityLog = new[]
    {
        new { User = "Priya Sharma", Action = "created application PaymentService", Time = "2 hours ago" },
        new { User = "Rahul Patel", Action = "executed Test Suite Smoke Suite and 12 files passed", Time = "2 hours ago" },
        new { User = "Anita Desai", Action = "disabled application InventoryAPI", Time = "5 hours ago" },
        new { User = "Vikram Singh", Action = "added 3 new APIs to OrderService", Time = "yesterday" },
        new { User = "Suresh Kumar", Action = "imported WSDL for LegacyBilling and 3 operations synced", Time = "yesterday" },
        new { User = "Priya Sharma", Action = "created template Payment Success Template", Time = "1 day ago" },
        new { User = "System", Action = "detected Billing SOAP service down", Time = "2 hours ago" }
    };
}

<div class="dashboard-grid">
    <!-- Stats Cards Row -->
    @foreach (var card in statsCards)
    {
        <div class="dash-card">
            <div class="card-header">
                <span class="card-title">@card.Label</span>
            </div>
            <div class="card-value" style="color:@card.Color">@card.Value</div>
            <div class="card-sub">@card.Sub</div>
        </div>
    }

    <!-- Files Card (merged summary) -->
    @{
        var fileTypes = new[]
        {
            new { Type = "JSON", Count = 2, Color = "#3b82f6" },
            new { Type = "XML", Count = 2, Color = "#8b5cf6" },
            new { Type = "REST", Count = 3, Color = "#10b981" },
            new { Type = "SOAP", Count = 1, Color = "#f59e0b" }
        };
        var totalFiles = fileTypes.Sum(f => f.Count);
    }
    <div class="dash-card">
        <div class="card-header">
            <span class="card-title">📁 Files</span>
        </div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
            <span class="card-value" style="color:var(--sh-accent);font-size:2rem">@totalFiles</span>
            <span class="card-sub" style="font-size:0.85rem">request files</span>
        </div>
        <div class="files-breakdown mt-2">
            @foreach (var ft in fileTypes)
            {
                var pct = (double)ft.Count / totalFiles * 100;
                <div class="files-breakdown-item">
                    <div class="d-flex align-items-center gap-6px">
                        <span class="flex-shrink-0 d-inline-block" style="width:10px;height:10px;border-radius:50%;background:@ft.Color"></span>
                        <span class="fw-medium fs-12 text-sh-soft">@ft.Type</span>
                    </div>
                    <div class="files-breakdown-bar">
                        <div class="files-breakdown-fill" style="width:@(pct)%;background:@ft.Color"></div>
                    </div>
                    <div class="d-flex align-items-center gap-4px flex-shrink-0">
                        <span class="fs-14 fw-bold" style="color:@ft.Color">@ft.Count</span>
                        <span class="fs-11 text-sh-faint">@pct.ToString("0")%</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Test Suites Card -->
    <div class="dash-card">
        <div class="card-header">
            <span class="card-title">Test Suites</span>
            <small class="text-sh-faint">25 / 84 passing</small>
        </div>
        <div class="suite-progress">
            @foreach (var suite in testSuites)
            {
                var pct = suite.Files > 0 ? (suite.Cases * 100 / suite.Files) : 0;
                var barColor = pct >= 50 ? "var(--sh-success)" : "var(--sh-warning)";
                <div class="d-flex align-items-center gap-2">
                    <span class="suite-name">@suite.Name</span>
                    <div class="suite-bar">
                        <div
                            style="width:@(pct)%;height:100%;background:@barColor;transition:width .3s">
                        </div>
                    </div>
                    <span class="suite-stats">@suite.Cases /
                        @suite.Files</span>
                    </div>
                }
            </div>
        </div>

        <!-- Executions Card -->
        @{
            var totalExecs = 516;
            var passRate = 87;
            var failCount = 77;
        }
        <div class="dash-card position-relative">
            <div class="card-header">
                <span class="card-title">Executions</span>
                <div class="position-relative">
                    <button class="meta-pill" style="cursor:pointer;border:none;background:none;font-size:16px;padding:2px 6px;line-height:1"
                            @onclick="() => _showDatePicker = !_showDatePicker">
                        📅
                    </button>
                    @if (_showDatePicker)
                    {
                        <div class="datepicker-overlay" @onclick="() => _showDatePicker = false"></div>
                        <div class="datepicker-popup" @onclick:stopPropagation="true">
                            <label>Show stats until</label>
                            <input type="date"
                                   class="datepicker-input"
                                   @bind="_selectedDate" />
                            <div class="datepicker-info">
                                @if (_selectedDate.HasValue)
                                {
                                    <span>Showing data until @_selectedDate.Value.ToString("MMM dd, yyyy")</span>
                                }
                                else
                                {
                                    <span>Showing all data</span>
                                }
                            </div>
                            @if (_selectedDate.HasValue)
                            {
                                <button class="quick-action-link datepicker-clear"
                                        @onclick="() => { _selectedDate = null; _showDatePicker = false; }">
                                    Clear filter
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="d-flex flex-column mt-2" style="gap:10px">
                <div class="d-flex align-items-center justify-content-between gap-12px flex-wrap">
                    <div class="d-flex align-items-baseline gap-6px">
                        <span class="fs-28 fw-bold text-sh-accent lh-1">@totalExecs</span>
                        <span class="fs-12 text-sh-soft">total</span>
                    </div>
                    <div class="d-flex align-items-center exec-metrics">
                        <div class="d-flex align-items-center gap-6px">
                            <div class="suite-bar exec-pass-bar">
                                <div style="width:@(passRate)%;height:100%;background:var(--sh-success);border-radius:4px"></div>
                            </div>
                            <span class="fs-15 fw-bold text-sh-success">@(passRate)%</span>
                            <span class="fs-11 text-sh-soft">pass</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="fs-14 fw-semibold text-sh-warning">@failCount</span>
                            <span class="fs-11 text-sh-soft">fail</span>
                        </div>
                        <span class="exec-trend">↑</span>
                    </div>
                </div>
                @if (_selectedDate.HasValue)
                {
                    <div class="fs-11 text-sh-faint border-sh-top pt-2">
                        Data from @_selectedDate.Value.ToString("MMM dd, yyyy") to present
                    </div>
                }
            </div>
        </div>

        <!-- Health Card -->
        @{
            var operationalCount = healthServices.Count(s => s.Status == "ok");
            var downCount = healthServices.Count(s => s.Status == "down");
            var totalCount = healthServices.Length;
            var operationalPct = operationalCount * 100 / totalCount;
            var downPct = downCount * 100 / totalCount;
        }
        <div class="dash-card">
            <div class="card-header">
                <span class="card-title">Service Health</span>
                <small class="text-sh-faint">@operationalCount operational</small>
            </div>
            <div class="donut-body">
                <div class="donut-chart-wrapper">
                    <svg viewBox="0 0 42 42" width="100" height="100">
                        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="var(--sh-border)" stroke-width="3" />
                        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="var(--sh-success)" stroke-width="3"
                                stroke-dasharray="@($"{operationalPct} {downPct}")"
                                stroke-dashoffset="25"
                                transform="rotate(-90 21 21)" />
                        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="var(--sh-warning)" stroke-width="3"
                                stroke-dasharray="@($"{downPct} {operationalPct}")"
                                stroke-dashoffset="@(25 + operationalPct)"
                                transform="rotate(-90 21 21)" />
                    </svg>
                    <div class="donut-center">
                        <span class="donut-value">@operationalPct%</span>
                        <span class="donut-sub">up</span>
                    </div>
                </div>
                <div class="donut-legend">
                    <div class="donut-legend-item">
                        <span class="legend-dot" style="background:var(--sh-success)"></span>
                        <span class="legend-label">Operational</span>
                        <span class="legend-count">@operationalCount</span>
                    </div>
                    <div class="donut-legend-item">
                        <span class="legend-dot" style="background:var(--sh-warning)"></span>
                        <span class="legend-label">Down</span>
                        <span class="legend-count">@downCount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Card - Full width row -->
    <div class="dash-card activity-row">
        <div class="card-header">
            <span class="card-title">Recent Activity</span>
            <a href="#" class="quick-action-link fs-11">View All</a>
        </div>
        <div class="activity-body">
            @foreach (var entry in activityLog)
            {
                <div class="activity-item">
                    <div class="activity-avatar">@entry.User.Substring(0,
                        Math.Min(2, entry.User.Length)).ToUpper()</div>
                    <div class="flex-fill" style="min-width:0">
                        <span class="activity-user">@entry.User</span>
                        <span class="activity-action">@entry.Action</span>
                    </div>
                    <span class="activity-time">@entry.Time</span>
                </div>
            }
        </div>
    </div>

    <div class="dashboard-grid">
        <!-- Quick Actions Card -->
        <div class="dash-card">
            <div class="card-header">
                <span class="card-title">Quick Actions</span>
            </div>
            <div class="quick-actions">
                <a href="/File/Library" class="quick-action-link">
                    <i class="bi bi-file-earmark"></i>
                    File Library
                </a>
                <a href="/Rest/ExecuteHistory" class="quick-action-link">
                    <i class="bi bi-clock-history"></i>
                    Execute History
                </a>
            </div>
        </div>
    </div>

@code {
    private DateTime? _selectedDate;
    private bool _showDatePicker;
}
