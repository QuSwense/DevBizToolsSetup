@page
@model SoapApiTest.Pages.IndexModel
@{
    ViewData["Title"] = "SOAP API Test";
}

<h2 class="mb-4"><i class="bi bi-diagram-3"></i> SOAP API Test</h2>

<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-terminal"></i> Request Builder</span>
        <div class="btn-group">
            <button class="btn btn-light btn-sm"><i class="bi bi-play-fill"></i> Run</button>
            <button class="btn btn-light btn-sm"><i class="bi bi-save"></i> Save</button>
            <button class="btn btn-light btn-sm"><i class="bi bi-trash"></i> Clear</button>
        </div>
    </div>
    <div class="card-body">
        <form>
            <div class="mb-3">
                <label for="endpoint" class="form-label">Endpoint URL</label>
                <input type="text" class="form-control" id="endpoint" placeholder="https://example.com/soap" />
            </div>
            <div class="mb-3">
                <label for="requestBody" class="form-label">SOAP Request</label>
                <textarea class="form-control" id="requestBody" rows="6"
                          placeholder="Enter SOAP XML here..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Send Request</button>
        </form>
    </div>
</div>

<div class="card shadow mt-4">
    <div class="card-header bg-success text-white">
        <i class="bi bi-box-arrow-down"></i> Response
    </div>
    <div class="card-body">
        <pre class="bg-light p-3 rounded" style="max-height:300px; overflow:auto;">
            <!-- Response output will appear here -->
        </pre>
    </div>
</div>
