@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4 fw-bold mb-4">Welcome to DevBizToolsSuite</h1>
    <p class="lead">Your all-in-one toolkit for developers, testers, and admins.</p>
</div>

<div class="row mt-5">
    <div class="col-md-4 mb-4">
        <div class="card shadow h-100 text-center">
            <div class="card-body">
                <i class="bi bi-diagram-3 fs-1 text-primary"></i>
                <h5 class="card-title mt-3">SOAP API</h5>
                <p class="card-text">Test SOAP requests and view responses.</p>
                <a asp-area="SoapApiTest" asp-page="/Index" class="btn btn-outline-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card shadow h-100 text-center">
            <div class="card-body">
                <i class="bi bi-braces fs-1 text-success"></i>
                <h5 class="card-title mt-3">REST API</h5>
                <p class="card-text">Send REST calls and inspect JSON/XML.</p>
                <a asp-area="RestApiTest" asp-page="/Index" class="btn btn-outline-success">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card shadow h-100 text-center">
            <div class="card-body">
                <i class="bi bi-file-earmark-pdf fs-1 text-danger"></i>
                <h5 class="card-title mt-3">PDF Viewer</h5>
                <p class="card-text">Upload and view PDF documents inline.</p>
                <a asp-area="PdfViewer" asp-page="/Index" class="btn btn-outline-danger">Open</a>
            </div>
        </div>
    </div>
</div>
