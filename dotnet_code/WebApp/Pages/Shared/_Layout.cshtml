<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevBizToolsSuite</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
            .nav-link:hover {
                transition: 0.3s;
                transform: scale(1.05);
            }

            .card {
                transition: transform 0.3s ease;
            }

            .card:hover {
                transform: translateY(-5px);
            }
    </style>
</head>

<body>
    <header class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                <i class="bi bi-tools"></i> DevBizToolsSuite
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/SoapApiTest/Index">
                            <i class="bi bi-diagram-3"></i> SOAP API
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RestApiTest/Index">
                            <i class="bi bi-braces"></i> REST API
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/PdfViewer/Index">
                            <i class="bi bi-file-earmark-pdf"></i> PDF Viewer
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/HealthCheck/Index">
                            <i class="bi bi-heart-pulse"></i> Health Check
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Admin/Index">
                            <i class="bi bi-gear"></i> Admin
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="bg-light text-center py-3 mt-4 shadow-sm">
        <small>
            &copy; 2026 DevBizToolsSuite | Built with
            <i class="bi bi-bootstrap-fill text-primary"></i>
        </small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>